---
/**
 * Theme toggle island. Injects an inline script early in <head> to
 * apply the stored theme before first paint (no flash). The visible
 * button is a hydration-free interactive: pure DOM listener attached
 * once on load.
 */
---

<button
  type="button"
  class="theme-toggle"
  aria-label="Toggle color theme"
  title="Toggle theme (T)"
>
  <svg class="theme-icon theme-icon--dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
  <svg class="theme-icon theme-icon--light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px; /* WCAG 2.5.5 touch target minimum */
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line);
    background: rgba(184, 157, 255, 0.04);
    color: var(--muted);
    transition: border-color var(--dur) var(--ease-out),
      color var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
  }
  .theme-toggle:hover {
    border-color: var(--purple);
    color: var(--purple-bright);
    background: rgba(184, 157, 255, 0.10);
  }
  .theme-icon {
    width: 16px;
    height: 16px;
  }
  /* Dark theme shows moon (offers switch to light); light shows sun. */
  :root[data-theme='light'] .theme-icon--dark { display: none; }
  :root[data-theme='dark']  .theme-icon--light { display: none; }
  :root:not([data-theme='light']) .theme-icon--light { display: none; }
</style>

<style is:global>
  /* v5.30.0 — theme-swap wipe. The browser's default cross-fade is turned
     off on both snapshots; ThemeToggle.astro's script animates only the
     new theme's clip-path (an expanding circle from the click point), so
     the new theme visibly wipes over the old one instead of fading. */
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
  ::view-transition-old(root) { z-index: 1; }
  ::view-transition-new(root) { z-index: 2; }
</style>

<script>
  // Guard against multiple hydrations if the component appears twice on a page.
  // v5.17.1 fix — this component renders more than once per page (desktop
  // nav + mobile drawer). It used to key off a single id="themeToggle" via
  // getElementById, which only ever finds the FIRST matching element in the
  // DOM (duplicate IDs are invalid HTML) — so the mobile drawer's copy had
  // no click listener at all and silently did nothing when tapped. Now
  // every .theme-toggle button on the page gets bound, and toggling is a
  // shared function instead of a simulated click on one specific button.
  if (!(window as any).__themeToggleBound) {
    (window as any).__themeToggleBound = true;

    let transitionInFlight = false;

    // v5.30.0 — dark/light swap wipes outward from the click point via the
    // View Transitions API instead of snapping instantly. originX/originY
    // come from the actual click (or the keyboard shortcut, which has no
    // click point, so it wipes from center). Skipped entirely — falls back
    // to the old instant swap — when the browser doesn't support
    // startViewTransition, prefers-reduced-motion is set, or a wipe is
    // already mid-flight; this is a short, click-driven transition rather
    // than the site's own >5s "ambient motion" (governed by html[data-still]
    // via MotionToggle), so prefers-reduced-motion is the right gate here.
    function commitTheme(next: string) {
      const root = document.documentElement;
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('nb-theme', next); } catch (e) {
        window.__nbDiag && window.__nbDiag.log('theme', 'Theme preference could not be saved (private browsing), applies for this page view only', { recovered: true });
      }
    }

    function toggleTheme(originX?: number, originY?: number) {
      const root = document.documentElement;
      const current = root.getAttribute('data-theme') || 'dark';
      const next = current === 'dark' ? 'light' : 'dark';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const supportsViewTransition = typeof (document as any).startViewTransition === 'function';

      if (transitionInFlight || reduceMotion || !supportsViewTransition) {
        commitTheme(next);
        return;
      }

      const x = originX ?? window.innerWidth / 2;
      const y = originY ?? window.innerHeight / 2;
      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );

      transitionInFlight = true;
      const transition = (document as any).startViewTransition(() => commitTheme(next));
      transition.ready
        .then(() => {
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`] },
            { duration: 700, easing: 'cubic-bezier(0.16, 0.8, 0.24, 1)', pseudoElement: '::view-transition-new(root)' }
          );
        })
        .catch(() => {});
      transition.finished.finally(() => { transitionInFlight = false; });
    }

    document.querySelectorAll('.theme-toggle').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const rect = (btn as HTMLElement).getBoundingClientRect();
        toggleTheme(rect.left + rect.width / 2, rect.top + rect.height / 2);
      });
    });

    // Keyboard shortcut: "T" toggles theme (skipped while typing). No click
    // point to wipe from, so it expands from the viewport center.
    document.addEventListener('keydown', (e) => {
      const target = e.target as HTMLElement | null;
      const typing = target && (target.tagName === 'INPUT' || target.tagName === 'TEXTAREA' || target.isContentEditable);
      if (typing) return;
      if (e.key === 't' || e.key === 'T') {
        e.preventDefault();
        toggleTheme();
      }
    });
  }
</script>
