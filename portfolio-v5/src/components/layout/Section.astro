---
interface Props {
  eyebrow?: string;
  heading?: string;
  headingEmphasis?: string;   // portion to italic-purple emphasize
  intro?: string;
  wide?: boolean;
  class?: string;
  id?: string;
  headingLevel?: 'h1' | 'h2'; // v5.17.3 fix — every page needs exactly one
                              // real <h1>. Pages with EditorialHero/CaseHero
                              // already have one there; every Section-only
                              // page (about, services, contact, resume,
                              // status, terms, privacy, editorial,
                              // accessibility, 3d, work) had none at all —
                              // a real WCAG failure (axe: page-has-heading-one),
                              // not a style nitpick. Pass headingLevel="h1"
                              // on that page's first Section only.
}
const { eyebrow, heading, headingEmphasis, intro, wide = false, class: cls = '', id, headingLevel = 'h2' } = Astro.props;
const HeadingTag = headingLevel;
---
<section class:list={['section', cls]} id={id}>
  <div class:list={['wrap', wide && 'wrap-wide']}>
    {eyebrow && <p class="section-eyebrow">{eyebrow}</p>}
    {heading && (
      <HeadingTag class="section-heading">
        {headingEmphasis ? (
          <>
            <em>{headingEmphasis}</em> {heading}
          </>
        ) : (
          heading
        )}
      </HeadingTag>
    )}
    {intro && <p class="section-intro">{intro}</p>}
    <slot />
  </div>
</section>

<style>
  .section {
    padding: var(--sp-11) 0;
  }
  /* v5.17.0 — restrained scroll reveal, zero JS, same mechanism already
     used by the scroll-progress hairline and featured showcase
     (animation-timeline). Settles quickly (35% of entry) so it reads as
     polish, not a slideshow effect.
     v5.36.0 fix — real bug, not a style nitpick: this claimed "if a
     section is already in the viewport on load, the timeline resolves at
     full opacity immediately," but that's not reliable in practice for
     the very first section on a page (always in view at load, before any
     scroll has happened to give the browser a scroll position to compute
     the view-timeline from). Reported live: an entire hero section --
     heading, intro paragraph, a 3-column meta grid -- rendering as
     invisible empty space until the visitor scrolled. Excluded the first
     section on each page from the reveal entirely: it has no meaningful
     scroll distance before it appears anyway, so there was nothing worth
     animating there, only a real risk of content going invisible. */
  @supports (animation-timeline: view()) {
    .section:not(:first-of-type) {
      animation: section-reveal linear backwards;
      animation-timeline: view();
      animation-range: entry 0% entry 35%;
    }
  }
  @keyframes section-reveal {
    from { opacity: 0; transform: translateY(18px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .section { animation: none; }
  }
  .wrap-wide {
    max-width: 1400px;
  }
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    /* Use --muted (not --muted-2) so 10.5px passes WCAG AA on --bg. */
    color: var(--muted);
    margin-bottom: var(--sp-4);
  }
  .section-heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 400;
    font-style: normal;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--text);
    margin-bottom: var(--sp-6);
    max-width: 900px;
    text-wrap: balance;
  }
  .section-heading em {
    font-style: italic;
    color: var(--purple-bright);
    font-weight: 400;
  }
  .section-intro {
    max-width: var(--wrap-narrow);
    color: var(--muted);
    font-size: var(--text-md);
    line-height: var(--leading-body);
    margin-bottom: var(--sp-8);
  }
</style>
