---
import type { Project } from '../../data/projects';
import StatusPill from '../ui/StatusPill.astro';
import MetaTag from '../ui/MetaTag.astro';
import Button from '../ui/Button.astro';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---
<header class="case-hero">
  <div class="wrap">
    <a href="/work" class="back-link">← Back to Work</a>
    <div class="case-meta-row">
      <StatusPill status={project.status} />
      {project.metaTags.map((t) => <MetaTag label={t} />)}
    </div>
    <h1 class="case-title">{project.tagline}</h1>
    <p class="case-desc">{project.description}</p>
    <div class="case-actions">
      {project.links.map((link) => (
        <Button href={link.href} variant="ghost" external={link.external}>{link.label} →</Button>
      ))}
    </div>
    {project.media && project.media.kind === 'banner' && (
      <figure class="case-banner" data-scene={project.scene}>
        <img src={project.media.src} alt={project.media.alt} width="1600" height="900" decoding="async" fetchpriority="low" />
        <figcaption>Banner art from the project README. Not a product screenshot.</figcaption>
      </figure>
    )}
  </div>
</header>

<style>
  .case-hero {
    padding: var(--sp-11) 0 var(--sp-9);
  }
  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--muted);
    letter-spacing: 0.04em;
    margin-bottom: var(--sp-7);
    border-bottom: 1px solid transparent;
    transition: color var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
  }
  .back-link:hover { color: var(--purple-bright); border-bottom-color: var(--purple-bright); }
  .case-meta-row {
    display: flex; align-items: center; gap: var(--sp-3);
    margin-bottom: var(--sp-6);
    flex-wrap: wrap;
  }
  .case-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-style: italic;
    font-size: var(--text-h1);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    max-width: 1000px;
    color: var(--text);
    text-wrap: balance;
  }
  .case-desc {
    margin-top: var(--sp-6);
    font-family: var(--font-display);
    font-size: var(--text-md);
    line-height: var(--leading-body);
    color: var(--muted);
    max-width: 720px;
  }
  .case-banner { margin: var(--sp-8) 0 0; }
  .case-banner img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: var(--surface-2);
  }
  .case-banner figcaption {
    margin-top: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .case-actions {
    margin-top: var(--sp-7);
    display: flex; flex-wrap: wrap; gap: var(--sp-3);
  }

  /* v5.36.0 — banner reveal, per scene. Every case study with a banner
     image used the exact same static, unanimated frame; Mission OS and
     Pursue OS specifically got called out for looking identical here even
     after their backdrops (scenes) were made to differ. Real DOM element,
     not a ::view-transition pseudo-element, so this uses the plain native
     scroll-timeline pattern already proven sitewide (WorkIndex's row-in),
     not the more fragile mechanisms tried elsewhere this session. No JS
     fallback: worst case on an unsupporting browser is the same static
     image that shipped before, never a missing image. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      [data-scene='mission'] img {
        animation: mission-banner-in 1s var(--ease-out) both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
      [data-scene='pursue'] img {
        animation: pursue-banner-in 1.1s linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 60%;
      }
    }
  }
  /* Mission OS: settles downward into place, like the boot sequence its
     own scene already shows landing on a desktop. */
  @keyframes mission-banner-in {
    from { opacity: 0; transform: translateY(-28px); }
    to { opacity: 1; transform: translateY(0); }
  }
  /* Pursue OS: a left-to-right scan/reveal instead of a fade, closer to a
     document being read line by line than a picture fading in. */
  @keyframes pursue-banner-in {
    from { clip-path: inset(0 100% 0 0); }
    to { clip-path: inset(0 0 0 0); }
  }
</style>
