---
/**
 * Multi-line narrative hero.
 *
 * Default: each line rises in sequence on load.
 *
 * `scrub`: the headline is read by scrolling. Words start dim and light up one
 * by one as you scroll, the intro comes up behind them, and a row of ghost
 * "team members" collapses into the single solid one, which is the whole
 * point of the sentence. Desktop pins the hero while this plays (CSS view
 * timeline); phones and browsers without scroll timelines get the same beats
 * from the JS progress engine (--p), un-pinned. Reduced motion shows the
 * finished state.
 */
interface Props {
  eyebrow?: string;
  lines: Array<{ text: string; emphasis?: string }>;
  intro?: string;
  scrub?: boolean;
  roles?: string[];  // scrub only: what "on my own" means, lit one by one
}
const { eyebrow, lines, intro, scrub = false, roles = [] } = Astro.props;

// word list for the scrubbed version: [{ t, em, w }] with w in 0..1
const words: Array<{ t: string; em: boolean; line: number; w: number }> = [];
if (scrub) {
  lines.forEach((line, li) => {
    (line.emphasis ? line.emphasis.split(' ').map((t) => ({ t, em: true })) : [])
      .concat(line.text.split(' ').map((t) => ({ t, em: false })))
      .forEach((x) => words.push({ ...x, line: li, w: 0 }));
  });
  words.forEach((x, i) => { x.w = words.length > 1 ? i / (words.length - 1) : 0; });
}
const CREW = 7;
---
{scrub ? (
  <section class="hero hero-scrub" aria-labelledby="hero-title" data-progress="hero">
    <div class="hero-pin wrap">
      {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
      <h1 id="hero-title" class="hero-title">
        {lines.map((_, li) => (
          <span class="act-line">
            {words.filter((x) => x.line === li).map((x) => (
              <><span class:list={['w', x.em && 'em']} style={`--w:${x.w.toFixed(3)}`}>{x.t}</span>{' '}</>
            ))}
          </span>
        ))}
      </h1>
      <div class="crew" aria-hidden="true">
        {Array.from({ length: CREW }, (_, i) => <i style={`--c:${i}`}></i>)}
        <b><span>me</span></b>
      </div>
      {roles.length > 0 && (
        <ol class="roles" aria-label="What I do myself">
          {roles.map((r, i) => (
            <li style={`--r:${i}`}><span class="role-dot" aria-hidden="true"></span><span class="role-text">{r}</span></li>
          ))}
        </ol>
      )}
      {intro && <p class="hero-sub scrub-sub">{intro}</p>}
      <div class="scrub-slot"><slot /></div>
      <p class="scroll-cue" aria-hidden="true"><span>scroll</span><i></i></p>
    </div>
  </section>
) : (
  <section class="hero wrap" aria-labelledby="hero-title">
    {eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
    <h1 id="hero-title" class="hero-title">
      {lines.map((line, i) => (
        <span class="act" style={`--i:${i}`}>
          {line.emphasis && (<><em>{line.emphasis}</em> </>)}
          {line.text}
        </span>
      ))}
    </h1>
    {intro && <p class="hero-sub">{intro}</p>}
    <slot />
  </section>
)}

<style>
  .hero {
    padding: var(--sp-11) 0 var(--sp-9);
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    /* Use --muted (not --muted-2) so 10.5px passes WCAG AA on --bg. */
    color: var(--muted);
    margin-bottom: var(--sp-7);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-h1);
    font-weight: 400;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    color: var(--text);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: 1050px;
  }
  .act {
    display: block;
    opacity: 0;
    transform: translateY(20px);
    animation: rise 0.8s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 220ms + 200ms);
    text-wrap: balance;
  }
  .act em {
    font-style: italic;
    color: var(--purple-bright);
    font-weight: 400;
  }
  @keyframes rise {
    to { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .act { animation: none; opacity: 1; transform: none; }
  }
  /* v5.17.1 fix — --text-h1's clamp() floors at a flat 44px for every
     viewport under ~680px, so a 320px phone and a 420px phone render
     identical type size against very different column widths. On the
     narrow end that reads heavy/stuffed against the edge. Scale it down
     further specifically for small phones. */
  @media (max-width: 480px) {
    .hero-title { font-size: clamp(32px, 9vw, 44px); }
  }
  .hero-sub {
    margin-top: var(--sp-7);
    max-width: var(--wrap-narrow);
    color: var(--muted);
    font-size: var(--text-md);
    line-height: var(--leading-body);
  }

  /* ======================================================== scrubbed hero */
  .hero-scrub { padding: 0; position: relative; --ease-io: cubic-bezier(0.65, 0, 0.35, 1); }
  .hero-pin { padding-top: var(--sp-10, 96px); padding-bottom: var(--sp-8); }
  .act-line { display: block; text-wrap: balance; }
  .w { display: inline; }
  .w.em { font-style: italic; color: var(--purple-bright); }

  .crew {
    display: flex; align-items: center; gap: 10px;
    margin-top: var(--sp-6);
    height: 34px;
  }
  .crew i {
    width: 26px; height: 26px;
    border-radius: 50%;
    border: 1px dashed color-mix(in oklab, var(--muted) 70%, transparent);
    flex-shrink: 0;
  }
  .crew b {
    width: 30px; height: 30px;
    border-radius: 50%;
    background: var(--purple-bright);
    display: grid; place-items: center;
    flex-shrink: 0;
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--purple-bright) 50%, transparent);
  }
  .crew b span {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.04em;
    color: var(--bg);
  }
  .roles {
    list-style: none; padding: 0;
    margin: var(--sp-5) 0 0;
    display: flex; flex-wrap: wrap; gap: 8px 22px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
  }
  .roles li { display: inline-flex; align-items: center; gap: 8px; color: var(--text); }
  .role-dot {
    width: 8px; height: 8px; border-radius: 50%;
    border: 1px solid var(--purple-bright);
    background: var(--purple-bright);
    flex-shrink: 0;
  }
  .scrub-sub { margin-top: var(--sp-5); }
  .scrub-slot { margin-top: var(--sp-1); }
  .scroll-cue {
    display: none;
    align-items: center; gap: 10px;
    margin-top: var(--sp-6);
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .scroll-cue i {
    display: block; width: 1px; height: 26px;
    background: linear-gradient(to bottom, var(--purple-bright), transparent);
    animation: cue 1.8s ease-in-out infinite;
    transform-origin: 50% 0;
  }
  @keyframes cue { 0% { transform: scaleY(0); } 60% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }

  /* ---- pinned (desktop, scroll timelines, motion allowed) ---- */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .hero-scrub { view-timeline: --hero block; height: 260vh; }
      .hero-pin {
        position: sticky; top: 0;
        height: 100vh; height: 100svh;
        display: flex; flex-direction: column; justify-content: center;
        box-sizing: border-box;
        padding-top: 88px; padding-bottom: var(--sp-6);
      }
      /* Words light up, front to back, while the hero is pinned (32%..68%). */
      .w {
        color: var(--muted);
        animation: w-on var(--ease-out) both;
        animation-timeline: --hero;
        animation-range: cover calc(29% + var(--w) * 17%) cover calc(33.5% + var(--w) * 17%);
      }
      .crew i {
        animation: crew-out var(--ease-io) both;
        animation-timeline: --hero;
        animation-range: cover calc(33% + var(--c) * 1.6%) cover calc(40% + var(--c) * 1.6%);
      }
      .crew b {
        animation: crew-me var(--ease-out) both;
        animation-timeline: --hero;
        animation-range: cover 36% cover 60%;
      }
      .w.em {
        color: color-mix(in oklab, var(--purple-bright) 55%, var(--muted));
        animation-name: w-on-em;
      }
      .scrub-sub {
        animation: sub-on var(--ease-out) both;
        animation-timeline: --hero;
        animation-range: cover 52% cover 64%;
      }
      .roles .role-dot {
        background: transparent;
        animation: role-on var(--ease-out) both;
        animation-timeline: --hero;
        animation-range: cover calc(45% + var(--r) * 3.6%) cover calc(49% + var(--r) * 3.6%);
      }
      .roles .role-text {
        color: var(--muted);
        animation: role-text var(--ease-out) both;
        animation-timeline: --hero;
        animation-range: cover calc(45% + var(--r) * 3.6%) cover calc(49% + var(--r) * 3.6%);
      }
      .scroll-cue {
        display: flex;
        animation: cue-out linear both;
        animation-timeline: --hero;
        animation-range: cover 28% cover 36%;
      }
    }
  }
  @keyframes w-on    { from { color: var(--muted); } to { color: var(--text); } }
  @keyframes w-on-em { from { color: color-mix(in oklab, var(--purple-bright) 55%, var(--muted)); } to { color: var(--purple-bright); } }
  @keyframes sub-on  { from { transform: translateY(12px); } to { transform: none; } }
  @keyframes crew-out { from { transform: scale(1); opacity: 1; } to { transform: scale(0.2) translateX(40px); opacity: 0; width: 0; margin-right: -10px; border-width: 0; } }
  @keyframes crew-me {
    0%   { transform: scale(1); box-shadow: 0 0 0 0 color-mix(in oklab, var(--purple-bright) 50%, transparent); }
    60%  { transform: scale(1.35); box-shadow: 0 0 0 14px color-mix(in oklab, var(--purple-bright) 0%, transparent); }
    100% { transform: scale(1.2); box-shadow: 0 0 0 0 transparent; }
  }
  @keyframes role-on   { from { background: transparent; box-shadow: 0 0 0 0 transparent; } 60% { box-shadow: 0 0 0 6px color-mix(in oklab, var(--purple-bright) 0%, transparent); } to { background: var(--purple-bright); } }
  @keyframes role-text { from { color: var(--muted); } to { color: var(--text); } }
  @keyframes cue-out { to { opacity: 0; } }
  /* People who ask for more contrast get the finished sentence at once. */
  @media (prefers-contrast: more) {
    .roles .role-text { color: var(--text) !important; animation: none !important; }
    .roles .role-dot { background: var(--purple-bright) !important; animation: none !important; }
    .w { color: var(--text) !important; animation: none !important; }
    .w.em { color: var(--purple-bright) !important; }
    .scrub-sub { animation: none !important; transform: none !important; }
  }

  /* ---- JS progress mode: phones, Firefox, iOS without scroll timelines ----
     --p is 0 at rest and reaches 1 after 80% of the hero has scrolled away, so
     the first few words are already lit on arrival and the rest follow. */
  :global(html[data-jsp]) .hero-scrub { --p: 0; }
  :global(html[data-jsp]) .w {
    --wt: clamp(0, calc((var(--p) - var(--w) * 0.36 + 0.16) / 0.1), 1);
    color: color-mix(in oklab, var(--text) calc(var(--wt) * 100%), var(--muted));
  }
  :global(html[data-jsp]) .w.em {
    color: color-mix(in oklab, var(--purple-bright) calc(55% + var(--wt) * 45%), var(--muted));
  }
  :global(html[data-jsp]) .crew i {
    --ct: clamp(0, calc((var(--p) - 0.18 - var(--c) * 0.02) / 0.1), 1);
    transform: scale(calc(1 - var(--ct) * 0.8));
    opacity: calc(1 - var(--ct));
    margin-right: calc(var(--ct) * -26px);
  }
  :global(html[data-jsp]) .crew b {
    transform: scale(calc(1 + clamp(0, calc((var(--p) - 0.3) / 0.2), 1) * 0.2));
  }
  :global(html[data-jsp]) .roles li {
    --rt: clamp(0, calc((var(--p) - 0.34 - var(--r) * 0.07) / 0.08), 1);
  }
  :global(html[data-jsp]) .role-dot { background: color-mix(in oklab, var(--purple-bright) calc(var(--rt) * 100%), transparent); }
  :global(html[data-jsp]) .role-text { color: color-mix(in oklab, var(--text) calc(var(--rt) * 100%), var(--muted)); }
  :global(html[data-jsp]) .scrub-sub {
    transform: translateY(calc((1 - clamp(0, calc((var(--p) - 0.55) / 0.2), 1)) * 12px));
  }
  :global(html[data-jsp]) .scroll-cue {
    display: flex;
    opacity: calc(1 - clamp(0, calc(var(--p) / 0.08), 1));
  }
  @media (max-width: 480px) {
    .crew { margin-top: var(--sp-5); }
    .crew i { width: 20px; height: 20px; }
  }
</style>
