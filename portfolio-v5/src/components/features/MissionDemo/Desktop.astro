---
/**
 * Post-login Mission OS desktop.
 *
 * v5.2.2 polish: wallpaper redesigned around a real identity (bold M
 * monogram + four-pillar band + dot grid), chrome switched to a
 * system-UI font stack so it stops leaking the portfolio's editorial
 * serif into what is meant to read as an OS, top bar densified with
 * date + workspace pips, dock expanded to 6 icons (3 functional +
 * 3 clearly-inert placeholder apps).
 *
 * Window state is managed by data-window-active on .desktop-root:
 *   ""            = no window open
 *   "installer"   | "settings" | "about" = that window open
 */
import DemoWindow from './DemoWindow.astro';
import InstallerApp from './apps/InstallerApp.astro';
import SettingsApp from './apps/SettingsApp.astro';
import AboutApp from './apps/AboutApp.astro';
import FilesApp from './apps/FilesApp.astro';
import TerminalApp from './apps/TerminalApp.astro';
import FirefoxApp from './apps/FirefoxApp.astro';
---
<div class="desktop-root" data-desktop-root data-window-active="">

  <!-- ================== WALLPAPER ================== -->
  <!-- v5.10.0 rewrite: proper wallpaper composition. Big centered M
       monogram inside a triple-ring system with orbit dots + a mock
       kernel-status line + the four pillars as icons + build meta.
       Reads like a real OS wallpaper made by a designer, not a text
       watermark. Light theme gets its own palette (day-mode). -->
  <div class="wallpaper" aria-hidden="true">
    <div class="wp-base"></div>
    <div class="wp-glow-1"></div>
    <div class="wp-glow-2"></div>
    <div class="wp-grid"></div>

    <!-- Central composition -->
    <div class="wp-composition">
      <svg class="wp-mark" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="wp-m-grad" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stop-color="#D6BFFF" />
            <stop offset="100%" stop-color="#7B3FE4" />
          </linearGradient>
          <linearGradient id="wp-ring-grad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%"  stop-color="#7B3FE4" stop-opacity="0.5"/>
            <stop offset="50%" stop-color="#B993FF" stop-opacity="0.9"/>
            <stop offset="100%" stop-color="#7B3FE4" stop-opacity="0.5"/>
          </linearGradient>
        </defs>

        <!-- Triple concentric ring system -->
        <circle cx="200" cy="200" r="185" fill="none" stroke="currentColor" stroke-width="1" opacity="0.35"/>
        <circle cx="200" cy="200" r="150" fill="none" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        <circle cx="200" cy="200" r="110" fill="none" stroke="url(#wp-ring-grad)" stroke-width="1.5" stroke-dasharray="4 6"/>

        <!-- Orbit tick marks around outer ring — the four cardinal points -->
        <g fill="#B993FF">
          <circle cx="200" cy="15"  r="3"/>
          <circle cx="385" cy="200" r="3"/>
          <circle cx="200" cy="385" r="3"/>
          <circle cx="15"  cy="200" r="3"/>
        </g>

        <!-- Central M monogram -->
        <g transform="translate(200,200)">
          <path d="M -70 60 L -70 -60 L 0 20 L 70 -60 L 70 60" fill="none" stroke="url(#wp-m-grad)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="0" cy="0" r="4" fill="#D6BFFF"/>
        </g>
      </svg>

      <p class="wp-wordmark">Mission&nbsp;OS</p>
      <p class="wp-tag">v0.1 · <span>Debian Stable + KDE Plasma</span> · <span>concept demo</span></p>

      <!-- Four pillars as inline icons -->
      <ul class="wp-pillars" role="list">
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/></svg>
          <span>Privacy-first</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="1.5"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
          <span>Security-conscious</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h16M14 5l7 7-7 7"/></svg>
          <span>Portable-first</span>
        </li>
        <li>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 8a15 15 0 0 1 20 0M5 12a10 10 0 0 1 14 0M8 16a5 5 0 0 1 8 0M4 4l16 16"/></svg>
          <span>Offline-first</span>
        </li>
      </ul>
    </div>

    <!-- Corner build meta — feels like a real OS wallpaper -->
    <p class="wp-corner-tl">no telemetry · no phone-home · builds signed · gplv3</p>
    <p class="wp-corner-br">p4inz@mission-os · <span>2026</span></p>
  </div>

  <!-- ================== TOP BAR ================== -->
  <header class="topbar" role="banner">
    <div class="tb-left">
      <span class="tb-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 20V6l8 10L20 6v14" />
        </svg>
      </span>
      <span class="tb-brand">Mission&nbsp;OS</span>
      <span class="tb-sep" aria-hidden="true">·</span>
      <span class="tb-active" data-topbar-active>Desktop</span>
      <span class="tb-workspaces" role="group" aria-label="Workspaces">
        <span class="tb-ws tb-ws-active" aria-current="true">1</span>
        <span class="tb-ws">2</span>
        <span class="tb-ws">3</span>
      </span>
    </div>

    <div class="tb-center" aria-hidden="true">
      <span class="tb-date" data-topbar-date>—</span>
      <span class="tb-dot">·</span>
      <span class="tb-clock" data-topbar-clock>--:--</span>
    </div>

    <div class="tb-right">
      <span class="tb-chip tb-chip-good" title="Telemetry hooks not compiled — locked off">
        <span class="tb-chip-dot" aria-hidden="true"></span>Privacy
      </span>
      <span class="tb-chip tb-chip-good" title="Full-disk encryption enabled (LUKS2 + Argon2id)">
        <span class="tb-chip-dot" aria-hidden="true"></span>Crypto
      </span>
      <span class="tb-item" role="img" aria-label="Network offline — offline-first policy">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <path d="M2 8a15 15 0 0 1 20 0" />
          <path d="M5 12a10 10 0 0 1 14 0" />
          <path d="M8 16a5 5 0 0 1 8 0" />
          <line x1="4" y1="4" x2="20" y2="20" />
        </svg>
      </span>
      <span class="tb-item" role="img" aria-label="Battery 87 percent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
          <rect x="2" y="7" width="18" height="10" rx="2" />
          <line x1="22" y1="11" x2="22" y2="13" />
          <rect x="4" y="9" width="12" height="6" fill="currentColor" stroke="none" />
        </svg>
        <span class="tb-batt" aria-hidden="true">87%</span>
      </span>
      <span class="tb-user">
        <span class="tb-user-dot" aria-hidden="true"></span>
        p4inz@mission-os
      </span>
    </div>
  </header>

  <!-- ================== WINDOWS ================== -->
  <div class="window-area" data-window-area>
    <DemoWindow
      title="Mission Installer"
      subtitle="5 of 13 real screens shown"
      appSlug="installer"
      wide
    >
      <InstallerApp />
    </DemoWindow>

    <DemoWindow
      title="Mission Settings"
      subtitle="privacy defaults"
      appSlug="settings"
      wide
    >
      <SettingsApp />
    </DemoWindow>

    <DemoWindow
      title="About Mission OS"
      subtitle="real data from projects.ts"
      appSlug="about"
    >
      <AboutApp />
    </DemoWindow>

    <DemoWindow
      title="Files"
      subtitle="what makes Mission OS Files different"
      appSlug="files"
    >
      <FilesApp />
    </DemoWindow>

    <DemoWindow
      title="Terminal"
      subtitle="static shell example"
      appSlug="terminal"
    >
      <TerminalApp />
    </DemoWindow>

    <DemoWindow
      title="Firefox — about:privacy"
      subtitle="mission os defaults"
      appSlug="firefox"
      wide
    >
      <FirefoxApp />
    </DemoWindow>
  </div>

  <!-- ================== DOCK ================== -->
  <nav class="dock" aria-label="Applications">
    <!-- System apps — informational panels (not full simulations). -->
    <div class="dock-group" aria-label="System">
      <button type="button" class="dock-icon" data-dock-app="files" aria-label="Open Files (informational)">
        <span class="dock-icon-glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
          </svg>
        </span>
        <span class="dock-label">Files</span>
      </button>
      <button type="button" class="dock-icon" data-dock-app="terminal" aria-label="Open Terminal (static example)">
        <span class="dock-icon-glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="16" rx="2" />
            <path d="M7 9l3 3-3 3M12 15h5" />
          </svg>
        </span>
        <span class="dock-label">Terminal</span>
      </button>
      <button type="button" class="dock-icon" data-dock-app="firefox" aria-label="Open Firefox privacy defaults">
        <span class="dock-icon-glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
          </svg>
        </span>
        <span class="dock-label">Firefox</span>
      </button>
    </div>

    <div class="dock-divider" aria-hidden="true"></div>

    <!-- Info apps — functional in the demo. -->
    <div class="dock-group" aria-label="Info">
      <button type="button" class="dock-icon" data-dock-app="installer" aria-label="Open Mission Installer">
        <span class="dock-icon-glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <path d="M8 12h8M12 8v8" />
          </svg>
        </span>
        <span class="dock-label">Installer</span>
      </button>
      <button type="button" class="dock-icon" data-dock-app="settings" aria-label="Open Mission Settings">
        <span class="dock-icon-glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9c.4.6 1 1 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>
          </svg>
        </span>
        <span class="dock-label">Settings</span>
      </button>
      <button type="button" class="dock-icon" data-dock-app="about" aria-label="Open About Mission OS">
        <span class="dock-icon-glyph" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 16v-4M12 8h.01" />
          </svg>
        </span>
        <span class="dock-label">About</span>
      </button>
    </div>
  </nav>
</div>

<style>
  /* System-UI font stack for OS chrome — the portfolio's PP Editorial New
     is beautiful editorial serif but it leaks brand into what should read
     as an OS. Keep PP Editorial inside app windows (editorial content
     in windows is fine); chrome speaks a system-UI voice. */
  .desktop-root {
    --font-os: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
               Ubuntu, 'Helvetica Neue', Arial, system-ui, sans-serif;

    position: fixed;
    inset: 0;
    z-index: 7000;
    color: var(--text);
    font-family: var(--font-os);
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms var(--ease-out);
  }
  .desktop-root[data-desktop-active='true'] {
    opacity: 1;
    pointer-events: auto;
  }

  /* ================== WALLPAPER ================== */
  .wallpaper {
    position: absolute; inset: 0; z-index: 0;
    overflow: hidden;
  }
  .wp-base, .wp-glow-1, .wp-glow-2, .wp-grid {
    position: absolute; inset: 0;
    pointer-events: none;
  }
  /* Dark theme (default) wallpaper base */
  .wp-base {
    background:
      radial-gradient(ellipse 90% 60% at 50% 100%, #050210 0%, transparent 60%),
      linear-gradient(180deg, #0A0517 0%, #060213 100%);
  }
  .wp-glow-1 { background: radial-gradient(ellipse 70% 55% at 15% 15%, rgba(123, 63, 228, 0.30), transparent 60%); }
  .wp-glow-2 { background: radial-gradient(ellipse 60% 50% at 85% 85%, rgba(184, 147, 255, 0.16), transparent 65%); }
  .wp-grid {
    background-image: radial-gradient(circle, rgba(232, 225, 208, 0.06) 1px, transparent 1.4px);
    background-size: 22px 22px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 50%, #000 30%, transparent 85%);
  }

  /* v5.10.0 LIGHT THEME wallpaper — day mode for Mission OS. Cream base,
     softer purple glows, dot grid inverted so it still shows. */
  :root[data-theme='light'] .wp-base {
    background:
      radial-gradient(ellipse 90% 60% at 50% 100%, #E4D9B8 0%, transparent 60%),
      linear-gradient(180deg, #EFE6CE 0%, #E7DDBF 100%);
  }
  :root[data-theme='light'] .wp-glow-1 { background: radial-gradient(ellipse 70% 55% at 15% 15%, rgba(110, 68, 214, 0.15), transparent 60%); }
  :root[data-theme='light'] .wp-glow-2 { background: radial-gradient(ellipse 60% 50% at 85% 85%, rgba(123, 63, 228, 0.10), transparent 65%); }
  :root[data-theme='light'] .wp-grid {
    background-image: radial-gradient(circle, rgba(26, 15, 40, 0.08) 1px, transparent 1.4px);
  }

  /* v5.10.0 wallpaper composition (replacing the tiny text watermark). */
  .desktop-root {
    /* Wallpaper accent tokens — overrideable by light theme below. */
    --wp-accent: #7B3FE4;
    --wp-accent-bright: #B993FF;
    --wp-line: rgba(232, 225, 208, 0.10);
    --wp-text: rgba(232, 225, 208, 0.88);
    --wp-text-dim: rgba(232, 225, 208, 0.55);
    --wp-corner: rgba(155, 149, 176, 0.45);
  }
  :root[data-theme='light'] .desktop-root {
    --wp-accent: #6E44D6;
    --wp-accent-bright: #7B3FE4;
    --wp-line: rgba(26, 15, 40, 0.14);
    --wp-text: rgba(26, 15, 40, 0.88);
    --wp-text-dim: rgba(26, 15, 40, 0.55);
    --wp-corner: rgba(78, 65, 96, 0.55);
    --wp-chrome: #EFE6CE;
  }
  :root[data-theme='dark'] .desktop-root {
    --wp-chrome: #0A0517;
  }

  .wp-composition {
    position: absolute;
    inset: 0;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: var(--sp-3);
    text-align: center;
    padding: 12vh var(--sp-6) 20vh;
    pointer-events: none;
  }
  .wp-mark {
    width: min(320px, 48vmin);
    height: min(320px, 48vmin);
    color: var(--wp-text-dim);
    filter: drop-shadow(0 0 32px color-mix(in oklab, var(--wp-accent) 30%, transparent));
  }
  .wp-wordmark {
    font-family: var(--font-display, 'Neue Machina'), sans-serif;
    font-weight: 700;
    font-size: clamp(28px, 4.5vw, 52px);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wp-text);
    margin-top: var(--sp-4);
  }
  .wp-tag {
    font-family: var(--font-mono, 'Supply Mono'), monospace;
    font-size: 11px;
    letter-spacing: var(--tracking-eyebrow, 0.14em);
    text-transform: uppercase;
    color: var(--wp-text-dim);
  }
  .wp-tag span { color: var(--wp-text-dim); }
  .wp-pillars {
    list-style: none; padding: 0; margin: 0;
    display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: var(--sp-3) var(--sp-5);
    margin-top: var(--sp-6);
    padding: var(--sp-3) var(--sp-5);
    border: 1px solid var(--wp-line);
    border-radius: 4px;
    max-width: 720px;
  }
  .wp-pillars li {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--wp-text);
    font-family: var(--font-mono, 'Supply Mono'), monospace;
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .wp-pillars li svg {
    width: 14px; height: 14px;
    color: var(--wp-accent-bright);
  }
  .wp-corner-tl, .wp-corner-br {
    position: absolute;
    font-family: var(--font-mono, 'Supply Mono'), monospace;
    font-size: 10px;
    letter-spacing: var(--tracking-eyebrow, 0.14em);
    text-transform: uppercase;
    color: var(--wp-corner);
    pointer-events: none;
    max-width: 60vw;
  }
  .wp-corner-tl { top: 100px; left: var(--sp-6); }
  .wp-corner-br { bottom: 110px; right: var(--sp-6); }
  .wp-corner-br span { color: var(--wp-accent-bright); }

  @media (max-width: 640px) {
    .wp-mark { width: 200px; height: 200px; }
    .wp-wordmark { font-size: 24px; letter-spacing: 0.14em; }
    .wp-pillars { padding: 8px 12px; gap: 4px 10px; }
    .wp-pillars li { font-size: 9.5px; }
    .wp-corner-tl, .wp-corner-br { font-size: 9px; max-width: 45vw; }
  }

  /* ================== TOP BAR ================== */
  .topbar {
    position: absolute;
    top: 44px; left: 0; right: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--sp-4);
    padding: 6px var(--sp-5);
    background: color-mix(in oklab, var(--wp-chrome, #0A0517) 82%, transparent);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(12px);
    font-family: var(--font-os);
    font-size: 12px;
    color: var(--muted);
  }
  .tb-left  { display: inline-flex; align-items: center; gap: var(--sp-3); justify-self: start; }
  .tb-right { display: inline-flex; align-items: center; gap: var(--sp-3); justify-self: end; }
  .tb-center { display: inline-flex; align-items: center; gap: 8px; justify-self: center;
               color: var(--text); font-weight: 500; }
  .tb-mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 22px; height: 22px; color: var(--purple-bright);
  }
  .tb-mark svg { width: 16px; height: 16px; }
  .tb-brand   { color: var(--text); font-weight: 600; letter-spacing: 0.02em; }
  .tb-sep     { color: var(--muted-2); }
  .tb-active  { color: var(--muted); }
  .tb-workspaces {
    display: inline-flex; align-items: center; gap: 2px;
    margin-left: 6px;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: 6px;
  }
  .tb-ws {
    display: inline-flex; align-items: center; justify-content: center;
    width: 18px; height: 18px;
    font-family: var(--font-mono); font-size: 10px;
    color: var(--muted-2);
    border-radius: 4px;
  }
  .tb-ws-active { background: color-mix(in oklab, var(--purple) 22%, transparent); color: var(--text); }
  .tb-date, .tb-clock {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
  }
  .tb-dot { color: var(--muted-2); }
  .tb-item {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--muted);
  }
  .tb-item svg { width: 14px; height: 14px; }
  .tb-batt { font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
  .tb-chip {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 3px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: 11px;
    color: var(--muted);
    cursor: help;
  }
  .tb-chip-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--muted-2); }
  .tb-chip-good { color: var(--text); border-color: color-mix(in oklab, var(--green) 30%, var(--line)); }
  .tb-chip-good .tb-chip-dot { background: var(--green); box-shadow: 0 0 6px var(--green); }
  .tb-user {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--purple-bright);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .tb-user-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--green); box-shadow: 0 0 6px var(--green);
  }
  /* Mobile: keep the clock/date visible (it's the most useful chrome
     element on a phone). Drop the chips + workspace pips + active-app
     label first. */
  @media (max-width: 900px) {
    .tb-chip, .tb-workspaces, .tb-active, .tb-sep { display: none; }
  }
