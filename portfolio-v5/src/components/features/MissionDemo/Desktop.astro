---
/**
 * Post-login Mission OS desktop.
 * Structure: wallpaper (inline SVG) + top bar + centered window area + dock.
 *
 * Window state is managed by data-window-active on .desktop-root:
 *   ""            = no window open (default when desktop first appears)
 *   "installer"   = Installer app open
 *   "settings"    = Mission Settings app open
 *   "about"       = About Mission OS panel open
 *
 * Phase 2 ships placeholder windows for Installer and Settings so we can
 * verify the window-manager mechanics. Phase 3 replaces InstallerApp.astro
 * with real content; Phase 4 does the same for Settings and About.
 */
import DemoWindow from './DemoWindow.astro';
---
<div class="desktop-root" data-desktop-root data-window-active="">
  <!-- Wallpaper (inline SVG, Mission OS palette, no external image) -->
  <svg class="wallpaper" viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <radialGradient id="wp-glow-1" cx="30%" cy="20%" r="70%">
        <stop offset="0%"  stop-color="#4a2599" stop-opacity="0.55" />
        <stop offset="60%" stop-color="#150B25" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="wp-glow-2" cx="80%" cy="90%" r="60%">
        <stop offset="0%"  stop-color="#7B3FE4" stop-opacity="0.35" />
        <stop offset="70%" stop-color="#0A0517" stop-opacity="0" />
      </radialGradient>
      <linearGradient id="wp-base" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#0A0517" />
        <stop offset="100%" stop-color="#050210" />
      </linearGradient>
    </defs>
    <rect width="1600" height="1000" fill="url(#wp-base)" />
    <rect width="1600" height="1000" fill="url(#wp-glow-1)" />
    <rect width="1600" height="1000" fill="url(#wp-glow-2)" />
    <!-- subtle constellation of Mission OS mark -->
    <g fill="none" stroke="rgba(232,225,208,0.06)" stroke-width="1">
      <circle cx="800" cy="500" r="180" />
      <circle cx="800" cy="500" r="240" />
      <circle cx="800" cy="500" r="320" />
    </g>
    <text x="800" y="510" text-anchor="middle"
      font-family="'PP Editorial New', Georgia, serif"
      font-style="italic" font-size="72" fill="rgba(232,225,208,0.05)">
      mission os
    </text>
  </svg>

  <!-- Top bar -->
  <header class="topbar" role="banner">
    <div class="tb-left">
      <span class="tb-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="8" />
          <path d="M12 4v16M4 12h16" />
        </svg>
      </span>
      <span class="tb-brand">Mission OS</span>
      <span class="tb-sep" aria-hidden="true">·</span>
      <span class="tb-active" data-topbar-active>Desktop</span>
    </div>
    <div class="tb-right">
      <span class="tb-item" aria-label="Network offline">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <path d="M2 8a15 15 0 0 1 20 0" />
          <path d="M5 12a10 10 0 0 1 14 0" />
          <path d="M8 16a5 5 0 0 1 8 0" />
          <line x1="4" y1="4" x2="20" y2="20" />
        </svg>
        Offline
      </span>
      <span class="tb-item" aria-label="Battery 87 percent">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
          <rect x="2" y="7" width="18" height="10" rx="2" />
          <line x1="22" y1="11" x2="22" y2="13" />
          <rect x="4" y="9" width="12" height="6" fill="currentColor" stroke="none" />
        </svg>
        87%
      </span>
      <span class="tb-item tb-clock" aria-label="Clock" data-topbar-clock>--:--</span>
      <span class="tb-item tb-user">
        <span class="tb-user-dot" aria-hidden="true"></span>
        p4inz@mission-os
      </span>
    </div>
  </header>

  <!-- Windows area -->
  <div class="window-area" data-window-area>
    <DemoWindow
      title="Mission Installer"
      subtitle="phase 2 placeholder"
      appSlug="installer"
    >
      <p class="ph-body">Installer app will render here.</p>
      <p class="ph-body">Phase 3 wires the real screen carousel: Welcome, Privacy Setup, Security Options, Summary, Completion — pulled from the case study's 13-screen sequence with honest "…" gaps for the elided steps.</p>
    </DemoWindow>

    <DemoWindow
      title="Mission Settings"
      subtitle="phase 2 placeholder"
      appSlug="settings"
    >
      <p class="ph-body">Mission Settings will render here.</p>
      <p class="ph-body">Phase 4 wires real privacy toggles (Telemetry, Location, Default browser, Tor preinstalled) with plain-text explanations.</p>
    </DemoWindow>

    <DemoWindow
      title="About Mission OS"
      subtitle="phase 2 placeholder"
      appSlug="about"
    >
      <p class="ph-body">About panel will render here.</p>
      <p class="ph-body">Phase 4 pulls real version + status from projects.ts — no fabricated info.</p>
    </DemoWindow>
  </div>

  <!-- Dock -->
  <nav class="dock" aria-label="Applications">
    <button type="button" class="dock-icon" data-dock-app="installer" aria-label="Open Mission Installer">
      <span class="dock-icon-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="3" />
          <path d="M8 12h8M12 8v8" />
        </svg>
      </span>
      <span class="dock-label">Installer</span>
    </button>
    <button type="button" class="dock-icon" data-dock-app="settings" aria-label="Open Mission Settings">
      <span class="dock-icon-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1A1.7 1.7 0 0 0 4.6 9a1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9V9c.4.6 1 1 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>
        </svg>
      </span>
      <span class="dock-label">Settings</span>
    </button>
    <button type="button" class="dock-icon" data-dock-app="about" aria-label="Open About Mission OS">
      <span class="dock-icon-glyph" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 16v-4M12 8h.01" />
        </svg>
      </span>
      <span class="dock-label">About</span>
    </button>
  </nav>
</div>

<style>
  .desktop-root {
    position: fixed;
    inset: 0;
    z-index: 7000;
    color: var(--text);
    font-family: var(--font-body);
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms var(--ease-out);
  }
  .desktop-root[data-desktop-active='true'] {
    opacity: 1;
    pointer-events: auto;
  }

  .wallpaper {
    position: absolute;
    inset: 0;
    width: 100%; height: 100%;
    z-index: 0;
  }

  /* ---- Top bar ---- */
  .topbar {
    position: absolute;
    top: 44px; left: 0; right: 0;
    /* 44px = ribbon height at desktop; increases on mobile */
    z-index: 2;
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--sp-4);
    padding: 8px var(--sp-6);
    background: color-mix(in oklab, var(--surface-1) 88%, transparent);
    border-bottom: 1px solid var(--line);
    backdrop-filter: blur(10px);
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted);
  }
  .tb-left, .tb-right { display: inline-flex; align-items: center; gap: var(--sp-4); }
  .tb-mark {
    display: inline-flex; align-items: center; justify-content: center;
    width: 20px; height: 20px;
    color: var(--purple-bright);
  }
  .tb-mark svg { width: 14px; height: 14px; }
  .tb-brand { color: var(--text); font-family: var(--font-display); font-style: italic; font-size: var(--text-sm); text-transform: none; letter-spacing: 0; }
  .tb-sep { color: var(--muted-2); }
  .tb-active { color: var(--muted-2); }
  .tb-item {
    display: inline-flex; align-items: center; gap: 6px;
    color: var(--muted);
  }
  .tb-item svg { width: 13px; height: 13px; }
  .tb-clock { color: var(--text); }
  .tb-user { color: var(--purple-bright); }
  .tb-user-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--green); box-shadow: 0 0 6px var(--green);
  }
  @media (max-width: 760px) {
    .topbar { flex-wrap: wrap; padding: 6px var(--sp-4); }
    .tb-user, .tb-item[aria-label='Network offline'] { display: none; }
  }

  /* ---- Window area ---- */
  .window-area {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: grid;
    place-items: center;
    padding: 130px var(--sp-4) 130px;
    /* leaves room for ribbon(44) + topbar(~40) at top, dock(~90) at bottom */
    pointer-events: none;
  }
  .window-area :global(.demo-window) {
    display: none;
    pointer-events: auto;
  }
  .desktop-root[data-window-active='installer'] .window-area :global([data-window='installer']),
  .desktop-root[data-window-active='settings']  .window-area :global([data-window='settings']),
  .desktop-root[data-window-active='about']     .window-area :global([data-window='about']) {
    display: flex;
  }

  .ph-body { color: var(--muted); }
  .ph-body + .ph-body { margin-top: var(--sp-3); }

  /* ---- Dock ---- */
  .dock {
    position: absolute;
    left: 50%;
    bottom: var(--sp-6);
    transform: translateX(-50%);
    z-index: 4;
    display: inline-flex;
    gap: var(--sp-3);
    padding: 10px 14px;
    background: color-mix(in oklab, var(--surface-1) 88%, transparent);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(12px);
    box-shadow: 0 10px 40px color-mix(in oklab, #000 40%, transparent);
  }
  .dock-icon {
    display: inline-flex; flex-direction: column; align-items: center;
    gap: 6px;
    padding: 10px 14px 8px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--muted);
    font-family: var(--font-mono); font-size: 10px;
    letter-spacing: var(--tracking-mono); text-transform: uppercase;
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
    min-width: 68px;
  }
  .dock-icon:hover, .dock-icon:focus-visible {
    color: var(--purple-bright);
    background: color-mix(in oklab, var(--purple) 8%, transparent);
    transform: translateY(-2px);
    outline: none;
  }
  .dock-icon:focus-visible {
    outline: 2px solid var(--purple-bright);
    outline-offset: 2px;
  }
  .dock-icon-glyph { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; }
  .dock-icon-glyph svg { width: 22px; height: 22px; }
  .dock-label { color: currentColor; }

  /* Highlight the active app in the dock */
  .desktop-root[data-window-active='installer'] .dock-icon[data-dock-app='installer'],
  .desktop-root[data-window-active='settings']  .dock-icon[data-dock-app='settings'],
  .desktop-root[data-window-active='about']     .dock-icon[data-dock-app='about'] {
    color: var(--purple-bright);
    background: color-mix(in oklab, var(--purple) 12%, transparent);
    border-color: var(--line-strong);
  }

  @media (max-width: 640px) {
    .dock { left: var(--sp-4); right: var(--sp-4); bottom: var(--sp-4); transform: none; justify-content: space-around; }
    .dock-icon { min-width: 0; padding: 8px 10px; }
    .window-area { padding: 140px var(--sp-3) 120px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .desktop-root { transition: none; }
    .dock-icon { transition: none; }
  }
</style>
