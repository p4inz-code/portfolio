---
import type { Project } from '../../data/projects';
import StatusPill from '../ui/StatusPill.astro';
import Tag from '../ui/Tag.astro';

interface Props {
  project: Project;
  variant?: 'default' | 'featured' | 'compact';
}
const { project, variant = 'default' } = Astro.props;

const linkProps = project.isExternal
  ? { target: '_blank', rel: 'noopener noreferrer' }
  : {};
---
<a
  href={project.href}
  class:list={['project-card', `variant-${variant}`]}
  {...linkProps}
>
  {variant === 'featured' && (
    <div class="card-media" aria-hidden="true">
      <span class="card-media-title">{project.name}</span>
      <span class="card-media-sub">Concept preview</span>
    </div>
  )}
  <div class="card-body">
    <StatusPill status={project.status} size="sm" />
    <h3 class="card-title">{project.name}</h3>
    <p class="card-tagline">{project.tagline}</p>
    {variant !== 'compact' && <p class="card-desc">{project.description}</p>}
    {project.tags.length > 0 && (
      <div class="card-tags">
        {project.tags.map((t) => <Tag label={t} />)}
      </div>
    )}
    {project.isExternal && (
      <span class="card-ext-hint" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17 17 7M8 7h9v9"/>
        </svg>
      </span>
    )}
  </div>
</a>

<style>
  .project-card {
    display: block;
    padding: var(--sp-6);
    border: 1px solid var(--line);
    border-radius: var(--radius-xl);
    background: var(--surface-1);
    color: var(--text);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease-out),
      transform var(--dur) var(--ease-out),
      background var(--dur) var(--ease-out);
    position: relative;
  }
  .project-card:hover {
    border-color: var(--line-strong);
    transform: translateY(-3px);
    background: var(--surface-2);
  }
  .variant-featured {
    display: grid;
    grid-template-columns: 320px 1fr;
    gap: var(--sp-7);
    align-items: center;
    padding: var(--sp-7);
  }
  @media (max-width: 900px) {
    .variant-featured { grid-template-columns: 1fr; }
  }

  .card-media {
    min-height: 220px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
    background: var(--aurora), linear-gradient(180deg, var(--surface-2), var(--surface-1));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sp-2);
  }
  .card-media-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-style: italic;
    color: var(--text);
  }
  .card-media-sub {
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted-2);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 400;
    letter-spacing: -0.015em;
    margin: var(--sp-3) 0 var(--sp-1);
  }
  .card-tagline {
    color: var(--purple-bright);
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-sm);
    margin-bottom: var(--sp-3);
  }
  .card-desc {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    margin-bottom: var(--sp-4);
  }
  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .card-ext-hint {
    position: absolute;
    top: var(--sp-6);
    right: var(--sp-6);
    color: var(--muted-2);
    transition: color var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
  }
  .card-ext-hint svg { width: 16px; height: 16px; }
  .project-card:hover .card-ext-hint {
    color: var(--purple-bright);
    transform: translate(2px, -2px);
  }
</style>
