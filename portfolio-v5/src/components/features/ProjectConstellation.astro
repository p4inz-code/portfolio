---
/**
 * Project constellation -- a node-graph view of the same work shown
 * elsewhere on /work as a deck, an index, and a category list. Connects
 * projects by what actually links them (shared category, shared stack,
 * shared tag) instead of a flat list order. Layout is computed once at
 * build time (see ../../lib/constellation.ts) -- no physics simulation
 * ships to the browser, only hover/focus highlight + drag-to-reposition.
 *
 * Deliberately the same idea as Kanvaz's own Map View feature (its README:
 * "visualize the whole web as a node-editor-style graph with bezier
 * cables"), aimed at this portfolio instead of a Kanvaz board.
 *
 * Visual language is pulled from what this site already does elsewhere
 * (the `>` caret used on every terminal-style label, flat --surface-2
 * panels with no blur-for-its-own-sake, mono uppercase eyebrows) rather
 * than the generic rounded-pill-plus-colored-dot chip that's the default
 * output of basically every AI page builder. Featured projects get the
 * same display-italic treatment their name gets everywhere else on the
 * site, so hierarchy reads through type, not just size.
 */
import type { Project } from '../../data/projects';
import { computeConstellation } from '../../lib/constellation';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;

const inputNodes = projects.map((p) => ({
  id: p.slug,
  category: p.category,
  stack: p.stack,
  tags: p.tags,
  license: p.license,
}));
const labels = Object.fromEntries(projects.map((p) => [p.slug, p.name]));
const { nodes, edges } = computeConstellation(inputNodes, labels);

const projectBySlug = new Map(projects.map((p) => [p.slug, p]));
const nodeBySlug = new Map(nodes.map((n) => [n.id, n]));

// adjacency + per-node connection detail (label + why), for the detail panel
const adjacency: Record<string, string[]> = {};
const connectionDetail: Record<string, { id: string; label: string; reason: string }[]> = {};
for (const n of nodes) {
  adjacency[n.id] = [];
  connectionDetail[n.id] = [];
}
for (const e of edges) {
  adjacency[e.from].push(e.to);
  adjacency[e.to].push(e.from);
  connectionDetail[e.from].push({ id: e.to, label: labels[e.to], reason: e.reason });
  connectionDetail[e.to].push({ id: e.from, label: labels[e.from], reason: e.reason });
}
const degree = Object.fromEntries(nodes.map((n) => [n.id, adjacency[n.id].length]));
const maxDegree = Math.max(1, ...Object.values(degree));

const CATEGORY_LABEL: Record<string, string> = { os: 'OS', app: 'App', cli: 'CLI', web: 'Web' };

// deterministic string hash -> used only to vary edge curvature, not layout
function hash(s: string): number {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0;
  return h;
}

const edgePaths = edges.map((e) => {
  const a = nodeBySlug.get(e.from)!;
  const b = nodeBySlug.get(e.to)!;
  const x1 = a.x, y1 = (a.y / 100) * 56;
  const x2 = b.x, y2 = (b.y / 100) * 56;
  const sign = hash(e.from + e.to) % 2 === 0 ? 1 : -1;
  return { ...e, x1, y1, x2, y2, sign };
});
---
<div class="constellation" id="constellation">
  <div class="cx-toolbar">
    <span class="cx-toolbar-eyebrow">Connected by</span>
    <span class="cx-toolbar-item" data-cat="os"><b>&gt;</b>OS</span>
    <span class="cx-toolbar-item" data-cat="app"><b>&gt;</b>App</span>
    <span class="cx-toolbar-item" data-cat="cli"><b>&gt;</b>CLI</span>
    <span class="cx-toolbar-item" data-cat="none"><b>&gt;</b>Other</span>
    <span class="cx-toolbar-hint">drag to rearrange</span>
  </div>

  <div class="cx-canvas">
    <svg class="cx-edges" viewBox="0 0 100 56" preserveAspectRatio="none" aria-hidden="true">
      {edgePaths.map((e) => (
        <path
          class="cx-edge"
          data-from={e.from}
          data-to={e.to}
          data-sign={e.sign}
          d={`M ${e.x1} ${e.y1} Q ${e.x1} ${e.y1} ${e.x2} ${e.y2}`}
          fill="none"
        />
      ))}
    </svg>

    <div class="cx-nodes">
      {nodes.map((n, i) => {
        const p = projectBySlug.get(n.id)!;
        const cat = n.category && CATEGORY_LABEL[n.category] ? n.category : 'none';
        const weight = degree[n.id] / maxDegree; // 0-1
        const info = {
          label: n.label,
          tagline: p.tagline,
          connections: connectionDetail[n.id],
        };
        return (
          <a
            class:list={['cx-node', { 'cx-node-featured': p.featured }]}
            data-cat={cat}
            href={p.href}
            draggable="false"
            {...(p.isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            style={`left:${n.x}%; top:${n.y}%; --i:${i}; --weight:${weight.toFixed(2)};`}
            data-node-id={n.id}
            data-x={n.x.toFixed(3)}
            data-y={n.y.toFixed(3)}
            data-connects={adjacency[n.id].join(',')}
            data-info={JSON.stringify(info)}
          >
            <b class="cx-caret" aria-hidden="true">&gt;</b><span class="cx-label">{n.label}</span>
          </a>
        );
      })}
    </div>
  </div>

  <div class="cx-panel" id="cxPanel" aria-live="polite">
    <p class="cx-panel-hint">Hover or tab through a project to see what connects it to the rest.</p>
  </div>
</div>

<script>
  (function () {
    const root = document.getElementById('constellation');
    const panel = document.getElementById('cxPanel');
    const svg = root?.querySelector<SVGSVGElement>('.cx-edges');
    if (!root || !panel || !svg) return;
    const nodeEls = Array.from(root.querySelectorAll<HTMLAnchorElement>('.cx-node'));
    const edgeEls = Array.from(root.querySelectorAll<SVGPathElement>('.cx-edge'));
    const defaultHint = panel.innerHTML;

    // live position table, seeded from the build-time layout, kept in sync
    // as nodes get dragged so cable redraws always read current state
    const pos: Record<string, { x: number; y: number }> = {};
    nodeEls.forEach((n) => {
      pos[n.dataset.nodeId!] = { x: parseFloat(n.dataset.x!), y: parseFloat(n.dataset.y!) };
    });

    function redrawEdge(edge: SVGPathElement) {
      const a = pos[edge.dataset.from!];
      const b = pos[edge.dataset.to!];
      if (!a || !b) return;
      const x1 = a.x, y1 = (a.y / 100) * 56;
      const x2 = b.x, y2 = (b.y / 100) * 56;
      const mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
      const dx = x2 - x1, dy = y2 - y1;
      const len = Math.max(Math.hypot(dx, dy), 1);
      const px = -dy / len, py = dx / len;
      const sign = edge.dataset.sign === '1' ? 1 : -1;
      const bend = Math.min(len * 0.18, 10) * sign;
      const cx = mx + px * bend, cy = my + py * bend;
      edge.setAttribute('d', `M ${x1} ${y1} Q ${cx} ${cy} ${x2} ${y2}`);
    }
    edgeEls.forEach(redrawEdge);

    function clear() {
      root!.classList.remove('cx-active');
      nodeEls.forEach((n) => n.classList.remove('cx-node-on', 'cx-node-dim'));
      edgeEls.forEach((e) => e.classList.remove('cx-edge-on'));
      panel!.innerHTML = defaultHint;
    }

    function activate(el: HTMLAnchorElement) {
      const id = el.dataset.nodeId!;
      const connects = (el.dataset.connects || '').split(',').filter(Boolean);
      const connected = new Set([id, ...connects]);
      root!.classList.add('cx-active');
      nodeEls.forEach((n) => {
        const on = connected.has(n.dataset.nodeId!);
        n.classList.toggle('cx-node-on', on);
        n.classList.toggle('cx-node-dim', !on);
      });
      edgeEls.forEach((e) => {
        const on = e.dataset.from === id || e.dataset.to === id;
        e.classList.toggle('cx-edge-on', on);
      });

      let info: { label: string; tagline: string; connections: { id: string; label: string; reason: string }[] };
      try {
        info = JSON.parse(el.dataset.info || '{}');
      } catch {
        return;
      }
      const rows = info.connections
        .map((c) => `<li><span class="cx-panel-to">${c.label}</span><span class="cx-panel-why">${c.reason}</span></li>`)
        .join('');
      panel!.innerHTML = `
        <p class="cx-panel-title">${info.label}</p>
        <p class="cx-panel-tagline">${info.tagline}</p>
        ${rows ? `<ul class="cx-panel-list">${rows}</ul>` : `<p class="cx-panel-tagline">No shared category, stack, or tag with the rest -- stands on its own.</p>`}
      `;
    }

    // --- drag to reposition, with live cable redraw ---
    nodeEls.forEach((n) => {
      let dragging = false;
      let moved = false;
      let startClientX = 0, startClientY = 0;

      // draggable="false" on the element stops this in most browsers, but
      // some still fire native dragstart for <a> after a held-then-moved
      // press -- belt and suspenders, since that's exactly the "works if I
      // flick it, not if I hold it" symptom a real hold-to-drag hijack has.
      n.addEventListener('dragstart', (e) => e.preventDefault());

      n.addEventListener('pointerdown', (e) => {
        if (e.button !== undefined && e.button !== 0) return;
        dragging = true;
        moved = false;
        startClientX = e.clientX;
        startClientY = e.clientY;
        n.setPointerCapture(e.pointerId);
        n.classList.add('cx-dragging');
      });

      n.addEventListener('pointermove', (e) => {
        if (!dragging) return;
        const dxPx = e.clientX - startClientX;
        const dyPx = e.clientY - startClientY;
        if (Math.abs(dxPx) > 3 || Math.abs(dyPx) > 3) moved = true;
        if (!moved) return;

        const rect = root!.getBoundingClientRect();
        let xPct = ((e.clientX - rect.left) / rect.width) * 100;
        let yPct = ((e.clientY - rect.top) / rect.height) * 100;
        xPct = Math.min(97, Math.max(3, xPct));
        yPct = Math.min(95, Math.max(5, yPct));

        n.style.left = xPct + '%';
        n.style.top = yPct + '%';
        pos[n.dataset.nodeId!] = { x: xPct, y: yPct };

        const id = n.dataset.nodeId!;
        edgeEls.forEach((edge) => {
          if (edge.dataset.from === id || edge.dataset.to === id) redrawEdge(edge);
        });
      });

      function endDrag(e: PointerEvent) {
        if (!dragging) return;
        dragging = false;
        n.classList.remove('cx-dragging');
        if (moved) {
          // this was a drag, not a click -- swallow the click Astro/browser
          // is about to fire so it doesn't navigate away mid-rearrange
          const swallow = (ce: MouseEvent) => {
            ce.preventDefault();
            n.removeEventListener('click', swallow);
          };
          n.addEventListener('click', swallow, { once: true });
        }
      }
      n.addEventListener('pointerup', endDrag);
      n.addEventListener('pointercancel', endDrag);

      n.addEventListener('mouseenter', () => activate(n));
      n.addEventListener('focus', () => activate(n));
      n.addEventListener('mouseleave', clear);
      n.addEventListener('blur', clear);
    });

    // staggered entrance -- only once, the first time it scrolls into view
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduceMotion && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              root!.classList.add('cx-in');
              io.disconnect();
            }
          }
        },
        { threshold: 0.15 }
      );
      io.observe(root!);
    } else {
      root!.classList.add('cx-in');
    }
  })();
</script>

<style>
  .constellation {
    position: relative;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    background: var(--surface-1);
    overflow: hidden;
  }

  .cx-toolbar {
    display: flex; align-items: center; gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--line);
    background: color-mix(in oklab, var(--surface-2) 60%, transparent);
    flex-wrap: wrap;
  }
  .cx-toolbar-eyebrow {
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
    margin-right: var(--sp-2);
  }
  .cx-toolbar-item {
    display: inline-flex; align-items: center; gap: 4px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }
  .cx-toolbar-item b { font-weight: 500; }
  .cx-toolbar-item[data-cat='os']   b { color: var(--purple-bright); }
  .cx-toolbar-item[data-cat='app']  b { color: var(--green-live); }
  .cx-toolbar-item[data-cat='cli']  b { color: var(--warn); }
  .cx-toolbar-item[data-cat='none'] b { color: var(--muted); }
  .cx-toolbar-hint {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--muted-2);
    font-style: italic;
  }

  .cx-canvas {
    position: relative;
    width: 100%;
    aspect-ratio: 100 / 56;
    min-height: 400px;
  }
  .cx-edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .cx-edge {
    stroke: var(--line-strong);
    stroke-width: 0.12;
    stroke-linecap: round;
    transition: stroke var(--dur) var(--ease-out), stroke-width var(--dur) var(--ease-out), opacity var(--dur) var(--ease-out);
  }
  .constellation.cx-active .cx-edge { opacity: 0.2; }
  .cx-edge.cx-edge-on {
    stroke: var(--purple-bright);
    stroke-width: 0.32;
    opacity: 1;
  }

  .cx-nodes { position: absolute; inset: 0; }

  .cx-node {
    position: absolute;
    transform: translate(-50%, -50%);
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    padding: 5px 9px;
    border-radius: 3px;
    border: 1px solid var(--line-strong);
    border-left-width: 2px;
    background: var(--surface-2);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: calc(10px + var(--weight, 0) * 2.5px);
    letter-spacing: 0.01em;
    white-space: nowrap;
    text-decoration: none;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-touch-callout: none; /* stops iOS's hold-on-a-link share sheet from hijacking the drag */
    -webkit-user-drag: none;
    /* Always visible by default -- opacity never depends on JS running.
       An entrance effect must never be the only thing making content
       visible; the stagger below only ever animates transform. */
    transition:
      border-color var(--dur-fast) var(--ease-out),
      box-shadow var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
    z-index: 1;
  }
  .cx-node.cx-dragging { cursor: grabbing; z-index: 4; transition: none; }
  .cx-node-featured .cx-label { font-family: var(--font-display); font-style: italic; }

  .constellation.cx-in .cx-node {
    animation: cx-node-in 0.4s var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 45ms);
  }
  @keyframes cx-node-in {
    from { transform: translate(-50%, -50%) scale(0.5); }
    to   { transform: translate(-50%, -50%) scale(1); }
  }

  .cx-caret { color: var(--muted); font-weight: 500; }
  .cx-node[data-cat='os']   { border-left-color: var(--purple-bright); }
  .cx-node[data-cat='os']   .cx-caret { color: var(--purple-bright); }
  .cx-node[data-cat='app']  { border-left-color: var(--green-live); }
  .cx-node[data-cat='app']  .cx-caret { color: var(--green-live); }
  .cx-node[data-cat='cli']  { border-left-color: var(--warn); }
  .cx-node[data-cat='cli']  .cx-caret { color: var(--warn); }
  .cx-node[data-cat='none'] { border-left-color: var(--muted); }

  .cx-node:hover, .cx-node:focus-visible {
    border-color: var(--purple-bright);
    transform: translate(-50%, -50%) scale(1.06);
    outline: none;
  }
  .cx-node.cx-node-on {
    border-color: var(--purple-bright);
    box-shadow: 0 0 0 1px color-mix(in oklab, var(--purple-bright) 35%, transparent);
    z-index: 2;
  }
  .cx-node.cx-node-dim { opacity: 0.3; }

  .cx-panel {
    position: relative;
    margin: var(--sp-4);
    margin-top: 0;
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: color-mix(in oklab, var(--bg) 75%, transparent);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
    min-height: 44px;
    max-height: 130px;
    overflow-y: auto;
  }
  .cx-panel-hint {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted-2);
  }

  @media (max-width: 760px) {
    .cx-canvas { min-height: 520px; }
    .cx-node { font-size: 10px; padding: 4px 8px; }
    .cx-toolbar-hint { display: none; }
    .cx-panel { max-height: none; }
  }
</style>

<style is:global>
  /* Astro's scoped-style attribute only applies to elements present in the
     static template at build time -- it never reaches markup injected via
     innerHTML from the client script above, so the panel's dynamic content
     (title/tagline/connection list) has to live here instead, unscoped. */
  #cxPanel .cx-panel-title {
    margin: 0 0 2px;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--text);
  }
  #cxPanel .cx-panel-tagline {
    margin: 0 0 var(--sp-2);
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--muted);
  }
  #cxPanel .cx-panel-list {
    list-style: none;
    margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; gap: var(--sp-2) var(--sp-4);
  }
  #cxPanel .cx-panel-list li {
    display: flex; flex-direction: column;
    font-family: var(--font-mono);
    font-size: 10.5px;
  }
  #cxPanel .cx-panel-to { color: var(--purple-bright); }
  #cxPanel .cx-panel-why { color: var(--muted-2); font-size: 9.5px; }
</style>
