---
/**
 * Sitewide chat widget -- a floating trigger that opens a sidebar (full
 * width takeover below 640px, a fixed drawer above it). Answers come from
 * functions/api/chat.ts: an FAQ table, then a cache, then a real Workers AI
 * call grounded in this site's own live llms.txt. Never fabricates -- if
 * the backend can't answer, it says so.
 *
 * Real back-button handling: opening the sidebar pushes a history entry,
 * so a visitor who presses their device's back button (a very common
 * instinct, especially for less tech-fluent visitors on mobile) closes the
 * chat instead of leaving the page entirely.
 */
---
<div id="chatWidget" class="chat-widget">
  <button
    type="button"
    id="chatTrigger"
    class="chat-trigger"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="chatPanel"
    aria-label="Open chat"
  >
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
  </button>

  <div id="chatOverlay" class="chat-overlay" hidden></div>

  <div id="chatPanel" class="chat-panel" role="dialog" aria-modal="true" aria-label="Ask about the work" hidden>
    <div class="chat-head">
      <img src="/ap-mark.png" alt="" class="chat-avatar" width="30" height="30" />
      <div class="chat-head-text">
        <p class="chat-head-title">Ask about the work</p>
        <p class="chat-head-status"><span class="chat-dot" aria-hidden="true"></span>Answers from what's actually shipped</p>
      </div>
      <button type="button" id="chatClose" class="chat-icon-btn" aria-label="Close chat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div id="chatThread" class="chat-thread" aria-live="polite">
      <div class="chat-row">
        <img src="/ap-mark.png" alt="" class="chat-avatar-sm" width="24" height="24" />
        <p class="chat-bubble chat-bubble-bot">Ask me anything about the real work. If I don't know, I'll say so instead of guessing.</p>
      </div>
      <div id="chatStarters" class="chat-starters">
        <button type="button" class="chat-chip" data-q="What are you working on right now?">What are you working on right now?</button>
        <button type="button" class="chat-chip" data-q="What's Kanvaz built with?">What's Kanvaz built with?</button>
        <button type="button" class="chat-chip" data-q="Are you available for freelance work?">Are you available for freelance work?</button>
      </div>
    </div>

    <form id="chatForm" class="chat-inputrow" novalidate>
      <input id="chatInput" class="chat-input" type="text" placeholder="Ask a question" autocomplete="off" maxlength="500" />
      <button type="submit" id="chatSend" class="chat-send" aria-label="Send">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  (function () {
    const widget = document.getElementById('chatWidget');
    const trigger = document.getElementById('chatTrigger');
    const overlay = document.getElementById('chatOverlay');
    const panel = document.getElementById('chatPanel');
    const closeBtn = document.getElementById('chatClose');
    const thread = document.getElementById('chatThread');
    const starters = document.getElementById('chatStarters');
    const form = document.getElementById('chatForm');
    const input = document.getElementById('chatInput');
    const sendBtn = document.getElementById('chatSend');
    if (!widget || !trigger || !overlay || !panel || !closeBtn || !thread || !form || !input || !sendBtn) return;

    let open = false;
    let lastFocused: HTMLElement | null = null;
    // Bumped on every open/close call so a rapid reopen-mid-close (or
    // close-mid-open) can tell a stale scheduled callback "you've been
    // superseded" instead of clobbering whichever state actually won.
    let transitionGen = 0;

    // The site's sticky top nav and desktop side-rail are real, persistent
    // chrome -- the panel should dock below/beside them, never fight them
    // for the same pixels. Measured, not guessed, since nav height can
    // change with content or a future redesign.
    function syncChromeOffset() {
      const nav = document.querySelector('.nav');
      if (nav) {
        document.documentElement.style.setProperty('--chat-nav-h', nav.getBoundingClientRect().height + 'px');
      }
    }
    syncChromeOffset();
    window.addEventListener('resize', syncChromeOffset);

    function openChat() {
      if (open) return;
      open = true;
      const myGen = ++transitionGen;
      lastFocused = document.activeElement as HTMLElement;
      panel.hidden = false;
      overlay.hidden = false;
      // A single rAF here is flaky: on a cold first open, the browser can
      // batch the "un-hide" and the class-add into the same frame, so there
      // is never a committed closed state to transition from -- the panel
      // just stays stuck at translateX(100%). Forcing a layout read, then
      // waiting a second frame, guarantees the closed state is actually
      // painted before the open class (and its transition) is applied.
      void panel.offsetHeight;
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (myGen !== transitionGen) return; // superseded by a close in between
          panel.classList.add('chat-panel-open');
          overlay.classList.add('chat-overlay-open');
        });
      });
      trigger.setAttribute('aria-expanded', 'true');
      // Real back-button handling: a visitor who presses back (common
      // instinct, especially for less tech-fluent visitors on mobile)
      // should close the chat, not leave the page.
      history.pushState({ chatOpen: true }, '');
      input.focus();
      document.addEventListener('keydown', onKeydown);
    }

    function closeChat(fromPopstate?: boolean) {
      if (!open) return;
      open = false;
      const myGen = ++transitionGen;
      panel.classList.remove('chat-panel-open');
      overlay.classList.remove('chat-overlay-open');
      // Hide only once the slide-out transition actually finishes (300ms
      // per --dur) rather than a hardcoded delay that drifted out of sync
      // with it and cut the animation short. transitionend won't fire at
      // all under prefers-reduced-motion (transition:none), so a short
      // fallback timeout covers that case too. The generation check means a
      // reopen in the meantime always wins -- this callback can only hide
      // the panel if nothing has superseded this exact close since.
      let hidden = false;
      const finishHide = () => {
        if (hidden || myGen !== transitionGen) return;
        hidden = true;
        panel.hidden = true;
        overlay.hidden = true;
      };
      panel.addEventListener('transitionend', finishHide, { once: true });
      window.setTimeout(finishHide, 350);
      trigger.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKeydown);
      if (!fromPopstate && history.state && history.state.chatOpen) {
        history.back();
      }
      if (lastFocused) lastFocused.focus();
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') { closeChat(); return; }
      if (e.key === 'Tab') {
        const focusables = panel.querySelectorAll<HTMLElement>('button, input, [tabindex]:not([tabindex="-1"])');
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    }

    window.addEventListener('popstate', () => { if (open) closeChat(true); });

    trigger.addEventListener('click', openChat);
    closeBtn.addEventListener('click', () => closeChat());
    overlay.addEventListener('click', () => closeChat());

    function addUserMsg(text: string) {
      const row = document.createElement('div');
      row.className = 'chat-row chat-row-user';
      const bubble = document.createElement('p');
      bubble.className = 'chat-bubble chat-bubble-user';
      bubble.textContent = text;
      row.appendChild(bubble);
      thread.appendChild(row);
      thread.scrollTop = thread.scrollHeight;
    }

    function addBotMsg(text: string) {
      const row = document.createElement('div');
      row.className = 'chat-row';
      const avatar = document.createElement('img');
      avatar.src = '/ap-mark.png';
      avatar.alt = '';
      avatar.className = 'chat-avatar-sm';
      const bubble = document.createElement('p');
      bubble.className = 'chat-bubble chat-bubble-bot';
      bubble.textContent = text;
      row.appendChild(avatar);
      row.appendChild(bubble);
      thread.appendChild(row);
      thread.scrollTop = thread.scrollHeight;
    }

    function showTyping() {
      const row = document.createElement('div');
      row.className = 'chat-row';
      row.id = 'chatTyping';
      row.innerHTML =
        '<span class="chat-avatar-sm chat-avatar-typing"></span>' +
        '<span class="chat-typing"><span></span><span></span><span></span></span>';
      thread.appendChild(row);
      thread.scrollTop = thread.scrollHeight;
    }
    function hideTyping() {
      const row = document.getElementById('chatTyping');
      if (row) row.remove();
    }

    async function ask(question: string) {
      if (starters) starters.remove();
      addUserMsg(question);
      input.disabled = true;
      sendBtn.disabled = true;
      // natural pacing: a short real "typing" beat scaled a little by
      // question length, not a flat identical delay every time
      const minDelay = 450 + Math.min(question.length * 4, 500);
      const start = Date.now();
      showTyping();

      let answer = "That's outside what I can answer from the real project data right now -- try the contact form for anything else.";
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ question }),
        });
        const data = await res.json().catch(() => ({ ok: false }));
        if (data && data.ok && data.answer) answer = data.answer;
      } catch {
        // network failure -- fall back message above already covers it
      }

      const elapsed = Date.now() - start;
      if (elapsed < minDelay) await new Promise((r) => setTimeout(r, minDelay - elapsed));
      hideTyping();
      addBotMsg(answer);
      input.disabled = false;
      sendBtn.disabled = false;
      input.focus();
    }

    document.querySelectorAll<HTMLButtonElement>('.chat-chip').forEach((chip) => {
      chip.addEventListener('click', () => ask(chip.dataset.q || chip.textContent || ''));
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const val = input.value.trim();
      if (!val) return;
      input.value = '';
      ask(val);
    });
  })();
</script>

<style>
  .chat-widget { position: relative; }

  .chat-trigger {
    position: fixed;
    right: var(--sp-5);
    bottom: var(--sp-5);
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--purple-bright);
    color: var(--bg);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 10px 28px -6px color-mix(in oklab, var(--purple-bright) 55%, transparent);
    z-index: 60;
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .chat-trigger:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -6px color-mix(in oklab, var(--purple-bright) 65%, transparent);
  }
  .chat-trigger:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 3px; }

  .chat-overlay {
    position: fixed; inset: 0;
    background: color-mix(in oklab, var(--bg) 55%, transparent);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
    z-index: 61;
  }
  .chat-overlay-open { opacity: 1; }

  .chat-panel {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: min(400px, 100vw);
    background: var(--surface-1);
    border-left: 1px solid var(--line-strong);
    box-shadow: -12px 0 40px color-mix(in oklab, #000 35%, transparent);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform var(--dur) var(--ease-out);
    z-index: 62;
  }
  .chat-panel-open { transform: translateX(0); }
  @media (prefers-reduced-motion: reduce) {
    .chat-panel, .chat-overlay { transition: none; }
  }

  .chat-head {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .chat-avatar { border-radius: 50%; flex-shrink: 0; }
  .chat-head-text { flex: 1; min-width: 0; }
  .chat-head-title { margin: 0; font-family: var(--font-display); font-size: var(--text-sm); color: var(--text); }
  .chat-head-status {
    margin: 2px 0 0; display: flex; align-items: center; gap: 6px;
    font-family: var(--font-mono); font-size: 10.5px; color: var(--muted);
  }
  .chat-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--green-live); flex-shrink: 0; }
  .chat-icon-btn {
    width: 32px; height: 32px; border-radius: var(--radius-sm);
    background: none; border: none; color: var(--muted); cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .chat-icon-btn:hover, .chat-icon-btn:focus-visible { color: var(--text); outline: none; }

  .chat-thread {
    flex: 1; overflow-y: auto;
    padding: var(--sp-4);
    display: flex; flex-direction: column; gap: var(--sp-4);
  }
  .chat-row { display: flex; gap: var(--sp-2); align-items: flex-start; }
  .chat-row-user { justify-content: flex-end; }
  .chat-avatar-sm { border-radius: 50%; flex-shrink: 0; margin-top: 2px; }
  .chat-avatar-typing { width: 24px; height: 24px; border-radius: 50%; background: var(--surface-3); flex-shrink: 0; }
  .chat-bubble {
    margin: 0; max-width: 82%;
    font-size: 13.5px; line-height: 1.55;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius);
  }
  .chat-bubble-bot { background: var(--surface-2); color: var(--text); border-bottom-left-radius: 4px; }
  .chat-bubble-user { background: var(--purple-bright); color: var(--bg); border-bottom-right-radius: 4px; }

  .chat-starters { display: flex; flex-direction: column; gap: var(--sp-2); margin-left: 32px; }
  .chat-chip {
    text-align: left;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: var(--sp-2) var(--sp-3);
    color: var(--text);
    font-size: 12.5px;
    cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .chat-chip:hover, .chat-chip:focus-visible { border-color: var(--purple-bright); outline: none; }

  .chat-typing { display: inline-flex; gap: 4px; align-items: center; padding: var(--sp-2) 0; }
  .chat-typing span {
    width: 5px; height: 5px; border-radius: 50%; background: var(--muted);
    animation: chat-typing-dot 1.1s ease-in-out infinite;
  }
  .chat-typing span:nth-child(2) { animation-delay: 0.15s; }
  .chat-typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes chat-typing-dot { 0%, 60%, 100% { opacity: 0.25; } 30% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .chat-typing span { animation: none; opacity: 0.7; } }

  .chat-inputrow {
    display: flex; gap: var(--sp-2); align-items: center;
    padding: var(--sp-3) var(--sp-4);
    border-top: 1px solid var(--line);
  }
  .chat-input {
    flex: 1;
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-pill);
    padding: var(--sp-2) var(--sp-4);
    color: var(--text);
    font-size: 13.5px;
    outline: none;
  }
  .chat-input:focus { border-color: var(--purple-bright); box-shadow: 0 0 0 3px color-mix(in oklab, var(--purple-bright) 25%, transparent); }
  .chat-input:disabled { opacity: 0.6; }
  .chat-send {
    width: 38px; height: 38px; flex-shrink: 0;
    background: var(--purple-bright); color: var(--bg);
    border: none; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer;
  }
  .chat-send:disabled { opacity: 0.6; cursor: default; }
  .chat-send:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 2px; }

  /* Below 900px there's no side-rail to dock beside, and the site's own
     nav becomes a hamburger toggle at the same breakpoint -- docking the
     panel below it the way desktop does would waste most of a small
     screen. Instead this is a real takeover (same pattern as Telegram/
     Instagram/WhatsApp's chat screens): the panel and its own header sit
     above the site nav entirely, rather than being hidden underneath it. */
  @media (max-width: 900px) {
    .chat-panel, .chat-overlay { z-index: 110; }
  }

  /* Tablet: slightly narrower drawer still reads comfortably */
  @media (max-width: 900px) and (min-width: 641px) {
    .chat-panel { width: min(360px, 100vw); }
  }

  /* Desktop: the side-rail (fixed, right:14px, 52px wide, full height) and
     the sticky top nav are real persistent chrome here, not page content --
     the trigger and panel must sit clear of both rather than overlap and
     fight them for clicks. (The rail is only ever shown at >=900px, so
     these rules mirror that exact breakpoint.) */
  @media (min-width: 900px) {
    .chat-trigger { right: 96px; }
    .chat-panel {
      top: var(--chat-nav-h, 84px);
      right: 66px;
      border-left: 1px solid var(--line-strong);
      box-shadow: -12px 0 32px color-mix(in oklab, #000 30%, transparent);
    }
  }

  /* Mobile: full-width takeover -- a 400px drawer on a 375px screen is
     unusable, and this is exactly the audience most likely to hit back
     instead of finding a close button, so the back-button handling above
     matters most here. */
  @media (max-width: 640px) {
    .chat-panel { width: 100vw; border-left: none; }
    .chat-trigger { right: var(--sp-4); bottom: var(--sp-4); }
    .chat-starters { margin-left: 0; }
  }
</style>
