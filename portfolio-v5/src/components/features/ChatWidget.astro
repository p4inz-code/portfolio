---
/**
 * Sitewide chat widget -- a floating trigger that opens a docked sidebar on
 * desktop and a full-screen takeover below 900px. Answers come from
 * functions/api/chat.ts: an FAQ table, then a cache, then a real Workers AI
 * call grounded in this site's own live llms.txt. Never fabricates -- if
 * the backend can't answer, it says so.
 *
 * Styles are global (scoped by .chat-widget) on purpose: message rows are
 * created by script, and Astro's per-component scoping attribute never
 * reaches script-created nodes, so scoped styles left every question and
 * answer completely unstyled.
 *
 * Back-button handling: opening pushes a history entry, so pressing back
 * (a very common instinct on mobile) closes the chat instead of leaving.
 */
import { SUGGESTIONS } from '../../data/chat-kb.ts';
const suggest = JSON.stringify(SUGGESTIONS.map((s) => s.q));
---
<div id="chatWidget" class="chat-widget" data-suggest={suggest}>
  <noscript><style>.chat-widget { display: none; }</style></noscript>

  <button
    type="button"
    id="chatTrigger"
    class="chat-trigger"
    aria-haspopup="dialog"
    aria-expanded="false"
    aria-controls="chatPanel"
    aria-label="Open chat"
    title="Ask about the work"
  >
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
  </button>

  <div id="chatOverlay" class="chat-overlay" hidden></div>

  <div id="chatPanel" class="chat-panel" role="dialog" aria-modal="true" aria-labelledby="chatTitle" tabindex="-1" hidden>
    <div class="chat-head">
      <img src="/ap-mark.png" alt="" class="chat-avatar" width="32" height="32" />
      <div class="chat-head-text">
        <p id="chatTitle" class="chat-head-title">Ask about the work</p>
        <p class="chat-head-status"><span class="chat-dot" aria-hidden="true"></span>Answers from what's shipped</p>
      </div>
      <button type="button" id="chatClear" class="chat-icon-btn" aria-label="Clear conversation" title="Clear conversation" hidden>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="3 6 5 6 21 6"></polyline>
          <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"></path>
          <path d="M10 11v6"></path><path d="M14 11v6"></path>
          <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"></path>
        </svg>
      </button>
      <button type="button" id="chatClose" class="chat-icon-btn" aria-label="Close chat">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <div id="chatThread" class="chat-thread" role="log" aria-live="polite" aria-relevant="additions" aria-label="Conversation">
      <div class="chat-row">
        <img src="/ap-mark.png" alt="" class="chat-avatar-sm" width="24" height="24" />
        <div class="chat-bubble chat-bubble-bot">Ask me anything about the real work. If I don't know, I'll say so instead of guessing.</div>
      </div>
    </div>

    <form id="chatForm" class="chat-inputrow" novalidate>
      <input
        id="chatInput"
        class="chat-input"
        type="text"
        placeholder="Ask a question"
        aria-label="Your question"
        autocomplete="off"
        autocapitalize="sentences"
        enterkeyhint="send"
        maxlength="500"
      />
      <button type="submit" id="chatSend" class="chat-send" aria-label="Send" disabled>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
        </svg>
      </button>
    </form>
  </div>
</div>

<script>
  (function () {
    const root = document.documentElement;
    const widget = document.getElementById('chatWidget');
    const trigger = document.getElementById('chatTrigger') as HTMLButtonElement | null;
    const overlay = document.getElementById('chatOverlay');
    const panel = document.getElementById('chatPanel');
    const closeBtn = document.getElementById('chatClose');
    const clearBtn = document.getElementById('chatClear');
    const thread = document.getElementById('chatThread');
    const form = document.getElementById('chatForm');
    const input = document.getElementById('chatInput') as HTMLInputElement | null;
    const sendBtn = document.getElementById('chatSend') as HTMLButtonElement | null;
    if (!widget || !trigger || !overlay || !panel || !closeBtn || !clearBtn || !thread || !form || !input || !sendBtn) return;

    // Only shown when the server itself can't be reached; the server always
    // answers otherwise, even with no AI configured.
    const FALLBACK = "I couldn't reach the assistant just now -- try again in a moment.";
    const RATE_LIMITED = "That's a lot of questions in a short time -- give it a few minutes, or reach out through the contact form.";
    const OFFLINE = "You look offline right now -- reconnect and ask again, or use the contact form.";
    // Starter chips come from the knowledge base (src/data/chat-kb.ts); the
    // tests guarantee every one resolves to a free answer.
    let POOL: string[] = ['What should I look at first?', 'Are you available for freelance work?', 'Which project is right for me?'];
    try {
      const fromKb = JSON.parse(widget.dataset.suggest || '[]');
      if (Array.isArray(fromKb) && fromKb.length) POOL = fromKb.filter((q) => typeof q === 'string');
    } catch { /* keep defaults */ }
    const STORE_KEY = 'ap-chat-v1';
    const MAX_STORED = 24;

    type Msg = { r: 'u' | 'b'; t: string; c?: boolean; f?: string[]; p?: string; i?: string };
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const coarse = window.matchMedia('(pointer: coarse)');
    const small = window.matchMedia('(max-width: 899px)');

    let open = false;
    let busy = false;
    let lastFocused: HTMLElement | null = null;
    // Bumped on every open/close so a stale scheduled hide can tell it has
    // been superseded by a reopen.
    let transitionGen = 0;
    let pendingBack = false;
    let prevOverflow = '';
    let scrollLocked = false;

    function loadMsgs(): Msg[] {
      try {
        const raw = sessionStorage.getItem(STORE_KEY);
        const parsed = raw ? JSON.parse(raw) : [];
        if (!Array.isArray(parsed)) return [];
        const valid = parsed
          .filter((m) => m && (m.r === 'u' || m.r === 'b') && typeof m.t === 'string')
          .slice(-MAX_STORED);
        // Trimming can cut a pair in half; never restore starting on an
        // answer whose question is gone.
        while (valid.length && valid[0].r === 'b') valid.shift();
        return valid;
      } catch {
        return [];
      }
    }
    function saveMsgs() {
      try { sessionStorage.setItem(STORE_KEY, JSON.stringify(msgs.slice(-MAX_STORED))); } catch { /* private mode */ }
    }
    let msgs: Msg[] = loadMsgs();

    // -- layout sync -------------------------------------------------------
    // Measured, not guessed: nav height can change with content or redesign.
    function syncChromeOffset() {
      const nav = document.querySelector('.nav');
      if (nav) root.style.setProperty('--chat-nav-h', nav.getBoundingClientRect().height + 'px');
    }
    syncChromeOffset();
    window.addEventListener('resize', syncChromeOffset);

    // On iOS the layout viewport doesn't shrink for the keyboard, so a
    // fixed bottom:0 input row ends up hidden behind it. Track the visual
    // viewport instead so the takeover always fits what's really visible.
    const vv = window.visualViewport;
    function syncViewport() {
      if (!vv) return;
      root.style.setProperty('--chat-vh', vv.height + 'px');
      root.style.setProperty('--chat-vt', vv.offsetTop + 'px');
    }
    if (vv) {
      vv.addEventListener('resize', syncViewport);
      vv.addEventListener('scroll', syncViewport);
    }

    function lockScroll() {
      if (!small.matches || scrollLocked) return;
      prevOverflow = root.style.overflow;
      root.style.overflow = 'hidden';
      scrollLocked = true;
    }
    function unlockScroll() {
      if (!scrollLocked) return;
      root.style.overflow = prevOverflow;
      scrollLocked = false;
    }

    // -- open / close ------------------------------------------------------
    function openChat() {
      if (open) return;
      open = true;
      transitionGen++;
      lastFocused = document.activeElement as HTMLElement;
      // Resting state is the visible one; a keyframe animation plays the
      // slide-in when it's un-hidden, so nothing can strand it off-screen.
      panel!.hidden = false;
      overlay!.hidden = false;
      panel!.dataset.state = 'open';
      overlay!.dataset.state = 'open';
      trigger!.setAttribute('aria-expanded', 'true');
      syncViewport();
      lockScroll();
      // Back button closes the chat instead of leaving the page.
      history.pushState({ chatOpen: true }, '');
      document.addEventListener('keydown', onKeydown);
      // Focusing the input on a phone would throw the keyboard up over the
      // conversation before anyone has read it -- only do that with a
      // physical keyboard.
      if (coarse.matches) panel!.focus({ preventScroll: true });
      else input!.focus();
      scrollDown(true);
    }

    function closeChat(fromPopstate?: boolean) {
      if (!open) return;
      open = false;
      const myGen = ++transitionGen;
      panel!.dataset.state = 'closing';
      overlay!.dataset.state = 'closing';
      // Really hide (display:none) after the slide-out. The timeout is the
      // guarantee -- animationend never fires under reduced motion -- and
      // the generation check lets a reopen win.
      window.setTimeout(() => {
        if (myGen !== transitionGen) return;
        panel!.hidden = true;
        overlay!.hidden = true;
        delete panel!.dataset.state;
        delete overlay!.dataset.state;
      }, 260);
      trigger!.setAttribute('aria-expanded', 'false');
      document.removeEventListener('keydown', onKeydown);
      unlockScroll();
      if (!fromPopstate && history.state && history.state.chatOpen) {
        // history.back() fires popstate asynchronously; remember it's ours
        // so a quick reopen isn't closed by that late event.
        pendingBack = true;
        history.back();
      }
      if (lastFocused && document.contains(lastFocused)) lastFocused.focus({ preventScroll: true });
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') { closeChat(); return; }
      if (e.key !== 'Tab') return;
      const focusables = Array.from(
        panel!.querySelectorAll<HTMLElement>('button, input, a[href]')
      ).filter((el) => !(el as HTMLButtonElement).disabled && !el.hidden && el.offsetParent !== null);
      if (focusables.length === 0) return;
      const first = focusables[0];
      const last = focusables[focusables.length - 1];
      const active = document.activeElement;
      if (e.shiftKey && (active === first || active === panel)) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && active === last) { e.preventDefault(); first.focus(); }
    }

    window.addEventListener('popstate', () => {
      if (pendingBack) { pendingBack = false; return; }
      if (open) closeChat(true);
    });

    trigger.addEventListener('click', () => { if (open) closeChat(); else openChat(); });
    closeBtn.addEventListener('click', () => closeChat());
    overlay.addEventListener('click', () => closeChat());

    // -- rendering ---------------------------------------------------------
    function el<K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string): HTMLElementTagNameMap[K] {
      const n = document.createElement(tag);
      if (cls) n.className = cls;
      return n;
    }
    function scrollDown(instant?: boolean) {
      thread!.scrollTo({ top: thread!.scrollHeight, behavior: instant || reduceMotion ? 'auto' : 'smooth' });
    }
    function avatarSm(): HTMLImageElement {
      const img = el('img', 'chat-avatar-sm');
      img.src = '/ap-mark.png';
      img.alt = '';
      img.width = 24;
      img.height = 24;
      return img;
    }
    function renderUser(text: string, animate: boolean) {
      const row = el('div', 'chat-row chat-row-user');
      row.dataset.dyn = '1';
      const bubble = el('div', 'chat-bubble chat-bubble-user');
      bubble.textContent = text;
      row.appendChild(bubble);
      if (!animate) row.dataset.still = '1';
      thread!.appendChild(row);
    }
    // URLs and the site's own paths become real links; everything is built
    // from text nodes, so answer text can never inject markup.
    const LINK_RE = /(https?:\/\/[^\s)]+|\/(?:work|contact|resume|about|services|3d|status|privacy|terms|support)\b\/?)/g;
    function appendRich(parent: HTMLElement, text: string) {
      let last = 0;
      for (const m of text.matchAll(LINK_RE)) {
        const idx = m.index ?? 0;
        if (idx > last) parent.appendChild(document.createTextNode(text.slice(last, idx)));
        const raw = m[0];
        const url = raw.replace(/[.,;:!?]+$/, '');
        const a = el('a', 'chat-autolink');
        a.href = url;
        a.textContent = url.replace(/^https?:\/\/(www\.)?/, '');
        if (url.startsWith('http')) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
        parent.appendChild(a);
        last = idx + url.length;
      }
      if (last < text.length) parent.appendChild(document.createTextNode(text.slice(last)));
    }
    function renderBody(bubble: HTMLElement, text: string) {
      let ul: HTMLUListElement | null = null;
      for (const line of text.split('\n')) {
        if (line.startsWith('- ')) {
          if (!ul) { ul = el('ul', 'chat-list'); bubble.appendChild(ul); }
          const li = el('li');
          appendRich(li, line.slice(2));
          ul.appendChild(li);
        } else if (line.trim()) {
          ul = null;
          const p = el('p', 'chat-lead');
          appendRich(p, line);
          bubble.appendChild(p);
        }
      }
    }
    function renderBot(text: string, contact: boolean | undefined, animate: boolean) {
      const row = el('div', 'chat-row');
      row.dataset.dyn = '1';
      const bubble = el('div', 'chat-bubble chat-bubble-bot');
      renderBody(bubble, text);
      if (contact) {
        const a = el('a', 'chat-link');
        a.href = '/contact';
        a.textContent = 'Ask through the contact form →';
        bubble.appendChild(a);
      }
      row.appendChild(avatarSm());
      row.appendChild(bubble);
      if (!animate) row.dataset.still = '1';
      thread!.appendChild(row);
      return row;
    }
    // A short answer is best read with the suggestions below it in view; a
    // long one should be read from its first line, not from its last.
    function revealAnswer(row: HTMLElement) {
      const t = thread!;
      if (row.offsetHeight > t.clientHeight * 0.55) {
        t.scrollTo({ top: Math.max(0, row.offsetTop - 12), behavior: reduceMotion ? 'auto' : 'smooth' });
      } else {
        scrollDown();
      }
    }
    function showTyping() {
      const row = el('div', 'chat-row');
      row.id = 'chatTyping';
      const dots = el('span', 'chat-typing');
      dots.innerHTML = '<span></span><span></span><span></span><span class="chat-sr">Typing</span>';
      row.appendChild(avatarSm());
      row.appendChild(dots);
      thread!.appendChild(row);
      scrollDown();
    }
    function hideTyping() {
      const row = document.getElementById('chatTyping');
      if (row) row.remove();
    }
    function clearSuggest() {
      const s = document.getElementById('chatSuggest');
      if (s) s.remove();
    }
    function renderSuggest(scroll = true, followups?: string[]) {
      clearSuggest();
      const asked = new Set(msgs.filter((m) => m.r === 'u').map((m) => m.t.toLowerCase()));
      const fresh = (list: string[]) => list.filter((q) => !asked.has(q.toLowerCase()));
      // Contextual follow-ups first (what a curious visitor asks next about
      // THIS topic), topped up from the general starters.
      const picks = [...fresh(followups ?? []), ...fresh(POOL)].filter((q, i, a) => a.indexOf(q) === i).slice(0, 3);
      if (picks.length === 0) return;
      const wrap = el('div', 'chat-suggest');
      wrap.id = 'chatSuggest';
      for (const q of picks) {
        const b = el('button', 'chat-chip');
        b.type = 'button';
        b.textContent = q;
        b.addEventListener('click', () => ask(q));
        wrap.appendChild(b);
      }
      thread!.appendChild(wrap);
      if (scroll) scrollDown();
    }
    function syncSend() {
      sendBtn!.disabled = busy || input!.value.trim().length === 0;
    }
    function setBusy(v: boolean) {
      busy = v;
      thread!.setAttribute('aria-busy', String(v));
      syncSend();
    }

    // -- asking ------------------------------------------------------------
    async function ask(question: string) {
      if (busy) return;
      setBusy(true);
      clearSuggest();
      msgs.push({ r: 'u', t: question });
      saveMsgs();
      clearBtn!.hidden = false;
      renderUser(question, true);
      scrollDown();

      // A short "typing" beat scaled a little by question length, layered
      // over the real fetch latency, so answers don't land instantly.
      const minDelay = 450 + Math.min(question.length * 4, 500);
      const start = Date.now();
      showTyping();

      // The project the last answer was about, so "and its license?" has something to lean on.
      const lastMsg = msgs.length >= 2 ? msgs[msgs.length - 2] : null;
      const topic = lastMsg && lastMsg.r === 'b' ? lastMsg.p : undefined;
      // Recent turns travel with the question so "how long did he take" / "more" make sense.
      const prior = msgs.slice(0, -1);
      const seen = prior.filter((m) => m.r === 'b' && m.i).slice(-6).map((m) => m.i as string);
      const history: { q: string; a: string }[] = [];
      for (let k = prior.length - 1; k >= 1 && history.length < 2; k--) {
        if (prior[k].r === 'b' && prior[k - 1].r === 'u') history.unshift({ q: prior[k - 1].t.slice(0, 200), a: prior[k].t.slice(0, 400) });
      }
      const payload: Record<string, unknown> = { question };
      if (topic) payload.context = topic;
      if (seen.length) payload.seen = seen;
      if (history.length) payload.history = history;
      let reply: { text: string; contact?: boolean; followups?: string[]; topic?: string; id?: string } = { text: FALLBACK, contact: true };
      const ctrl = new AbortController();
      // Without a timeout a hung AI call would leave the widget "thinking"
      // forever.
      const timer = window.setTimeout(() => ctrl.abort(), 15000);
      try {
        if (navigator.onLine === false) {
          reply = { text: OFFLINE, contact: true };
        } else {
          const res = await fetch('/api/chat', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify(payload),
            signal: ctrl.signal,
          });
          const data = await res.json().catch(() => ({ ok: false }));
          if (data && data.ok && data.answer) {
            reply = {
              text: data.answer,
              contact: !!data.contact,
              followups: Array.isArray(data.followups) ? data.followups.filter((q: unknown) => typeof q === 'string') : [],
              topic: typeof data.topic === 'string' ? data.topic : undefined,
              id: typeof data.id === 'string' ? data.id : undefined,
            };
          }
          else if (data && data.reason === 'rate_limited') reply = { text: RATE_LIMITED, contact: true };
        }
      } catch {
        if (navigator.onLine === false) reply = { text: OFFLINE, contact: true };
      } finally {
        window.clearTimeout(timer);
      }

      const elapsed = Date.now() - start;
      if (elapsed < minDelay) await new Promise((r) => setTimeout(r, minDelay - elapsed));
      hideTyping();
      msgs.push({ r: 'b', t: reply.text, c: reply.contact, f: reply.followups, p: reply.topic, i: reply.id });
      saveMsgs();
      const answerRow = renderBot(reply.text, reply.contact, true);
      setBusy(false);
      renderSuggest(false, reply.followups);
      revealAnswer(answerRow);
      if (open && !coarse.matches) input!.focus();
    }

    function clearConversation() {
      if (busy) return;
      msgs = [];
      saveMsgs();
      thread!.querySelectorAll('[data-dyn]').forEach((n) => n.remove());
      clearBtn!.hidden = true;
      renderSuggest();
      if (!coarse.matches) input!.focus();
    }
    clearBtn.addEventListener('click', clearConversation);

    // Other parts of the site (e.g. the About page) can hand the chat a question.
    window.addEventListener('ap-chat-ask', (e) => {
      const q = (e as CustomEvent).detail;
      if (typeof q !== 'string' || !q.trim()) return;
      if (!open) openChat();
      ask(q.trim());
    });

    input.addEventListener('input', syncSend);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (busy) return;
      const val = input!.value.trim();
      if (!val) return;
      input!.value = '';
      syncSend();
      ask(val);
    });

    // -- restore a previous conversation (pages are full reloads) ----------
    for (const m of msgs) {
      if (m.r === 'u') renderUser(m.t, false);
      else renderBot(m.t, m.c, false);
    }
    clearBtn.hidden = msgs.length === 0;
    const lastBot = [...msgs].reverse().find((m) => m.r === 'b');
    renderSuggest(true, lastBot?.f);
    syncSend();
  })();
</script>

<style is:global>
  .chat-widget [hidden] { display: none !important; }
  .chat-widget .chat-sr {
    position: absolute; width: 1px; height: 1px; overflow: hidden;
    clip: rect(0 0 0 0); white-space: nowrap;
  }

  /* -- trigger ------------------------------------------------------- */
  .chat-widget .chat-trigger {
    position: fixed;
    right: var(--sp-5);
    bottom: calc(var(--sp-5) + env(safe-area-inset-bottom, 0px));
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--purple-bright);
    color: var(--bg);
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
    box-shadow: 0 10px 28px -6px color-mix(in oklab, var(--purple-bright) 55%, transparent);
    z-index: 60;
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur-fast) var(--ease-out);
  }
  .chat-widget .chat-trigger:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 32px -6px color-mix(in oklab, var(--purple-bright) 65%, transparent);
  }
  .chat-widget .chat-trigger:active { transform: scale(0.96); }
  .chat-widget .chat-trigger:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 3px; }

  /* -- overlay + panel (resting state is the visible one; open/close are
        keyframe animations on top, so a missed frame can't strand it) --- */
  .chat-widget .chat-overlay {
    position: fixed; inset: 0;
    background: color-mix(in oklab, var(--bg) 55%, transparent);
    z-index: 61;
  }
  .chat-widget .chat-panel {
    position: fixed;
    top: 0; right: 0; bottom: 0;
    width: min(400px, 100vw);
    background: var(--surface-1);
    border-left: 1px solid var(--line-strong);
    box-shadow: -12px 0 40px color-mix(in oklab, #000 35%, transparent);
    display: flex;
    flex-direction: column;
    z-index: 62;
    outline: none;
  }
  .chat-widget .chat-panel[data-state='open'] { animation: chat-slide-in var(--dur) var(--ease-out) both; }
  .chat-widget .chat-panel[data-state='closing'] { animation: chat-slide-out 240ms var(--ease-in-out) forwards; }
  .chat-widget .chat-overlay[data-state='open'] { animation: chat-fade-in var(--dur) var(--ease-out) both; }
  .chat-widget .chat-overlay[data-state='closing'] { animation: chat-fade-out 240ms var(--ease-in-out) forwards; }

  @keyframes chat-slide-in { from { transform: translateX(calc(100% + 80px)); } to { transform: none; } }
  @keyframes chat-slide-out { from { transform: none; } to { transform: translateX(calc(100% + 80px)); } }
  @keyframes chat-fade-in { from { opacity: 0; } to { opacity: 1; } }
