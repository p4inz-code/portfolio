---
/**
 * ⌘K / Ctrl+K / "/" command palette — ported from v4.5 with light-theme awareness
 * and the new site data. Vanilla JS island, no framework.
 */
import { PROJECTS } from '../../data/projects';
import { NAV, CONTACT } from '../../data/site';

// Precompute the command list at build time so the JS island only carries the array.
const commands = [
  ...NAV.map((n) => ({ g: 'Pages', t: n.label, s: n.href, k: [n.label.toLowerCase()], act: `route:${n.href}` })),
  { g: 'Pages', t: 'Home', s: '/', k: ['home','main'], act: 'route:/' },
  { g: 'Pages', t: 'Status', s: '/status', k: ['changelog','build'], act: 'route:/status' },
  { g: 'Pages', t: 'Accessibility', s: '/accessibility', k: ['a11y','wcag'], act: 'route:/accessibility' },
  ...PROJECTS.filter((p) => !p.isExternal).map((p) => ({
    g: 'Case studies', t: p.name, s: `${p.href} · ${p.tagline}`, k: p.tags.map((t) => t.toLowerCase()), act: `route:${p.href}`,
  })),
  { g: 'Case studies', t: 'Mission OS · concept demo', s: '/mission-os/demo · try Mission OS in your browser', k: ['demo','os','desktop','boot'], act: 'route:/mission-os/demo' },
  ...PROJECTS.filter((p) => p.isExternal).map((p) => ({
    g: 'Projects on GitHub', t: p.name, s: p.href.replace('https://', ''), k: p.tags.map((t) => t.toLowerCase()), act: `ext:${p.href}`,
  })),
  { g: 'Actions', t: 'Email Atharva', s: CONTACT.email, k: ['mail','email','contact'], act: `ext:mailto:${CONTACT.email}` },
  { g: 'Actions', t: 'Join Nexus beta on Discord', s: CONTACT.discordInvite.replace('https://', ''), k: ['beta','discord','chat'], act: `ext:${CONTACT.discordInvite}` },
  { g: 'Actions', t: 'GitHub profile', s: CONTACT.githubHandle, k: ['github','profile'], act: `ext:${CONTACT.github}` },
];
---
<div class="cmdk-backdrop" id="cmdk" role="dialog" aria-modal="true" aria-label="Quick navigation" hidden>
  <div class="cmdk-panel">
    <div class="cmdk-input-row">
      <svg class="cmdk-search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
      </svg>
      <input
        class="cmdk-input"
        id="cmdkInput"
        type="search"
        name="cmdk-search-no-autofill"
        placeholder="Jump to a page, project, or action..."
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        spellcheck="false"
        data-form-type="other"
        data-lpignore="true"
        data-1p-ignore="true"
        aria-label="Search commands"
        aria-autocomplete="list"
        aria-controls="cmdkList"
      />
      <span class="cmdk-kbd">ESC</span>
    </div>
    <div class="cmdk-list" id="cmdkList" role="listbox" aria-label="Results"></div>
    <div class="cmdk-footer">
      <span><span class="cmdk-kbd">↑↓</span> navigate <span class="cmdk-kbd">↵</span> open</span>
      <span><span class="cmdk-kbd">⌘K</span> or <span class="cmdk-kbd">/</span> anywhere</span>
    </div>
  </div>
</div>

<style is:global>
  .cmdk-backdrop {
    position: fixed; inset: 0;
    background: var(--scrim);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 9999;
    opacity: 0; pointer-events: none;
    transition: opacity var(--dur) var(--ease-out);
    display: flex; align-items: flex-start; justify-content: center;
    padding: 15vh 20px 20px;
  }
  .cmdk-backdrop.open { opacity: 1; pointer-events: auto; }
  .cmdk-backdrop[hidden] { display: none; }
  .cmdk-panel {
    width: 100%; max-width: 640px;
    background: var(--surface-1);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    box-shadow:
      0 40px 100px color-mix(in oklab, var(--bg) 60%, transparent),
      0 0 60px color-mix(in oklab, var(--purple) 8%, transparent);
    overflow: hidden;
    transform: translateY(-12px) scale(0.98);
    transition: transform var(--dur) var(--ease-out);
  }
  .cmdk-backdrop.open .cmdk-panel { transform: translateY(0) scale(1); }
  .cmdk-input-row {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-5);
    border-bottom: 1px solid var(--line);
  }
  .cmdk-search-icon { width: 18px; height: 18px; color: var(--muted); flex-shrink: 0; }
  .cmdk-input {
    flex: 1;
    background: transparent; border: none; outline: none;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-md);
    padding: 2px 0;
  }
  .cmdk-input::placeholder { color: var(--muted-2); font-style: italic; }
  .cmdk-kbd {
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-mono);
    color: var(--muted-2);
    border: 1px solid var(--line);
    padding: 3px 8px;
    border-radius: 5px;
    background: color-mix(in oklab, var(--surface-2) 60%, transparent);
    white-space: nowrap;
  }
  .cmdk-list {
    max-height: 56vh; overflow-y: auto; padding: var(--sp-2) 0;
    scroll-behavior: smooth;
  }
  .cmdk-group-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted-2);
    padding: var(--sp-3) var(--sp-5) var(--sp-1);
  }
  .cmdk-item {
    display: flex; align-items: center; gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-5);
    cursor: pointer;
    color: var(--text);
    border-left: 2px solid transparent;
    transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
    user-select: none;
  }
  .cmdk-item[aria-selected='true'] {
    background: color-mix(in oklab, var(--purple) 10%, transparent);
    border-left-color: var(--purple-bright);
  }
  .cmdk-item-icon { width: 22px; height: 22px; color: var(--purple-bright); flex-shrink: 0; opacity: 0.85; }
  .cmdk-item-icon svg { width: 18px; height: 18px; }
  .cmdk-item-body { flex: 1; min-width: 0; }
  .cmdk-item-title { font-family: var(--font-display); font-size: var(--text-sm); }
  .cmdk-item-sub {
    font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-2);
    margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .cmdk-item-arrow {
    color: var(--muted-2); opacity: 0; font-family: var(--font-mono); font-size: 14px;
    transition: opacity var(--dur-fast) var(--ease-out);
  }
  .cmdk-item[aria-selected='true'] .cmdk-item-arrow { opacity: 1; color: var(--purple-bright); }
  .cmdk-footer {
    display: flex; justify-content: space-between; align-items: center;
    padding: var(--sp-3) var(--sp-5);
    border-top: 1px solid var(--line);
    background: color-mix(in oklab, var(--bg) 40%, transparent);
    font-family: var(--font-mono); font-size: 10.5px; color: var(--muted-2);
    flex-wrap: wrap; gap: var(--sp-4);
  }
  .cmdk-empty {
    padding: var(--sp-8) var(--sp-5); text-align: center; color: var(--muted);
    font-family: var(--font-display); font-style: italic;
  }
  @media (max-width: 640px) {
    .cmdk-backdrop { padding: 10vh 12px 12px; }
    .cmdk-input { font-size: 16px; }
  }
</style>

<script define:vars={{ commands }}>
  (function () {
    if (window.__cmdkBound) return;
    window.__cmdkBound = true;

    const backdrop = document.getElementById('cmdk');
    const input = document.getElementById('cmdkInput');
    const list = document.getElementById('cmdkList');
    if (!backdrop || !input || !list) return;

    let filtered = commands.slice();
    let selected = 0;
    let lastFocus = null;

    // width/height attributes are the belt-and-braces safety net: even if scoped
    // CSS ever misses these runtime-injected elements again, the SVG cannot render
    // at its intrinsic 300x150 fallback and blow up the palette. Bug: seen in v5.2
    // when Astro's scoped-styles didn't reach innerHTML-injected items.
    const routeIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>';
    const extIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9"/></svg>';

    function esc(str) {
      return String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function render() {
      if (!filtered.length) {
        list.innerHTML = '<div class="cmdk-empty">No matches. Try a different search.</div>';
        return;
      }
      let html = '';
      let lastGroup = '';
      filtered.forEach((cmd, i) => {
        if (cmd.g !== lastGroup) {
          html += '<div class="cmdk-group-label">' + esc(cmd.g) + '</div>';
          lastGroup = cmd.g;
        }
        const isExt = cmd.act.indexOf('ext:') === 0;
        html += '<div class="cmdk-item" role="option" aria-selected="' + (i === selected) + '" data-idx="' + i + '">' +
          '<div class="cmdk-item-icon">' + (isExt ? extIcon : routeIcon) + '</div>' +
          '<div class="cmdk-item-body">' +
          '<div class="cmdk-item-title">' + esc(cmd.t) + '</div>' +
          '<div class="cmdk-item-sub">' + esc(cmd.s) + '</div>' +
          '</div>' +
          '<span class="cmdk-item-arrow" aria-hidden="true">↵</span>' +
          '</div>';
      });
      list.innerHTML = html;
      const selEl = list.querySelector('[aria-selected="true"]');
      if (selEl && selEl.scrollIntoView) selEl.scrollIntoView({ block: 'nearest' });
    }

    function filter(q) {
      q = (q || '').trim().toLowerCase();
      if (!q) { filtered = commands.slice(); }
      else {
        const tokens = q.split(/\s+/);
        filtered = commands.filter((c) => {
          const hay = (c.t + ' ' + c.s + ' ' + (c.k || []).join(' ')).toLowerCase();
          return tokens.every((tok) => hay.indexOf(tok) !== -1);
        });
      }
      selected = 0;
      render();
    }

    function open() {
      lastFocus = document.activeElement;
      backdrop.hidden = false;
      requestAnimationFrame(() => backdrop.classList.add('open'));
      input.value = '';
      filter('');
      setTimeout(() => input.focus(), 40);
      document.documentElement.style.overflow = 'hidden';
    }
    function close() {
      backdrop.classList.remove('open');
      setTimeout(() => {
        backdrop.hidden = true;
        document.documentElement.style.overflow = '';
        if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (e) {} }
      }, 200);
    }
    function run(cmd) {
      close();
      const act = cmd.act;
      if (act.indexOf('route:') === 0) {
        window.location.href = act.slice(6);
      } else if (act.indexOf('ext:') === 0) {
        window.open(act.slice(4), '_blank', 'noopener');
      }
    }

    document.addEventListener('keydown', (e) => {
      const t = e.target;
      const typing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
      const isCmdK = (e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey);
      const isSlash = e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey && !typing;
      if (isCmdK || isSlash) {
        e.preventDefault();
        if (backdrop.hidden) open(); else close();
        return;
      }
      if (backdrop.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); return; }
      if (e.key === 'ArrowDown') { e.preventDefault(); selected = Math.min(filtered.length - 1, selected + 1); render(); return; }
      if (e.key === 'ArrowUp') { e.preventDefault(); selected = Math.max(0, selected - 1); render(); return; }
      if (e.key === 'Enter') { e.preventDefault(); if (filtered[selected]) run(filtered[selected]); return; }
    });

    input.addEventListener('input', () => filter(input.value));
    list.addEventListener('click', (e) => {
      const item = e.target.closest && e.target.closest('.cmdk-item');
      if (!item) return;
      const idx = parseInt(item.getAttribute('data-idx'), 10);
      if (!isNaN(idx) && filtered[idx]) run(filtered[idx]);
    });
    list.addEventListener('mousemove', (e) => {
      const item = e.target.closest && e.target.closest('.cmdk-item');
      if (!item) return;
      const idx = parseInt(item.getAttribute('data-idx'), 10);
      if (!isNaN(idx) && idx !== selected) { selected = idx; render(); }
    });
    backdrop.addEventListener('click', (e) => { if (e.target === backdrop) close(); });

    const trigger = document.getElementById('cmdkTrigger');
    if (trigger) trigger.addEventListener('click', () => { if (backdrop.hidden) open(); else close(); });
  })();
</script>
