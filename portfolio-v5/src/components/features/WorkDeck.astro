---
import type { Project } from '../../data/projects';
import StatusPill from '../ui/StatusPill.astro';

/**
 * /work: the featured projects as a deck of cards.
 *
 * The home page tells the same projects as pinned chapters (one stage, words
 * then picture). Here they are a different object: each project is a card
 * that sticks near the top of the screen and the next card slides over it, so
 * the previous one shrinks and dims into a stack. Inside a card, the oversized
 * index numeral fills as the card settles, the background moves with the scroll,
 * and the picture arrives its own way for each product (a scan wipe for Nexus,
 * a card dropped on the board for Kanvaz, a pixel wipe for Ascent). The picture
 * is never cropped: the frame takes the image's own ratio and is sized to fit.
 *
 * Wrapper height = 100vh, so a card's "being covered" phase is the last part
 * of its wrapper's cover range (50% to 96%). Native scroll timelines on
 * desktop; the JS progress engine (--p) everywhere else. Reversible, and
 * static under reduced motion.
 */
interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const num = (r: string) => { const [a, b] = r.split('/').map(Number); return a / b; };
---
<section class="deck" aria-label="Featured projects">
  {projects.map((p, i) => {
    const m = p.media;
    const last = i === projects.length - 1;
    return (
      <div class:list={['dwrap', last && 'is-last']} style={`--i:${i};--n:${projects.length}`} data-progress>
        <article class="dcard" data-scene={p.scene} data-slug={p.slug}>
          <div class="dcard-bg" aria-hidden="true"></div>
          <span class="dnum" aria-hidden="true" data-text={pad(i + 1)}>{pad(i + 1)}</span>

          <div class="dbody">
            <StatusPill status={p.status} size="sm" />
            <h2 class="dname"><a href={p.href} data-text={p.name}>{p.name}</a></h2>
            <p class="dtag"><em>{p.tagline}</em></p>
            <p class="ddesc">{p.description}</p>
            <a class="dcta" href={p.href}>
              Open case study<span class="fx-sr"> for {p.name}</span> <span aria-hidden="true">→</span>
            </a>
          </div>

          {m ? (
            <figure class="dmedia" data-kind={m.kind}>
              <div class="dframe" style={`aspect-ratio:${m.ratio};--rn:${num(m.ratio).toFixed(4)};`}>
                {m.video ? (
                  <video class="dimg" muted loop playsinline preload="none" poster={m.src} role="img" aria-label={m.alt} data-showcase-video>
                    <source src={m.video.webm} type="video/webm" />
                    <source src={m.video.mp4} type="video/mp4" />
                  </video>
                ) : (
                  <img class="dimg" src={m.src} alt={m.alt} width="1600" height="900" loading="lazy" decoding="async" />
                )}
              </div>
              {m.label && <figcaption class="dcap">{m.label}</figcaption>}
            </figure>
          ) : (
            <div class="dmedia dmedia-empty" aria-hidden="true">
              <span class="dempty-slug">{p.slug}</span>
              <span class="dempty-name">{p.name}</span>
            </div>
          )}

        </article>
      </div>
    );
  })}
</section>

<style>
  .deck { display: block; padding-top: var(--sp-4); }

  /* One wrapper per card. 100vh tall, so the card is "covered" during the
     last stretch of its own cover range. */
  .dwrap {
    --top: calc(84px + var(--i) * 14px);
    --card-h: min(calc(100vh - 84px - var(--n) * 14px - 28px), 680px);
    min-height: 100vh;
    min-height: 100svh;
    position: relative;
  }
  .dwrap.is-last { min-height: calc(var(--card-h) + 60px); }

  .dcard {
    position: sticky;
    top: var(--top);
    height: var(--card-h);
    min-height: 460px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    grid-template-rows: minmax(0, 1fr);
    gap: 0 var(--sp-7);
    padding: var(--sp-7) var(--sp-8);
    background: color-mix(in oklab, var(--surface-1) 88%, transparent);
    border: 1px solid var(--line-strong);
    border-radius: 22px;
    background: var(--surface-1);
    overflow: hidden;
    isolation: isolate;
    transform-origin: 50% 0%;
    box-shadow: 0 -24px 60px -30px rgba(0, 0, 0, 0.55);
  }

  /* Big index numeral: outlined, fills upward as the card settles. */
  .dnum {
    position: absolute;
    right: var(--sp-7); top: -0.12em;
    z-index: -1;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(100px, 13vw, 190px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in oklab, var(--purple-bright) 45%, transparent);
    pointer-events: none;
    user-select: none;
  }
  .dnum::after {
    content: attr(data-text);
    position: absolute; left: 0; top: 0;
    color: color-mix(in oklab, var(--purple-bright) 16%, transparent);
    -webkit-text-stroke: 0;
    clip-path: inset(calc((1 - var(--nf, 1)) * 100%) 0 0 0);
  }

  .dbody {
    align-self: center;
    display: flex; flex-direction: column; gap: var(--sp-4);
    min-width: 0;
  }
  .dname {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4.4vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.025em;
    margin: 0;
  }
  .dname a { color: var(--text); text-decoration: none; }
  .dtag { color: var(--purple-bright); font-family: var(--font-display); font-size: var(--text-lg); font-weight: 400; margin: 0; }
  .dtag em { font-style: italic; }
  .ddesc {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
    max-width: 480px;
    display: -webkit-box; -webkit-line-clamp: 6; -webkit-box-orient: vertical; overflow: hidden;
    margin: 0;
  }
  .dcta {
    align-self: flex-start;
    display: inline-flex; gap: 8px;
    padding: 10px 18px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), gap var(--dur-fast) var(--ease-out);
  }
  .dcta:hover, .dcta:focus-visible {
    background: color-mix(in oklab, var(--purple) 14%, transparent);
    border-color: var(--purple-bright);
    gap: 14px;
    outline: none;
  }

  .dmedia { margin: 0; align-self: center; min-width: 0; }
  .dframe {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--surface-2);
    /* the image's own ratio, capped by the card height: fit, never crop */
    width: min(100%, calc((var(--card-h) - 190px) * var(--rn, 1.6)));
    margin-inline: auto;
  }
  .dimg { display: block; width: 100%; height: 100%; object-fit: contain; }
  .dcap {
    margin-top: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .dmedia-empty {
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: linear-gradient(135deg, color-mix(in oklab, var(--purple-deep) 40%, transparent), color-mix(in oklab, var(--surface-2) 90%, transparent));
    min-height: 220px;
  }
  .dempty-slug { font-family: var(--font-mono); font-size: 10px; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted); }
  .dempty-name { font-family: var(--font-display); font-size: clamp(28px, 3vw, 42px); color: var(--text); letter-spacing: -0.02em; }

  /* ------------------------------------------------------------ scenes */
  .dcard-bg { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .dcard[data-scene='nexus'] .dcard-bg {
    background-image:
      linear-gradient(color-mix(in oklab, var(--purple-bright) 8%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in oklab, var(--purple-bright) 8%, transparent) 1px, transparent 1px);
    background-size: 44px 44px;
    -webkit-mask-image: radial-gradient(ellipse 80% 90% at 85% 40%, #000, transparent 75%);
            mask-image: radial-gradient(ellipse 80% 90% at 85% 40%, #000, transparent 75%);
  }
  .dcard[data-scene='kanvaz'] .dcard-bg {
    background-image: radial-gradient(color-mix(in oklab, var(--text) 20%, transparent) 1.1px, transparent 1.4px);
    background-size: 22px 22px;
  }
  .dcard[data-scene='ascent'] .dcard-bg {
    background:
      radial-gradient(circle 9vmin at 82% 22%, color-mix(in oklab, var(--text) 14%, transparent), transparent 70%),
      linear-gradient(to bottom, transparent 30%, color-mix(in oklab, var(--purple-deep) 45%, transparent));
  }
  .dcard[data-scene='nexus'] .dname  { font-family: var(--font-scene-nexus); font-weight: 500; letter-spacing: -0.01em; }
  .dcard[data-scene='kanvaz'] .dname { font-family: var(--font-scene-kanvaz); font-weight: 700; letter-spacing: 0; font-size: clamp(38px, 4.8vw, 66px); }
  .dcard[data-scene='ascent'] .dname { font-family: var(--font-scene-ascent); font-weight: 400; letter-spacing: 0.01em; line-height: 1; font-size: clamp(44px, 5.6vw, 78px); }
  .dcard[data-scene='kanvaz'] .dframe { border-radius: 8px; box-shadow: 0 18px 36px -22px rgba(0, 0, 0, 0.6); rotate: -1deg; }
  .dcard[data-scene='ascent'] { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr); }
  .dcard[data-scene='ascent'] .dframe { border-radius: 5px; box-shadow: 0 24px 60px -28px color-mix(in oklab, var(--purple-bright) 70%, transparent); }
  /* colour grade: violet shadows, a little more punch, one recipe per theme */
  .dcard[data-scene='ascent'] .dimg { filter: saturate(1.2) contrast(1.06); }
  .dcard[data-scene='ascent'] .dframe::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: radial-gradient(120% 100% at 50% 40%, transparent 55%, rgba(12, 4, 40, 0.42)), linear-gradient(180deg, rgba(139, 92, 246, 0.2), rgba(20, 8, 60, 0.26));
    mix-blend-mode: soft-light;
  }
  :global(:root[data-theme='light']) .dcard[data-scene='ascent'] .dimg { filter: saturate(1.08) brightness(1.08) contrast(1.02); }
  :global(:root[data-theme='light']) .dcard[data-scene='ascent'] .dframe::after {
    background: radial-gradient(120% 100% at 50% 40%, transparent 60%, rgba(91, 33, 182, 0.26)), linear-gradient(180deg, rgba(196, 181, 253, 0.4), rgba(255, 255, 255, 0.14));
  }
  /* nexus: a scan line that travels with the wipe */
  .dcard[data-scene='nexus'] .dframe::after {
    content: ''; position: absolute; top: 0; bottom: 0; left: 100%; width: 1px; z-index: 1; pointer-events: none;
    background: var(--purple-bright);
    box-shadow: 0 0 14px 1px color-mix(in oklab, var(--purple-bright) 70%, transparent);
    opacity: 0;
  }
  /* ascent: stars that drift with the scroll */
  .dcard[data-scene='ascent'] .dcard-bg::before {
    content: ''; position: absolute; inset: -60px;
    background-image:
      radial-gradient(1.4px 1.4px at 12% 22%, #fff, transparent),
      radial-gradient(1px 1px at 38% 64%, #fff, transparent),
      radial-gradient(1.6px 1.6px at 61% 18%, #fff, transparent),
      radial-gradient(1px 1px at 77% 52%, #fff, transparent),
      radial-gradient(1.2px 1.2px at 90% 84%, #fff, transparent),
      radial-gradient(1px 1px at 24% 88%, #fff, transparent);
    background-size: 220px 190px;
    opacity: 0.55;
  }
  :global(:root[data-theme='light']) .dcard[data-scene='ascent'] .dcard-bg::before { filter: invert(1) hue-rotate(230deg) saturate(3); opacity: 0.35; }
  /* the card that has no picture yet (Mission OS, Pursue OS) gets a live backdrop too */
  .dcard[data-scene='mission'] .dcard-bg, .dcard[data-slug='mission-os'] .dcard-bg {
    background-image: repeating-linear-gradient(0deg, color-mix(in oklab, var(--purple-bright) 9%, transparent) 0 1px, transparent 1px 7px);
  }
  .dcard[data-slug='pursue-os'] .dcard-bg {
    background-image: radial-gradient(color-mix(in oklab, #14b8a6 30%, transparent) 1.3px, transparent 1.6px);
    background-size: 26px 26px;
  }
  :global(:root[data-theme='light']) .dcard[data-scene='ascent'] .dcard-bg {
    background: radial-gradient(circle 9vmin at 82% 22%, color-mix(in oklab, var(--purple-bright) 16%, transparent), transparent 70%), linear-gradient(to bottom, transparent 30%, color-mix(in oklab, var(--purple) 16%, transparent));
  }

  /* ------------------------------------------------- tablets and phones */
  @media (max-width: 900px) {
    .dwrap { --top: calc(72px + var(--i) * 10px); min-height: 0; padding-bottom: 22vh; }
    .dwrap.is-last { padding-bottom: 0; min-height: 0; }
    .dcard {
      height: auto; min-height: 0;
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      padding: var(--sp-5);
      gap: var(--sp-4);
    }
    .dmedia { order: -1; padding-bottom: 0; }
    .dframe { width: 100%; }
    .dcard[data-scene='ascent'] { grid-template-columns: 1fr; }
    .dbody { padding-bottom: var(--sp-4); }
    .ddesc { -webkit-line-clamp: 3; }
    .dnum { font-size: clamp(90px, 30vw, 160px); right: var(--sp-4); }
    .dmedia-empty { min-height: 120px; margin-bottom: 0; }
  }

  /* ----------------------------------------- native scroll timelines (desktop) */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .dwrap { view-timeline: --dw block; }
      /* covered by the next card: shrink and dim (not the last one) */
      .dwrap:not(.is-last) .dcard {
        animation: dcard-back var(--ease-io, ease-in-out) both;
        animation-timeline: --dw;
        animation-range: cover 50% cover 96%;
      }
      .dnum::after {
        animation: dnum-fill linear both;
        animation-timeline: --dw;
        animation-range: cover 6% cover 40%;
      }
      /* live backgrounds: they move with the scroll, so they reverse with it */
      .dcard-bg {
        animation: dbg-pan linear both;
        animation-timeline: --dw;
        animation-range: cover 0% cover 100%;
      }
      .dcard[data-scene='ascent'] .dcard-bg { animation: none; }
      .dcard[data-scene='ascent'] .dcard-bg::before {
        animation: dstars linear both;
        animation-timeline: --dw;
        animation-range: cover 0% cover 100%;
      }
      /* each product's picture arrives its own way, as the card settles */
      .dframe, .dmedia-empty {
        animation: dfr-default var(--ease-out) both;
        animation-timeline: --dw;
        animation-range: cover 4% cover 26%;
      }
      .dcard[data-scene='nexus'] .dframe { animation-name: dfr-nexus; animation-timing-function: var(--ease-io, ease-in-out); }
      .dcard[data-scene='nexus'] .dframe::after {
        animation: dscan var(--ease-io, ease-in-out) both;
        animation-timeline: --dw;
        animation-range: cover 4% cover 26%;
      }
      .dcard[data-scene='kanvaz'] .dframe { animation-name: dfr-kanvaz; animation-range: cover 4% cover 30%; }
      .dcard[data-scene='ascent'] .dframe { animation-name: dfr-ascent; animation-timing-function: steps(12, end); }
      .dbody > * {
        animation: dbody-in var(--ease-out) both;
        animation-timeline: --dw;
        animation-range: cover calc(8% + var(--k, 0) * 2%) cover calc(28% + var(--k, 0) * 2%);
      }
      .dbody > *:nth-child(2) { --k: 1; }
      .dbody > *:nth-child(3) { --k: 2; }
      .dbody > *:nth-child(4) { --k: 3; }
      .dbody > *:nth-child(5) { --k: 4; }
    }
  }
  @keyframes dcard-back { to { transform: scale(0.93); filter: brightness(0.6); } }
  @keyframes dnum-fill  { from { clip-path: inset(100% 0 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes dbg-pan { from { background-position: 0 0, 0 0; } to { background-position: -132px 88px, -132px 88px; } }
  @keyframes dstars { from { translate: 0 0; } to { translate: -50px 60px; } }
  @keyframes dfr-default { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
  @keyframes dfr-nexus { from { clip-path: inset(0 100% 0 0); transform: scale(1.03); } to { clip-path: inset(0 0 0 0); transform: none; } }
  @keyframes dscan { 0% { left: 0; opacity: 0; } 6% { opacity: 1; } 94% { opacity: 1; } 100% { left: 100%; opacity: 0; } }
  @keyframes dfr-kanvaz { from { opacity: 0; transform: translateY(-90px) rotate(-7deg) scale(1.04); } 35% { opacity: 1; } to { opacity: 1; transform: none; } }
  @keyframes dfr-ascent { from { clip-path: inset(0 0 100% 0); filter: brightness(0.4); } to { clip-path: inset(0 0 0 0); filter: brightness(1); } }
  @keyframes dbody-in { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }

  /* --------------------- JS progress mode: phones, Firefox, older iOS Safari */
  :global(html[data-jsp]) .dwrap {
    --p: 0.5;
    --s: clamp(0, calc((var(--p) - 0.5) / 0.46), 1);      /* being covered */
    --nf: clamp(0, calc((var(--p) - 0.06) / 0.34), 1);    /* numeral fill */
    --fr: clamp(0, calc((var(--p) - 0.04) / 0.24), 1);    /* picture arrival */
  }
  :global(html[data-jsp]) .dwrap:not(.is-last) .dcard {
    transform: scale(calc(1 - var(--s) * 0.06));
    filter: brightness(calc(1 - var(--s) * 0.4));
  }
  :global(html[data-jsp]) .dbody > * {
    --bt: clamp(0, calc((var(--p) - 0.08 - var(--k, 0) * 0.02) / 0.2), 1);
    opacity: var(--bt);
    transform: translateY(calc((1 - var(--bt)) * 24px));
  }
  :global(html[data-jsp]) .dbody > *:nth-child(2) { --k: 1; }
  :global(html[data-jsp]) .dbody > *:nth-child(3) { --k: 2; }
  :global(html[data-jsp]) .dbody > *:nth-child(4) { --k: 3; }
  :global(html[data-jsp]) .dbody > *:nth-child(5) { --k: 4; }
  :global(html[data-jsp]) .dcard-bg { background-position: calc(var(--p) * -132px) calc(var(--p) * 88px); }
  :global(html[data-jsp]) .dcard[data-scene='ascent'] .dcard-bg { background-position: 0 0; }
  :global(html[data-jsp]) .dcard[data-scene='ascent'] .dcard-bg::before { translate: calc(var(--p) * -50px) calc(var(--p) * 60px); }
  :global(html[data-jsp]) .dframe, :global(html[data-jsp]) .dmedia-empty { opacity: var(--fr); transform: translateY(calc((1 - var(--fr)) * 26px)); }
  :global(html[data-jsp]) .dcard[data-scene='nexus'] .dframe { opacity: 1; transform: none; clip-path: inset(0 calc((1 - var(--fr)) * 100%) 0 0); }
  :global(html[data-jsp]) .dcard[data-scene='nexus'] .dframe::after { left: calc(var(--fr) * 100%); opacity: calc(clamp(0, var(--fr) * 20, 1) * clamp(0, (1 - var(--fr)) * 20, 1)); }
  :global(html[data-jsp]) .dcard[data-scene='kanvaz'] .dframe { opacity: var(--fr); transform: translateY(calc((1 - var(--fr)) * -70px)) rotate(calc((1 - var(--fr)) * -6deg)); }
  :global(html[data-jsp]) .dcard[data-scene='ascent'] .dframe { opacity: 1; transform: none; clip-path: inset(0 0 calc((1 - var(--fr)) * 100%) 0); }
</style>
