---
/**
 * Screenshot frame — consistent framing for product captures across case studies.
 *
 * Every image gets:
 *  - fixed aspect-ratio container (default 16:10) so the grid stays rhythmic
 *  - object-fit:contain so nothing gets cropped, regardless of source aspect
 *  - a soft, blurred shadow instead of a hard border line, rounded corners
 *  - dark surface background so letterboxing looks intentional in dark theme,
 *    parchment surface in light theme (both handled by --surface-2 token)
 *  - monospace caption underneath, styled like the rest of the site
 *  - native lazy-loading (loading="lazy") + width/height hints to reserve
 *    space and keep CLS ~0
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  aspect?: string;   // e.g. "16 / 10", "4 / 3", "3 / 4"
  span?: 'full' | 'half' | 'third';
  width?: number;    // intrinsic width for CLS hint
  height?: number;
}
const {
  src,
  alt,
  caption,
  aspect = '16 / 10',
  span = 'half',
  width = 1600,
  height = 1000,
} = Astro.props;
---
<figure class:list={['shot', `span-${span}`]}>
  <div class="frame" style={`--frame-aspect:${aspect};`}>
    <img src={src} alt={alt} loading="lazy" decoding="async" width={width} height={height} />
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    min-width: 0;
  }
  .span-full  { grid-column: 1 / -1; }
  .span-half  { grid-column: span 6; }
  .span-third { grid-column: span 4; }
  @media (max-width: 900px) {
    .span-half, .span-third { grid-column: 1 / -1; }
  }
  .frame {
    position: relative;
    width: 100%;
    aspect-ratio: var(--frame-aspect);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    overflow: hidden;
    box-shadow: 0 12px 32px color-mix(in oklab, var(--bg) 45%, transparent);
    transition:
      transform var(--dur) var(--ease-out),
      box-shadow var(--dur) var(--ease-out);
  }
  .shot:hover .frame {
    transform: translateY(-2px);
    box-shadow: 0 20px 50px color-mix(in oklab, var(--bg) 60%, transparent);
  }
  .frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    display: block;
  }
  figcaption {
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-mono);
    text-transform: uppercase;
    color: var(--muted-2);
    padding: 0 var(--sp-1);
  }
</style>
