  @keyframes ridge-near { from { transform: translate(-9vw, 0);  } to { transform: translate(9vw, 16vh); } }
  @keyframes m-in {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: none; }
  }
