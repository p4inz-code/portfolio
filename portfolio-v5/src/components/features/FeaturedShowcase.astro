      }
      .chapter[data-scene='ascent'] .stars.s2 {
        animation-name: stars-mid;
      }
      .chapter[data-scene='ascent'] .stars.s3 {
        animation-name: stars-near, twinkle;
        animation-timeline: --ch, auto;
        animation-range: cover 0% cover 100%, normal;
        animation-duration: auto, 3.4s;
        animation-timing-function: linear, ease-in-out;
        animation-iteration-count: 1, infinite;
        animation-direction: normal, alternate;
        animation-fill-mode: both, none;
      }
      .chapter[data-scene='ascent'] .shoot.a {
        animation-name: shoot;
        animation-range: cover 24% cover 34%;
      }
      .chapter[data-scene='ascent'] .shoot.b {
        animation-name: shoot;
        animation-range: cover 56% cover 66%;
      }
      .chapter[data-scene='ascent'] .moon {
        animation-name: moon-rise;
        animation-range: cover 4% cover 100%;
        animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1);
      }
      .chapter[data-scene='ascent'] .ridge.far {
        animation-name: ridge-far;
      }
      .chapter[data-scene='ascent'] .ridge.mid {
        animation-name: ridge-mid;
      }
      .chapter[data-scene='ascent'] .ridge.near {
        animation-name: ridge-near;
      }

      /* -------- nexus: clean wipe with a scan line -------- */
      .chapter[data-scene='nexus'] .show-img {
        animation-name: reveal-nexus;
        animation-timing-function: var(--ease-io);
      }
      .chapter[data-scene='nexus'] .media-frame::after {
        /* scan line that travels with the wipe, same easing so they stay locked */
        content: '';
        position: absolute;
        top: 0; bottom: 0;
        width: 1px;
        left: 0;
        background: var(--purple-bright);
        box-shadow: 0 0 14px 1px color-mix(in oklab, var(--purple-bright) 70%, transparent);
        pointer-events: none;
        animation: nexus-scan var(--ease-io) both;
        animation-timeline: --ch;
        animation-range: cover 33% cover 53%;
      }

      /* -------- kanvaz: line first, then the card is dropped on -------- */
      .chapter[data-scene='kanvaz'] .media-frame { transform: rotate(-1.2deg); }
      .chapter[data-scene='kanvaz'] .show-img {
        animation-name: reveal-kanvaz;
        animation-timing-function: var(--ease-settle);
        animation-range: cover 35% cover 52%;
      }
      .chapter[data-scene='kanvaz'] .pin {
        display: block;
        position: absolute;
        top: -7px; left: 50%;
        width: 13px; height: 13px;
        margin-left: -6px;
        border-radius: 50%;
        background: var(--purple-bright);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.45);
        animation: ch-pop var(--ease-settle) both;
        animation-timeline: --ch;
        animation-range: cover 50% cover 54%;
      }
      .chapter[data-scene='kanvaz'] .cable {
        display: block;
        position: absolute;
        left: 42.5%; top: 50%;
        width: 8%; min-width: 56px; height: 40px;
        margin-top: -20px;
        overflow: visible;
        pointer-events: none;
        fill: var(--purple-bright);
      }
      .chapter[data-scene='kanvaz'] .cable path {
        fill: none;
        stroke: var(--purple-bright);
        stroke-width: 1.5;
        stroke-dasharray: 1;
        animation: cable-draw var(--ease-io) both;
        animation-timeline: --ch;
        animation-range: cover 29% cover 37%;
      }
      .chapter[data-scene='kanvaz'] .cable circle {
        animation: ch-pop var(--ease-settle) both;
        animation-timeline: --ch;
        animation-range: cover 29% cover 33%;
      }

      /* -------- ascent: letterbox opens, lights come up, camera pulls back -------- */
      .chapter[data-scene='ascent'] .show-img {
        animation-name: reveal-ascent;
        animation-timing-function: var(--ease-io);
      }
    }
  }

  /* ---------------------------------------------------------------
     JS progress mode: phones, Firefox, iOS without scroll timelines.
     --p (0..1) is written by src/scripts/progress.ts using the same
     "cover" mapping as the CSS timelines, so the beats are the same as
     on desktop, on stacked cards, and they reverse with the scroll.
       words arrive  ~ 6%..30%     title fills 20%..48%     media 26%..52%
     --------------------------------------------------------------- */
  :global(html[data-jsp]) .chapter {
    --p: 0.4;
    --f: clamp(0, calc((var(--p) - 0.20) / 0.28), 1);
    --m: clamp(0, calc((var(--p) - 0.26) / 0.26), 1);
    --mi: calc(1 - var(--m));
    --pp: clamp(0, var(--p), 1);
  }
  :global(html[data-jsp]) .show-body > * {
    --t: clamp(0, calc((var(--p) - 0.06 - var(--k) * 0.022) / 0.16), 1);
    opacity: var(--t);
    transform: translateY(calc((1 - var(--t)) * 26px));
  }
  :global(html[data-jsp]) .show-name {
    position: relative;
    display: block;
    width: fit-content;
    color: transparent;
    -webkit-text-stroke: 1.25px var(--purple-bright);
  }
  :global(html[data-jsp]) .show-name::after {
    content: attr(data-text);
    position: absolute;
    left: 0; top: 0;
    width: 100%;
    color: var(--purple-bright);
    -webkit-text-stroke: 0;
    clip-path: inset(0 calc((1 - var(--f)) * 100%) 0 0);
    pointer-events: none;
  }

  /* media, default: rise and unmask */
  :global(html[data-jsp]) .chapter.has-media .show-img {
    opacity: clamp(0, calc(var(--m) * 3), 1);
    transform: translateY(calc(var(--mi) * 30px));
    clip-path: inset(0 0 calc(var(--mi) * 40%) 0);
  }
  :global(html[data-jsp]) .show-media-tag { opacity: clamp(0, calc((var(--m) - 0.7) * 4), 1); }
  :global(html[data-jsp]) .chapter.no-media .show-visual {
    opacity: clamp(0, calc(var(--m) * 2.5), 1);
    transform: translateY(calc(var(--mi) * 24px));
  }

  /* nexus: wipe with a scan line */
  :global(html[data-jsp]) .chapter[data-scene='nexus'] .show-img {
    opacity: 1;
    clip-path: inset(0 calc(var(--mi) * 100%) 0 0);
    transform: scale(calc(1 + var(--mi) * 0.035));
  }
  :global(html[data-jsp]) .chapter[data-scene='nexus'] .media-frame::after {
    content: '';
    position: absolute;
    top: 0; bottom: 0;
    left: calc(var(--m) * 100%);
    width: 1px;
    background: var(--purple-bright);
    box-shadow: 0 0 14px 1px color-mix(in oklab, var(--purple-bright) 70%, transparent);
    opacity: clamp(0, calc(min(var(--m), var(--mi)) * 8), 1);
    pointer-events: none;
  }

  /* kanvaz: the card is dropped onto the board */
  :global(html[data-jsp]) .chapter[data-scene='kanvaz'] .media-frame { transform: rotate(-1.2deg); }
  :global(html[data-jsp]) .chapter[data-scene='kanvaz'] .show-img {
    opacity: clamp(0, calc(var(--m) * 3), 1);
    clip-path: none;
    transform: translateY(calc(var(--mi) * -60px)) rotate(calc(var(--mi) * -6deg)) scale(calc(1 + var(--mi) * 0.05));
  }
  :global(html[data-jsp]) .chapter[data-scene='kanvaz'] .pin {
    display: block;
    position: absolute;
    top: -7px; left: 50%;
    width: 13px; height: 13px;
    margin-left: -6px;
    border-radius: 50%;
    background: var(--purple-bright);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.45);
    transform: scale(clamp(0, calc((var(--m) - 0.8) * 5), 1));
  }

  /* ascent: letterbox opens, lights come up, camera pulls back */
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .show-img {
    opacity: 1;
    clip-path: inset(calc(var(--mi) * 46%) 0 calc(var(--mi) * 46%) 0);
    filter: brightness(calc(0.3 + var(--m) * 0.7));
    transform: scale(calc(1 + var(--mi) * 0.07));
  }

  /* scene cards: on phones each scene chapter is a card with its backdrop inside */
  :global(html[data-jsp]) .chapter[data-scene] .stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-radius: 16px;
    border: 1px solid var(--line);
    margin: var(--sp-4) 0;
  }
  :global(html[data-jsp]) .chapter[data-scene] .stage-inner { padding: var(--sp-6) var(--sp-5); }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .stage-inner { padding-top: calc(var(--sp-8) + 36px); }
  :global(html[data-jsp]) .chapter[data-scene] .scene-bg {
    display: block;
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }
  :global(html[data-jsp]) .chapter[data-scene='nexus'] .scene-bg { background-position: 0 calc(var(--pp) * -48px); }
  :global(html[data-jsp]) .chapter[data-scene='kanvaz'] .scene-bg { background-position: 0 calc(var(--pp) * -36px); }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .scene-bg > * { position: absolute; }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .moon {
    top: 5%; right: 8%;
    width: 15vmin; height: 15vmin;
    transform: translate(0, calc(150% - var(--pp) * 210%)) scale(calc(1.15 - var(--pp) * 0.2));
  }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .stars.s1 { transform: translateY(calc(var(--pp) * 10px)); }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .stars.s2 { transform: translateY(calc(var(--pp) * 22px)); }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .stars.s3 { transform: translateY(calc(var(--pp) * 40px)); animation: twinkle 3.4s ease-in-out infinite alternate; }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .nebula { transform: translate(calc((var(--pp) - 0.5) * 8vw), calc((0.5 - var(--pp)) * 6vh)); }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .ridge.far  { transform: translate(calc((var(--pp) - 0.5) * 6vw),  calc(var(--pp) * 5vh)); height: 22%; }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .ridge.mid  { transform: translate(calc((0.5 - var(--pp)) * 10vw), calc(var(--pp) * 9vh)); height: 18%; }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .ridge.near { transform: translate(calc((var(--pp) - 0.5) * 16vw), calc(var(--pp) * 13vh)); height: 13%; }
  :global(html[data-jsp]) .chapter[data-scene='ascent'] .shoot { display: none; }
  @media (prefers-reduced-motion: reduce) {
