  /* You are climbing: distant things fall away slowly, near things quickly. */
  @keyframes stars-far  { from { transform: translateY(-2vh); } to { transform: translateY(3vh); } }
  @keyframes stars-mid  { from { transform: translateY(-4vh); } to { transform: translateY(7vh); } }
  @keyframes stars-near { from { transform: translateY(-6vh); } to { transform: translateY(12vh); } }
  @keyframes twinkle    { from { opacity: 0.35; } to { opacity: 1; } }
  @keyframes shoot {
    0%   { opacity: 0; transform: translate(0, 0); }
    12%  { opacity: 1; }
    100% { opacity: 0; transform: translate(34vw, 19vw); }
  }
  /* Moonrise: starts hidden behind the ridges, climbs fast, then drifts. */
  @keyframes moon-rise {
    0%   { transform: translate(6vw, 34vh) scale(1.15); }
    38%  { transform: translate(1vw, -6vh) scale(1); }
    100% { transform: translate(-7vw, -24vh) scale(0.92); }
