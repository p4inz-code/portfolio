---
import type { Project } from '../../data/projects';
import StatusPill from '../ui/StatusPill.astro';

/**
 * Featured work, one pinned chapter per project.
 *
 * Each chapter is a tall wrapper with a sticky 100svh stage inside. A named
 * view-timeline on the chapter drives two moments while the stage is pinned:
 *   1. the words arrive (status, name, tagline, description, meta, link);
 *   2. one more scroll later, the media is revealed.
 * The reveal is different per scene (nexus wipe, kanvaz drop, ascent
 * letterbox); projects with no scene use a plain fade-up.
 *
 * Range maths (so the numbers below are not magic): for a chapter of height
 * H and viewport height V, the `cover` range is V + H long and the stage is
 * pinned from V/(V+H) to H/(V+H).
 *   media chapter    H = 280vh  ->  pinned 26.3% .. 73.7%
 *   no-media chapter H = 180vh  ->  pinned 35.7% .. 64.3%
 *
 * Feel: arrivals ease out (fast start, soft landing), wipes ease in-out,
 * the Kanvaz card overshoots slightly and settles. Nothing is linear
 * except the small progress hairline.
 *
 * Static fallback (no animation-timeline, reduced motion, or < 900px):
 * normal stacked cards, everything visible, no pinning.
 */
interface Props {
  projects: Project[];
  headingLevel?: 'h2' | 'h3'; // h3 under a Section's own h2 (home), h2 under a page h1 (/work)
}
const { projects, headingLevel = 'h3' } = Astro.props;
const NameTag = headingLevel;
const defaultLabel = (kind: string) =>
  kind === 'banner' ? 'Banner art from the project README' : '';
---
<section class="showcase" aria-label="Featured projects showcase">
  {projects.map((p, i) => {
    const m = p.media;
    const pad = (n: number) => String(n).padStart(2, '0');
    return (
      <article
        class:list={['chapter', m ? 'has-media' : 'no-media']}
        data-scene={p.scene}
        data-slug={p.slug}
      >
        <div class="stage">
          <div class="scene-bg" aria-hidden="true"></div>
          <div class="ch-count" aria-hidden="true"><span>{pad(i + 1)} / {pad(projects.length)}</span><i></i></div>
          <div class="stage-inner">
            <a class="show-body" href={p.href}>
              <StatusPill status={p.status} size="sm" />
              <NameTag class="show-name">{p.name}</NameTag>
              <p class="show-tag"><em>{p.tagline}</em></p>
              <p class="show-desc">{p.description}</p>
              <ul class="show-meta" role="list">
                {p.metaTags.slice(0, 4).map((t) => <li>{t}</li>)}
              </ul>
              <span class="show-cta">
                Open case study
                <span aria-hidden="true" class="show-cta-arrow">→</span>
              </span>
            </a>

            {p.scene === 'kanvaz' && (
              <svg class="cable" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
                <path d="M4 24 C 45 24, 55 14, 96 14" pathLength="1" />
                <circle cx="4" cy="24" r="3" />
                <circle cx="96" cy="14" r="3" />
              </svg>
            )}

            {m ? (
              <figure class="show-visual has-media" data-kind={m.kind}>
                <div class="media-frame" style={`aspect-ratio:${m.ratio};`}>
                  {m.video ? (
                    <video
                      class="show-img"
                      muted
                      loop
                      playsinline
                      preload="none"
                      poster={m.src}
                      role="img"
                      aria-label={m.alt}
                      data-showcase-video
                    >
                      <source src={m.video.webm} type="video/webm" />
                      <source src={m.video.mp4} type="video/mp4" />
                    </video>
                  ) : (
                    <img
                      class="show-img"
                      src={m.src}
                      alt={m.alt}
                      width="1600"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  {p.scene === 'kanvaz' && <span class="pin" aria-hidden="true"></span>}
                </div>
                {(m.label || defaultLabel(m.kind)) && (
                  <figcaption class="show-media-tag">{m.label ?? defaultLabel(m.kind)}</figcaption>
                )}
              </figure>
            ) : (
              <aside class="show-visual" aria-hidden="true">
                <div class="show-visual-frame">
                  <span class="show-visual-slug">{p.slug}</span>
                  <span class="show-visual-name">{p.name}</span>
                  <span class="show-visual-role">{p.license || 'proprietary'}</span>
                </div>
              </aside>
            )}
          </div>
        </div>
      </article>
    );
  })}
</section>

<script>
  // Play the Ascent loop only while it is on screen; honour reduced motion.
  const vids = document.querySelectorAll<HTMLVideoElement>('video[data-showcase-video]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (vids.length && !reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        });
      },
      { threshold: 0.35 },
    );
    vids.forEach((v) => io.observe(v));
  }
</script>

<style>
  /* ---------------------------------------------------------------
     Base (static) layout: stacked, everything visible.
     --------------------------------------------------------------- */
  .showcase { display: flex; flex-direction: column; padding-top: var(--sp-6); }
  .chapter { position: relative; border-top: 1px solid var(--line); }
  .chapter:first-child { border-top: none; }
  .stage { position: relative; }
  .stage-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--sp-7);
    align-items: center;
    padding: var(--sp-8) 0;
  }
  .chapter:first-child .stage-inner { padding-top: 0; }
  @media (max-width: 900px) {
    .stage-inner { grid-template-columns: 1fr; gap: var(--sp-5); padding: var(--sp-6) 0; }
  }

  .scene-bg { display: none; }
  .ch-count { display: none; }
  .cable { display: none; }
  .pin { display: none; }

  /* Text */
  .show-body {
    display: flex; flex-direction: column;
    gap: var(--sp-4);
    color: var(--text);
    text-decoration: none;
    padding-right: var(--sp-4);
  }
  .show-name {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 52px);
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.025em;
    line-height: 1.02;
    margin-top: var(--sp-2);
  }
  .show-tag {
    color: var(--purple-bright);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
  }
  .show-tag em { font-style: italic; }
  .show-desc {
    color: var(--muted);
    font-size: var(--text-md);
    line-height: var(--leading-body);
    max-width: 540px;
  }
  .show-meta {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: 6px 8px;
    margin-top: var(--sp-2);
  }
  .show-meta li {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--muted);
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .show-cta {
    margin-top: var(--sp-4);
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--purple-bright);
    font-family: var(--font-display);
    font-size: var(--text-md);
    padding-bottom: 4px;
    border-bottom: 1px solid var(--purple-bright);
    align-self: flex-start;
    transition: gap var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  .show-body:hover .show-cta { gap: 14px; }
  .show-cta-arrow { transition: transform var(--dur) var(--ease-out); }
  .show-body:hover .show-cta-arrow { transform: translateX(4px); }
  .show-body:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 8px; border-radius: 2px; }

  /* Media */
  .show-visual.has-media { margin: 0; min-width: 0; }
  .media-frame { position: relative; width: 100%; }
  .show-img {
    display: block;
    width: 100%; height: 100%;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: var(--surface-2);
  }
  .show-media-tag {
    margin-top: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Placeholder frame (Mission OS, Pursue OS: no media yet) */
  .show-visual:not(.has-media) {
    display: flex; align-items: center; justify-content: center;
    background:
      linear-gradient(135deg, color-mix(in oklab, var(--purple-deep) 45%, transparent), color-mix(in oklab, var(--surface-2) 90%, transparent));
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    min-height: 320px;
    position: relative;
    overflow: hidden;
  }
  .show-visual:not(.has-media)::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, color-mix(in oklab, var(--purple-bright) 20%, transparent), transparent 50%),
      radial-gradient(circle at 80% 70%, color-mix(in oklab, var(--purple) 15%, transparent), transparent 55%);
    pointer-events: none;
  }
  .show-visual-frame {
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    position: relative; z-index: 1;
    padding: var(--sp-6);
    text-align: center;
  }
  .show-visual-slug {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .show-visual-name {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1;
    font-weight: 500;
  }
  .show-visual-role {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--purple-bright);
    padding: 3px 8px;
    border: 1px solid color-mix(in oklab, var(--purple-bright) 40%, transparent);
    border-radius: 2px;
    margin-top: 4px;
  }
  @media (max-width: 900px) {
    .show-visual:not(.has-media) { min-height: 200px; }
    .show-visual-name { font-size: clamp(24px, 5vw, 36px); }
  }

  /* ---------------------------------------------------------------
     Scenes: static look (no scroll needed). These are what you see on
     phones, with reduced motion, and in browsers without scroll timelines.
     --------------------------------------------------------------- */
  .chapter[data-scene='nexus'] .show-img { border-radius: 2px; border-color: color-mix(in oklab, var(--purple-bright) 35%, var(--line-strong)); }
  .chapter[data-scene='kanvaz'] .show-img {
    border-radius: 6px;
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.55);
  }
  .chapter[data-scene='ascent'] .show-img { border-radius: 2px; }

  /* ---------------------------------------------------------------
     Pinned mode: desktop, motion allowed, scroll timelines supported.
     --------------------------------------------------------------- */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .chapter {
        view-timeline: --ch block;
        border-top: none;
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
        --ease-io: cubic-bezier(0.65, 0, 0.35, 1);
        --ease-settle: cubic-bezier(0.34, 1.32, 0.64, 1);
      }
      .chapter.has-media { height: 280vh; }
      .chapter.no-media  { height: 180vh; }

      .stage {
        position: sticky;
        top: 0;
        height: 100vh;
        height: 100svh;
        display: flex;
        align-items: center;
        padding-top: 88px; /* sticky nav */
        box-sizing: border-box;
      }
      .stage-inner { width: 100%; padding: 0; }
      .chapter:first-child .stage-inner { padding-top: 0; }
      /* Media gets the wider column: the picture is the payoff. */
      .chapter.has-media .stage-inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--sp-8); }

      /* Chapter counter with a hairline that fills while the stage is pinned. */
      .ch-count {
        display: flex;
        align-items: center;
        gap: 10px;
        position: absolute;
        top: 96px; right: 0;
        font-family: var(--font-mono);
        font-size: var(--text-xxs);
        letter-spacing: var(--tracking-eyebrow);
        color: var(--muted);
        pointer-events: none;
      }
      .ch-count i {
        display: block;
        width: 44px; height: 1px;
        background: var(--purple-bright);
        transform-origin: 0 50%;
        animation: ch-progress linear both;
        animation-timeline: --ch;
      }
      .chapter.has-media .ch-count i { animation-range: cover 26% cover 74%; }
      .chapter.no-media  .ch-count i { animation-range: cover 36% cover 64%; }

      /* Leave: the stage lifts and dims as the next chapter arrives. */
      .chapter.has-media .stage-inner {
        animation: ch-leave var(--ease-io) both;
        animation-timeline: --ch;
        animation-range: cover 76% cover 96%;
      }
      .chapter.no-media .stage-inner {
        animation: ch-leave var(--ease-io) both;
        animation-timeline: --ch;
        animation-range: cover 66% cover 94%;
      }

      /* Arrive: words rise in, staggered along the scroll. */
      .show-body > * {
        animation: ch-rise var(--ease-out) both;
        animation-timeline: --ch;
        --k: 0;
        --t0: 27%;
        animation-range: cover calc(var(--t0) + var(--k) * 1.2%) cover calc(var(--t0) + 9% + var(--k) * 1.2%);
      }
      .chapter.no-media .show-body > * { --t0: 36%; }
      .show-body > *:nth-child(2) { --k: 1; }
      .show-body > *:nth-child(3) { --k: 2; }
      .show-body > *:nth-child(4) { --k: 3; }
      .show-body > *:nth-child(5) { --k: 4; }
      .show-body > *:nth-child(6) { --k: 5; }

      /* Reveal: the media, one scroll after the words. */
      .chapter.has-media .show-img {
        animation: reveal-default var(--ease-out) both;
        animation-timeline: --ch;
        animation-range: cover 42% cover 60%;
      }
      .chapter.has-media .show-media-tag {
        animation: ch-fade var(--ease-out) both;
        animation-timeline: --ch;
        animation-range: cover 56% cover 63%;
      }
      .chapter.no-media .show-visual {
        animation: reveal-default var(--ease-out) both;
        animation-timeline: --ch;
        animation-range: cover 44% cover 58%;
      }

      /* Backdrop: fades in with the words and drifts slower than the page,
         which gives the pinned stage a sense of depth. */
      .scene-bg {
        display: block;
        position: absolute;
        top: -8vh; bottom: -8vh;
        left: 50%;
        width: 100vw;
        margin-left: -50vw;
        pointer-events: none;
        z-index: -1;
        animation: bg-drift linear both;
        animation-timeline: --ch;
        animation-range: cover 10% cover 90%;
      }

      /* Scene backdrops (only drawn while pinned). */
      .chapter[data-scene='nexus'] .scene-bg {
        background-image:
          linear-gradient(color-mix(in oklab, var(--purple-bright) 9%, transparent) 1px, transparent 1px),
          linear-gradient(90deg, color-mix(in oklab, var(--purple-bright) 9%, transparent) 1px, transparent 1px);
        background-size: 72px 72px;
        -webkit-mask-image: radial-gradient(ellipse 60% 55% at 72% 50%, #000 0%, transparent 100%);
                mask-image: radial-gradient(ellipse 60% 55% at 72% 50%, #000 0%, transparent 100%);
      }
      .chapter[data-scene='kanvaz'] .scene-bg {
        background-image: radial-gradient(color-mix(in oklab, var(--text) 22%, transparent) 1.1px, transparent 1.4px);
        background-size: 28px 28px;
        -webkit-mask-image: radial-gradient(ellipse 75% 65% at 55% 50%, #000 0%, transparent 100%);
                mask-image: radial-gradient(ellipse 75% 65% at 55% 50%, #000 0%, transparent 100%);
      }
      .chapter[data-scene='ascent'] .scene-bg {
        background:
          radial-gradient(circle 16vmin at 82% 30%, color-mix(in oklab, var(--text) 16%, transparent), transparent 70%),
          linear-gradient(to top, color-mix(in oklab, var(--purple-deep) 55%, transparent), transparent 55%);
      }
      :global(:root[data-theme='light']) .chapter[data-scene='ascent'] .scene-bg {
        background:
          radial-gradient(circle 16vmin at 82% 30%, color-mix(in oklab, var(--purple-bright) 16%, transparent), transparent 70%),
          linear-gradient(to top, color-mix(in oklab, var(--purple) 22%, transparent), transparent 55%);
      }
      .chapter[data-scene='ascent'] .scene-bg::after {
        /* ridge line along the bottom */
        content: '';
        position: absolute;
        left: 0; right: 0; bottom: 8vh;
        height: 22vh;
        background: color-mix(in oklab, var(--purple-deep) 70%, var(--bg));
        clip-path: polygon(0 62%, 9% 38%, 17% 55%, 27% 24%, 38% 52%, 49% 30%, 60% 58%, 71% 20%, 82% 50%, 91% 34%, 100% 56%, 100% 100%, 0 100%);
        opacity: 0.65;
      }

      /* -------- nexus: clean wipe with a scan line -------- */
      .chapter[data-scene='nexus'] .show-img {
        animation-name: reveal-nexus;
        animation-timing-function: var(--ease-io);
      }
      .chapter[data-scene='nexus'] .media-frame::before {
        /* corner brackets, drawn outside the frame */
        content: '';
        position: absolute;
        inset: -9px;
        pointer-events: none;
        --b: color-mix(in oklab, var(--purple-bright) 75%, transparent);
        background:
          linear-gradient(var(--b), var(--b)) top left / 14px 1px no-repeat,
          linear-gradient(var(--b), var(--b)) top left / 1px 14px no-repeat,
          linear-gradient(var(--b), var(--b)) top right / 14px 1px no-repeat,
          linear-gradient(var(--b), var(--b)) top right / 1px 14px no-repeat,
          linear-gradient(var(--b), var(--b)) bottom left / 14px 1px no-repeat,
          linear-gradient(var(--b), var(--b)) bottom left / 1px 14px no-repeat,
          linear-gradient(var(--b), var(--b)) bottom right / 14px 1px no-repeat,
          linear-gradient(var(--b), var(--b)) bottom right / 1px 14px no-repeat;
        animation: brackets-in var(--ease-out) both;
        animation-timeline: --ch;
        animation-range: cover 40% cover 56%;
      }
      .chapter[data-scene='nexus'] .media-frame::after {
        /* scan line that travels with the wipe, same easing so they stay locked */
        content: '';
        position: absolute;
        top: 0; bottom: 0;
        width: 1px;
        left: 0;
        background: var(--purple-bright);
        box-shadow: 0 0 14px 1px color-mix(in oklab, var(--purple-bright) 70%, transparent);
        pointer-events: none;
        animation: nexus-scan var(--ease-io) both;
        animation-timeline: --ch;
        animation-range: cover 42% cover 60%;
      }

      /* -------- kanvaz: line first, then the card is dropped on -------- */
      .chapter[data-scene='kanvaz'] .media-frame { transform: rotate(-1.2deg); }
      .chapter[data-scene='kanvaz'] .show-img {
        animation-name: reveal-kanvaz;
        animation-timing-function: var(--ease-settle);
        animation-range: cover 47% cover 61%;
      }
      .chapter[data-scene='kanvaz'] .pin {
        display: block;
        position: absolute;
        top: -7px; left: 50%;
        width: 13px; height: 13px;
        margin-left: -6px;
        border-radius: 50%;
        background: var(--purple-bright);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.45);
        animation: ch-pop var(--ease-settle) both;
        animation-timeline: --ch;
        animation-range: cover 58% cover 63%;
      }
      .chapter[data-scene='kanvaz'] .cable {
        display: block;
        position: absolute;
        left: 42.5%; top: 50%;
        width: 8%; min-width: 56px; height: 40px;
        margin-top: -20px;
        overflow: visible;
        pointer-events: none;
        fill: var(--purple-bright);
      }
      .chapter[data-scene='kanvaz'] .cable path {
        fill: none;
        stroke: var(--purple-bright);
        stroke-width: 1.5;
        stroke-dasharray: 1;
        animation: cable-draw var(--ease-io) both;
        animation-timeline: --ch;
        animation-range: cover 40% cover 49%;
      }
      .chapter[data-scene='kanvaz'] .cable circle {
        animation: ch-pop var(--ease-settle) both;
        animation-timeline: --ch;
        animation-range: cover 40% cover 45%;
      }

      /* -------- ascent: letterbox opens, lights come up, camera pulls back -------- */
      .chapter[data-scene='ascent'] .show-img {
        animation-name: reveal-ascent;
        animation-timing-function: var(--ease-io);
      }
      .chapter[data-scene='ascent'] .media-frame::before {
        /* HUD corner marks: start pulled in, settle onto the frame */
        content: '';
        position: absolute;
        inset: -7px;
        pointer-events: none;
        --b: color-mix(in oklab, var(--text) 85%, transparent);
        background:
          linear-gradient(var(--b), var(--b)) top left / 18px 2px no-repeat,
          linear-gradient(var(--b), var(--b)) top left / 2px 18px no-repeat,
          linear-gradient(var(--b), var(--b)) top right / 18px 2px no-repeat,
          linear-gradient(var(--b), var(--b)) top right / 2px 18px no-repeat,
          linear-gradient(var(--b), var(--b)) bottom left / 18px 2px no-repeat,
          linear-gradient(var(--b), var(--b)) bottom left / 2px 18px no-repeat,
          linear-gradient(var(--b), var(--b)) bottom right / 18px 2px no-repeat,
          linear-gradient(var(--b), var(--b)) bottom right / 2px 18px no-repeat;
        animation: hud-in var(--ease-settle) both;
        animation-timeline: --ch;
        animation-range: cover 46% cover 62%;
      }
    }
  }

  /* Phones: pinned mode is off, so give each card a light fade-up as it
     scrolls in (same technique, much smaller). */
  @media (max-width: 899px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .stage-inner {
        animation: m-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 45%;
      }
    }
  }

  /* -------- keyframes -------- */
  @keyframes ch-rise {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes ch-leave {
    from { opacity: 1; transform: none; }
    to   { opacity: 0.1; transform: translateY(-6vh) scale(0.985); }
  }
  @keyframes ch-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes ch-pop {
    from { opacity: 0; transform: scale(0.2); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes ch-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @keyframes bg-drift {
    0%   { opacity: 0; transform: translateY(8vh); }
    22%  { opacity: 1; }
