  }

  /* -------- keyframes -------- */
  @keyframes ch-rise {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes ch-leave {
    from { opacity: 1; transform: none; }
    to   { opacity: 0.1; transform: translateY(-6vh) scale(0.985); }
  }
  @keyframes ch-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @keyframes ch-pop {
    from { opacity: 0; transform: scale(0.2); }
    to   { opacity: 1; transform: scale(1); }
  }
  @keyframes ch-progress {
    from { transform: scaleX(0); }
    to   { transform: scaleX(1); }
  }
  @keyframes bg-drift {
    0%   { opacity: 0; transform: translateY(8vh); }
    22%  { opacity: 1; }
    80%  { opacity: 1; }
    100% { opacity: 0; transform: translateY(-8vh); }
  }
  @keyframes reveal-default {
    from { opacity: 0; transform: translateY(36px); clip-path: inset(0 0 40% 0); }
    to   { opacity: 1; transform: none; clip-path: inset(0 0 0 0); }
  }
  @keyframes reveal-nexus {
    from { clip-path: inset(0 100% 0 0); transform: scale(1.035); }
    to   { clip-path: inset(0 0 0 0);    transform: none; }
  }
  @keyframes nexus-scan {
    0%   { left: 0;    opacity: 0; }
    5%   { opacity: 1; }
    95%  { opacity: 1; }
    100% { left: 100%; opacity: 0; }
  }
  @keyframes reveal-kanvaz {
    from { opacity: 0; transform: translateY(-80px) rotate(-6deg) scale(1.05); }
    30%  { opacity: 1; }
    to   { opacity: 1; transform: none; }
  }
  @keyframes cable-draw {
    from { stroke-dashoffset: 1; }
    to   { stroke-dashoffset: 0; }
  }
  @keyframes reveal-ascent {
    from { clip-path: inset(46% 0 46% 0); transform: scale(1.07); filter: brightness(0.3) var(--grade, none); }
    to   { clip-path: inset(0 0 0 0);     transform: none;        filter: var(--grade, none); }
  }
  @keyframes push-in {
    from { scale: 0.985; }
    to   { scale: 1.03; }
  }
  @keyframes name-fill {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0); }
