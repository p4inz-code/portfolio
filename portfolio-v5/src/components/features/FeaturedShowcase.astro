---
import type { Project } from '../../data/projects';
import StatusPill from '../ui/StatusPill.astro';

/**
 * Featured work, one pinned chapter per project.
 *
 * Each chapter is a tall wrapper with a sticky 100svh stage inside. A named
 * view-timeline on the chapter drives two moments while the stage is pinned:
 *   1. the words arrive (status, name, tagline, description, meta, link);
 *   2. one more scroll later, the media is revealed.
 * The reveal is different per scene (nexus wipe, kanvaz drop, ascent
 * letterbox); projects with no scene use a plain fade-up.
 *
 * Range maths (so the numbers below are not magic): for a chapter of height
 * H and viewport height V, the `cover` range is V + H long and the stage is
 * pinned from V/(V+H) to H/(V+H).
 *   media chapter    H = 240vh  ->  pinned 29.4% .. 70.6%  (1.4 screens of scroll)
 *   no-media chapter H = 160vh  ->  pinned 38.5% .. 61.5%  (0.6 screens)
 *
 * No dead scroll: the words start arriving while the stage is still rising
 * into view (17%), the media reveals right behind them (33-53%), and from
 * 54% to the end of the pin a slow push-in and the backdrop parallax keep
 * every notch of the wheel doing something.
 *
 * Feel: arrivals ease out (fast start, soft landing), wipes ease in-out,
 * the Kanvaz card overshoots slightly and settles. Nothing is linear
 * except the small progress hairline.
 *
 * Static fallback (no animation-timeline, reduced motion, or < 900px):
 * normal stacked cards, everything visible, no pinning.
 */
interface Props {
  projects: Project[];
  headingLevel?: 'h2' | 'h3'; // h3 under a Section's own h2 (home), h2 under a page h1 (/work)
}
const { projects, headingLevel = 'h3' } = Astro.props;
const NameTag = headingLevel;
const defaultLabel = (kind: string) =>
  kind === 'banner' ? 'Banner art from the project README' : '';
---
<section class="showcase" aria-label="Featured projects showcase">
  {projects.map((p, i) => {
    const m = p.media;
    const pad = (n: number) => String(n).padStart(2, '0');
    return (
      <article
        class:list={['chapter', m ? 'has-media' : 'no-media']}
        data-scene={p.scene}
        data-slug={p.slug}
        id={`ch-${p.slug}`}
        data-progress
      >
        <div class="stage">
          <div class="scene-bg" aria-hidden="true">
            {p.scene === 'ascent' && (
              <>
                <span class="nebula"></span>
                <span class="stars s1"></span>
                <span class="stars s2"></span>
                <span class="stars s3"></span>
                <span class="shoot a"></span>
                <span class="shoot b"></span>
                <span class="moon moon-orb"></span>
                <span class="ridge far"></span>
                <span class="ridge mid"></span>
                <span class="ridge near"></span>
              </>
            )}
          </div>
          <div class="ch-count" aria-hidden="true"><span>{pad(i + 1)} | {pad(projects.length)}</span><i></i></div>
          <div class="stage-inner">
            <a class="show-body" href={p.href}>
              <StatusPill status={p.status} size="sm" />
              <NameTag class="show-name" data-text={p.name}>{p.name}</NameTag>
              <p class="show-tag"><em>{p.tagline}</em></p>
              <p class="show-desc">{p.description}</p>
              <ul class="show-meta" role="list">
                {p.metaTags.slice(0, 4).map((t) => <li>{t}</li>)}
              </ul>
              <span class="show-cta">
                Open case study
                <span aria-hidden="true" class="show-cta-arrow">→</span>
              </span>
            </a>

            {p.scene === 'kanvaz' && (
              <svg class="cable" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
                <path d="M4 24 C 45 24, 55 14, 96 14" pathLength="1" />
                <circle cx="4" cy="24" r="3" />
                <circle cx="96" cy="14" r="3" />
              </svg>
            )}

            {m ? (
              <figure class="show-visual has-media" data-kind={m.kind}>
                <div class="media-frame" style={`aspect-ratio:${m.ratio};`}>
                  {m.video ? (
                    <video
                      class="show-img"
                      muted
                      loop
                      playsinline
                      preload="none"
                      poster={m.src}
                      role="img"
                      aria-label={m.alt}
                      data-showcase-video
                    >
                      <source src={m.video.webm} type="video/webm" />
                      <source src={m.video.mp4} type="video/mp4" />
                    </video>
                  ) : (
                    <img
                      class="show-img"
                      src={m.src}
                      alt={m.alt}
                      width="1600"
                      height="900"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  {p.scene === 'kanvaz' && <span class="pin" aria-hidden="true"></span>}
                </div>
                {(m.label || defaultLabel(m.kind)) && (
                  <figcaption class="show-media-tag">{m.label ?? defaultLabel(m.kind)}</figcaption>
                )}
              </figure>
            ) : (
              <div class="show-visual" aria-hidden="true">
                <div class="show-visual-frame">
                  <span class="show-visual-slug">{p.slug}</span>
                  <span class="show-visual-name">{p.name}</span>
                  <span class="show-visual-role">{p.license || 'proprietary'}</span>
                </div>
              </div>
            )}
          </div>
        </div>
      </article>
    );
  })}
</section>

<style>
  /* ---------------------------------------------------------------
     Base (static) layout: stacked, everything visible.
     --------------------------------------------------------------- */
  .showcase { display: flex; flex-direction: column; padding-top: var(--sp-6); }
  .chapter { position: relative; border-top: 1px solid var(--line); }
  .chapter:first-child { border-top: none; }
  .stage { position: relative; }
  .stage-inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--sp-7);
    align-items: center;
    padding: var(--sp-8) 0;
  }
  .chapter:first-child .stage-inner { padding-top: 0; }
  @media (max-width: 900px) {
    .stage-inner { grid-template-columns: 1fr; gap: var(--sp-5); padding: var(--sp-6) 0; }
  }

  .show-body > * { --k: 0; }
  .show-body > *:nth-child(2) { --k: 1; }
  .show-body > *:nth-child(3) { --k: 2; }
  .show-body > *:nth-child(4) { --k: 3; }
  .show-body > *:nth-child(5) { --k: 4; }
  .show-body > *:nth-child(6) { --k: 5; }

  .scene-bg { display: none; }
  .ch-count { display: none; }
  .cable { display: none; }
  .pin { display: none; }

  /* Text */
  .show-body {
    display: flex; flex-direction: column;
    gap: var(--sp-4);
    color: var(--text);
    text-decoration: none;
    padding-right: var(--sp-4);
  }
  .show-name {
    font-family: var(--font-display);
    font-size: clamp(32px, 4.2vw, 52px);
    font-weight: 500;
    color: var(--text);
    letter-spacing: -0.025em;
    line-height: 1.02;
    margin-top: var(--sp-2);
  }
  .show-tag {
    color: var(--purple-bright);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
  }
  .show-tag em { font-style: italic; }
  .show-desc {
    color: var(--muted);
    font-size: var(--text-md);
    line-height: var(--leading-body);
    max-width: 540px;
  }
  .show-meta {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-wrap: wrap; gap: 6px 8px;
    margin-top: var(--sp-2);
  }
  .show-meta li {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.05em;
    color: var(--muted);
    padding: 3px 8px;
    border: 1px solid var(--line);
    border-radius: 2px;
  }
  .show-cta {
    margin-top: var(--sp-4);
    display: inline-flex; align-items: center; gap: 8px;
    color: var(--purple-bright);
    font-family: var(--font-display);
    font-size: var(--text-md);
    padding-bottom: 4px;
    border-bottom: 1px solid var(--purple-bright);
    align-self: flex-start;
    transition: gap var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
  }
  .show-body:hover .show-cta { gap: 14px; }
  .show-cta-arrow { transition: transform var(--dur) var(--ease-out); }
  .show-body:hover .show-cta-arrow { transform: translateX(4px); }
  .show-body:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 8px; border-radius: 2px; }

  /* ---------------------------------------------------------------
     Scene backdrops: the pictures. Hidden until a mode turns .scene-bg on
     (pinned desktop, or the stacked-card mode on phones).
     --------------------------------------------------------------- */
  /* Scene backdrops (only drawn while pinned). */
  .chapter[data-scene='nexus'] .scene-bg {
    background-image:
          linear-gradient(color-mix(in oklab, var(--purple-bright) 9%, transparent) 1px, transparent 1px),
          linear-gradient(90deg, color-mix(in oklab, var(--purple-bright) 9%, transparent) 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 72% 50%, #000 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 60% 55% at 72% 50%, #000 0%, transparent 100%);
  }
  .chapter[data-scene='kanvaz'] .scene-bg {
    background-image: radial-gradient(color-mix(in oklab, var(--text) 22%, transparent) 1.1px, transparent 1.4px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 55% 50%, #000 0%, transparent 100%);
    mask-image: radial-gradient(ellipse 75% 65% at 55% 50%, #000 0%, transparent 100%);
  }
  /* Ascent: you are climbing. The moon rises fast from behind the ridges,
         the ground falls away at three different speeds, stars drift down
         slowly, and shooting stars cut across at fixed scroll points. */
  .chapter[data-scene='ascent'] .scene-bg {
    background:
          linear-gradient(to bottom, #04020c 0%, color-mix(in oklab, var(--purple-deep) 60%, #04020c) 100%);
  }
  .chapter[data-scene='ascent'] .scene-bg > * {
    position: absolute;
    pointer-events: none;
  }
  .chapter[data-scene='ascent'] .nebula {
    inset: -10% -10% 10% -10%;
    background:
          radial-gradient(38vmax 26vmax at 18% 32%, rgba(124, 58, 237, 0.30), transparent 70%),
          radial-gradient(34vmax 22vmax at 82% 18%, rgba(59, 130, 246, 0.20), transparent 70%),
          radial-gradient(30vmax 20vmax at 62% 58%, rgba(236, 72, 153, 0.14), transparent 70%);
    filter: blur(6px);
  }
  .chapter[data-scene='ascent'] .stars {
    inset: 0 0 30% 0;
    background-repeat: repeat;
  }
  .chapter[data-scene='ascent'] .stars.s1 {
    background-image:
          radial-gradient(1px 1px at 12px 18px, var(--star, #EDE8FF), transparent 60%),
          radial-gradient(1px 1px at 47px 63px, var(--star, #EDE8FF), transparent 60%),
          radial-gradient(1px 1px at 83px 29px, var(--star, #EDE8FF), transparent 60%),
          radial-gradient(1px 1px at 29px 91px, var(--star, #EDE8FF), transparent 60%),
          radial-gradient(1px 1px at 71px 77px, var(--star, #EDE8FF), transparent 60%);
    background-size: 100px 100px;
    opacity: 0.55;
  }
  .chapter[data-scene='ascent'] .stars.s2 {
    background-image:
          radial-gradient(1.5px 1.5px at 30px 40px, var(--star, #fff), transparent 65%),
          radial-gradient(1.5px 1.5px at 120px 90px, var(--star, #fff), transparent 65%),
          radial-gradient(1.5px 1.5px at 75px 150px, var(--star, #fff), transparent 65%),
          radial-gradient(1.5px 1.5px at 160px 20px, var(--star, #fff), transparent 65%);
    background-size: 190px 190px;
    opacity: 0.8;
  }
  .chapter[data-scene='ascent'] .stars.s3 {
    background-image:
          radial-gradient(2.2px 2.2px at 60px 70px, var(--star, #fff), rgba(190, 170, 255, 0.5) 55%, transparent 75%),
          radial-gradient(2px 2px at 210px 30px, var(--star, #fff), rgba(170, 200, 255, 0.5) 55%, transparent 75%),
          radial-gradient(2.4px 2.4px at 150px 190px, var(--star, #fff), rgba(255, 190, 220, 0.5) 55%, transparent 75%);
    background-size: 300px 260px;
  }
  .chapter[data-scene='ascent'] .shoot {
    width: 140px;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--star, #fff));
    box-shadow: 0 0 8px 1px var(--star-glow, rgba(200, 190, 255, 0.6));
    opacity: 0;
  }
  .chapter[data-scene='ascent'] .shoot.a {
    top: 16%;
    left: 22%;
    rotate: 28deg;
  }
  .chapter[data-scene='ascent'] .shoot.b {
    top: 30%;
    left: 58%;
    rotate: 32deg;
  }
  .chapter[data-scene='ascent'] .moon {
    top: 38%;
    right: 13%;
    width: 12vmin;
    height: 12vmin;
    border-radius: 50%;
  }
  .chapter[data-scene='ascent'] .ridge {
    left: -8%;
    right: -8%;
    bottom: 0;
  }
  .chapter[data-scene='ascent'] .ridge.far {
    height: 34vh;
    background: color-mix(in oklab, var(--purple-deep) 40%, #05030d);
    opacity: 0.7;
    clip-path: polygon(0 58%, 8% 40%, 15% 52%, 24% 26%, 33% 46%, 43% 20%, 52% 44%, 62% 24%, 72% 48%, 81% 30%, 90% 50%, 100% 36%, 100% 100%, 0 100%);
  }
  .chapter[data-scene='ascent'] .ridge.mid {
    height: 28vh;
    background: color-mix(in oklab, var(--purple-deep) 58%, #05030d);
    opacity: 0.85;
    clip-path: polygon(0 60%, 10% 34%, 19% 54%, 29% 22%, 40% 50%, 50% 28%, 59% 58%, 69% 20%, 79% 52%, 89% 30%, 100% 56%, 100% 100%, 0 100%);
  }
  .chapter[data-scene='ascent'] .ridge.near {
    height: 20vh;
    background: color-mix(in oklab, var(--purple-deep) 76%, #05030d);
    opacity: 1;
    clip-path: polygon(0 50%, 7% 30%, 16% 58%, 27% 24%, 36% 52%, 47% 18%, 57% 56%, 68% 26%, 78% 58%, 88% 22%, 100% 54%, 100% 100%, 0 100%);
  }
  /* Light theme: a lavender dusk instead of deep space. */
  :global(:root[data-theme='light']) .chapter[data-scene='ascent'] .scene-bg {
    background: linear-gradient(to bottom, color-mix(in oklab, var(--purple) 8%, var(--bg)), color-mix(in oklab, var(--purple) 26%, var(--bg)));
  }
  :global(:root[data-theme='light']) .chapter[data-scene='ascent'] .scene-bg { --star: #3B1A9F; --star-glow: rgba(91, 61, 245, 0.4); }
  :global(:root[data-theme='light']) .chapter[data-scene='ascent'] .nebula {
    opacity: 0.35;
  }
  :global(:root[data-theme='light']) .chapter[data-scene='ascent'] .ridge.far {
    background: color-mix(in oklab, var(--purple) 30%, var(--bg));
    opacity: 0.8;
  }
  :global(:root[data-theme='light']) .chapter[data-scene='ascent'] .ridge.mid {
    background: color-mix(in oklab, var(--purple) 48%, var(--bg));
    opacity: 0.9;
  }
  :global(:root[data-theme='light']) .chapter[data-scene='ascent'] .ridge.near {
    background: color-mix(in oklab, var(--purple) 66%, var(--bg));
  }

  /* Scene title fonts (see styles/scenes.css for the families). */
  .chapter[data-scene='nexus'] .show-name  { font-family: var(--font-scene-nexus);  font-weight: 500; letter-spacing: -0.01em; }
  .chapter[data-scene='kanvaz'] .show-name { font-family: var(--font-scene-kanvaz); font-weight: 700; letter-spacing: 0; font-size: clamp(36px, 4.6vw, 58px); }
  .chapter[data-scene='ascent'] .show-name { font-family: var(--font-scene-ascent); font-weight: 400; letter-spacing: 0.01em; line-height: 1; font-size: clamp(42px, 5.4vw, 70px); }

  /* Media */
  .show-visual.has-media { margin: 0; min-width: 0; }
  .media-frame { position: relative; width: 100%; }
  .show-img {
    display: block;
    width: 100%; height: 100%;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: var(--surface-2);
  }
  /* Ascent: a bigger frame with a colour grade (violet shadows, more punch), one recipe per theme */
  .chapter[data-scene='ascent'] { --grade: saturate(1.2) contrast(1.06); }
  :global(:root[data-theme='light']) .chapter[data-scene='ascent'] { --grade: saturate(1.08) brightness(1.08) contrast(1.02); }
  /* v5.28.0 fix — this used to add a second gradient layer on top of the
     video with mix-blend-mode: soft-light for extra punch. Some GPUs fail
     to composite a hardware-decoded <video> under a blended sibling layer
     and render it blank instead — reported as "the Ascent video doesn't
     show up." The filter alone gets most of the same grade with none of
     that risk, so the blended overlay is gone. */
  .chapter[data-scene='ascent'] .show-img { filter: var(--grade); border-radius: 5px; box-shadow: 0 24px 60px -28px color-mix(in oklab, var(--purple-bright) 70%, transparent); }
  .show-media-tag {
    margin-top: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--text-xxs);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Placeholder frame (Mission OS, Pursue OS: no media yet) */
  .show-visual:not(.has-media) {
    display: flex; align-items: center; justify-content: center;
    background:
      linear-gradient(135deg, color-mix(in oklab, var(--purple-deep) 45%, transparent), color-mix(in oklab, var(--surface-2) 90%, transparent));
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    min-height: 320px;
    position: relative;
    overflow: hidden;
  }
  .show-visual:not(.has-media)::before {
    content: '';
    position: absolute; inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, color-mix(in oklab, var(--purple-bright) 20%, transparent), transparent 50%),
      radial-gradient(circle at 80% 70%, color-mix(in oklab, var(--purple) 15%, transparent), transparent 55%);
    pointer-events: none;
  }
  .show-visual-frame {
    display: flex; flex-direction: column; align-items: center; gap: 12px;
    position: relative; z-index: 1;
    padding: var(--sp-6);
    text-align: center;
  }
  .show-visual-slug {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--muted);
  }
  .show-visual-name {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    color: var(--text);
    letter-spacing: -0.02em;
    line-height: 1;
    font-weight: 500;
  }
  .show-visual-role {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--purple-bright);
    padding: 3px 8px;
    border: 1px solid color-mix(in oklab, var(--purple-bright) 40%, transparent);
    border-radius: 2px;
    margin-top: 4px;
  }
  @media (max-width: 900px) {
    .show-visual:not(.has-media) { min-height: 200px; }
    .show-visual-name { font-size: clamp(24px, 5vw, 36px); }
  }

  /* ---------------------------------------------------------------
     Scenes: static look (no scroll needed). These are what you see on
     phones, with reduced motion, and in browsers without scroll timelines.
     --------------------------------------------------------------- */
  .chapter[data-scene='nexus'] .show-img { border-radius: 2px; border-color: color-mix(in oklab, var(--purple-bright) 35%, var(--line-strong)); }
  .chapter[data-scene='kanvaz'] .show-img {
    border-radius: 6px;
    box-shadow: 0 18px 40px -20px rgba(0, 0, 0, 0.55);
  }
  .chapter[data-scene='ascent'] .show-img { border-radius: 2px; }

  /* ---------------------------------------------------------------
     Pinned mode: desktop, motion allowed, scroll timelines supported.
     --------------------------------------------------------------- */
  @media (min-width: 900px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .chapter {
        view-timeline: --ch block;
        border-top: none;
        --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
        --ease-io: cubic-bezier(0.65, 0, 0.35, 1);
        --ease-settle: cubic-bezier(0.34, 1.32, 0.64, 1);
      }
      .chapter.has-media { height: 240vh; }
      .chapter.no-media  { height: 160vh; }

      .stage {
        position: sticky;
        top: 0;
        height: 100vh;
        height: 100svh;
        display: flex;
        align-items: center;
        padding-top: 88px; /* sticky nav */
        box-sizing: border-box;
      }
      .stage-inner { width: 100%; padding: 0; }
      .chapter:first-child .stage-inner { padding-top: 0; }
      /* Media gets the wider column: the picture is the payoff. */
      .chapter.has-media .stage-inner { grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--sp-8); }
      .chapter.has-media[data-scene='ascent'] .stage-inner { grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.6fr); gap: var(--sp-7); }

      /* Chapter counter with a hairline that fills while the stage is pinned. */
      .ch-count {
        display: flex;
        align-items: center;
        gap: 10px;
        position: absolute;
        top: 96px; right: 0;
        font-family: var(--font-mono);
        font-size: var(--text-xxs);
        letter-spacing: var(--tracking-eyebrow);
        color: var(--muted);
        pointer-events: none;
      }
      .ch-count i {
        display: block;
        width: 44px; height: 1px;
        background: var(--purple-bright);
        transform-origin: 0 50%;
        animation: ch-progress linear both;
        animation-timeline: --ch;
      }
      .chapter.has-media .ch-count i { animation-range: cover 29% cover 71%; }
      .chapter.no-media  .ch-count i { animation-range: cover 38% cover 62%; }

      /* Leave: the stage lifts and dims as the next chapter arrives. */
      .chapter.has-media .stage-inner {
        animation: ch-leave var(--ease-io) both;
        animation-timeline: --ch;
        animation-range: cover 72% cover 92%;
      }
      .chapter.no-media .stage-inner {
        animation: ch-leave var(--ease-io) both;
        animation-timeline: --ch;
        animation-range: cover 63% cover 90%;
      }

      /* Arrive: words rise in, staggered along the scroll. */
      .show-body > * {
        animation: ch-rise var(--ease-out) both;
        animation-timeline: --ch;
        --k: 0;
        --t0: 17%;
        animation-range: cover calc(var(--t0) + var(--k) * 1.1%) cover calc(var(--t0) + 9% + var(--k) * 1.1%);
      }
      .chapter.no-media .show-body > * { --t0: 26%; }
      .show-body > *:nth-child(2) { --k: 1; }
      .show-body > *:nth-child(3) { --k: 2; }
      .show-body > *:nth-child(4) { --k: 3; }
      .show-body > *:nth-child(5) { --k: 4; }
      .show-body > *:nth-child(6) { --k: 5; }

      /* Title: outlined at first, the accent fills in as you scroll (a left to
         right sweep; Ascent fills in pixel-sized steps). The fill is a copy of
         the text, clipped, so it works with any font. */
      .show-name {
        position: relative;
        display: block;
        width: fit-content;
        color: transparent;
        -webkit-text-stroke: 1.5px var(--purple-bright);
      }
      .show-name::after {
        content: attr(data-text);
        position: absolute;
        left: 0; top: 0;
        width: 100%;
        color: var(--purple-bright);
        -webkit-text-stroke: 0;
        clip-path: inset(0 100% 0 0);
        animation: name-fill var(--ease-io) both;
        animation-timeline: --ch;
        animation-range: cover 30% cover 52%;
        pointer-events: none;
      }
      .chapter.no-media .show-name::after { animation-range: cover 40% cover 56%; }
      .chapter[data-scene='ascent'] .show-name::after { animation-timing-function: steps(16, end); }

      /* Reveal: the media, one scroll after the words. */
      .chapter.has-media .show-img {
        animation: reveal-default var(--ease-out) both;
        animation-timeline: --ch;
        animation-range: cover 33% cover 53%;
      }
      /* Slow push-in after the reveal (uses the `scale` property so it
         composes with each scene's own transforms). */
      .chapter.has-media .media-frame {
        animation: push-in linear both;
        animation-timeline: --ch;
        animation-range: cover 33% cover 70%;
      }
      .chapter.has-media .show-media-tag {
        animation: ch-fade var(--ease-out) both;
        animation-timeline: --ch;
        animation-range: cover 50% cover 57%;
      }
      .chapter.no-media .show-visual {
        animation: reveal-default var(--ease-out) both;
        animation-timeline: --ch;
        animation-range: cover 40% cover 54%;
      }

      /* Backdrop: fades in with the words and drifts slower than the page,
         which gives the pinned stage a sense of depth. */
      .scene-bg {
        display: block;
        position: absolute;
        top: -8vh; bottom: -8vh;
        left: 50%;
        width: 100vw;
        margin-left: -50vw;
        pointer-events: none;
        z-index: -1;
        animation: bg-drift linear both;
        animation-timeline: --ch;
        animation-range: cover 0% cover 100%;
      }

      /* the sky fades in and out at its top and bottom edges, so chapters melt into each other */
      .chapter[data-scene='ascent'] .scene-bg {
        -webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 16vh, #000 calc(100% - 16vh), transparent 100%);
