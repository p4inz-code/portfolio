---
/**
 * AP monogram — real artwork, not a hand-drawn approximation. Background
 * keyed to transparent (source render was solid black); the metallic
 * gradient carries enough of its own contrast to read on both the dark
 * and light theme without a per-theme color swap.
 */
interface Props {
  size?: number;
}
const { size = 34 } = Astro.props;
---
<img
  class="ap-mark"
  src="/ap-mark.png"
  width={size}
  height={size}
  style={`--size:${size}px;`}
  alt=""
  aria-hidden="true"
  loading="eager"
  decoding="async"
/>

<style>
  .ap-mark {
    display: inline-block;
    width: var(--size, 34px);
    height: var(--size, 34px);
    flex-shrink: 0;
  }
</style>
