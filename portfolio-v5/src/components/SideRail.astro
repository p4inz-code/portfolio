---
/**
 * Fixed side rail — right edge of viewport, desktop-only.
 * v5.14.0 rebuild:
 *  - Added Instagram + WhatsApp (both real accounts)
 *  - Dropped rotated vertical URL text
 *  - Added copy-URL button that expands horizontally on hover
 *    ("atharvapatil.tech/current-path"), copies to clipboard on click
 *    with a brief "copied" state
 *  - Every icon is theme-swappable via currentColor
 *  - Hidden on Mission OS demo route (body:has(.demo-scope) rule)
 *  - Hidden below 900px — mobile has the hamburger drawer
 */
import { CONTACT } from '../data/site';
const WHATSAPP_NUMBER = '919321614988'; // wa.me expects digits, no plus
const WHATSAPP_HREF = `https://wa.me/${WHATSAPP_NUMBER}`;
const INSTAGRAM_HREF = 'https://instagram.com/atharva.patil.cg';
const currentPath = Astro.url.pathname;
const displayPath = currentPath === '/' ? '' : currentPath.replace(/\/$/, '');
---
<aside class="side-rail" aria-label="Contact + share">
  <!-- Top: brand mark tick -->
  <div class="sr-brand" aria-hidden="true">
    <span class="sr-tick"></span>
  </div>

  <!-- Middle: social/contact icons -->
  <nav class="sr-icons" aria-label="Contact links">
    <a href={`mailto:${CONTACT.email}`} class="sr-icon" title="Email" aria-label="Email">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="5" width="18" height="14" rx="2"/>
        <path d="M3 7l9 6 9-6"/>
      </svg>
    </a>
    <a href={CONTACT.github} target="_blank" rel="noopener noreferrer" class="sr-icon" title="GitHub" aria-label="GitHub">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M9 19c-4 1.5-4-2-6-2m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12 12 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/>
      </svg>
    </a>
    <a href={CONTACT.discordInvite} target="_blank" rel="noopener noreferrer" class="sr-icon" title="Discord (Nexus beta)" aria-label="Discord">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <path d="M18 5.5C16.5 4.8 15 4.5 13.5 4.4l-.4 1a13 13 0 0 0-3.2 0l-.4-1c-1.5.1-3 .4-4.5 1.1C2.7 8 2 12 2.4 15.7c1.6 1.2 3.2 2 4.8 2.5l1-1.6c-.9-.3-1.7-.7-2.5-1.3.2-.1.4-.3.6-.4a11 11 0 0 0 11.4 0c.2.1.4.3.6.4a11 11 0 0 1-2.5 1.3l1 1.6c1.6-.5 3.2-1.3 4.8-2.5.6-4.3-.6-8.2-3.6-10.2z"/>
        <circle cx="9" cy="12" r="1"/><circle cx="15" cy="12" r="1"/>
      </svg>
    </a>
    <a href={WHATSAPP_HREF} target="_blank" rel="noopener noreferrer" class="sr-icon" title="WhatsApp (business)" aria-label="WhatsApp">
      <!-- Real WhatsApp brand SVG (Simple Icons / brand-approved path). -->
      <svg viewBox="0 0 32 32" fill="currentColor" stroke="none" aria-hidden="true">
        <path d="M16.001 2.667C8.634 2.667 2.667 8.634 2.667 16.001c0 2.354.617 4.673 1.79 6.712L2.615 29.333l6.786-1.774a13.28 13.28 0 0 0 6.601 1.773h.006c7.363 0 13.33-5.967 13.33-13.33s-5.967-13.335-13.336-13.335zm0 24.428a11.12 11.12 0 0 1-5.663-1.549l-.406-.241-4.211 1.104 1.124-4.104-.264-.42a11.089 11.089 0 0 1-1.7-5.884c.001-6.13 4.99-11.12 11.121-11.12 2.972 0 5.766 1.159 7.866 3.261a11.06 11.06 0 0 1 3.255 7.866c-.003 6.13-4.992 11.12-11.121 11.12zm6.098-8.328c-.334-.167-1.977-.976-2.283-1.087-.306-.111-.53-.167-.752.167-.222.333-.863 1.087-1.058 1.31-.195.223-.39.25-.724.083-.334-.167-1.41-.52-2.687-1.657-.994-.886-1.664-1.98-1.859-2.313-.195-.334-.021-.514.146-.681.15-.15.334-.39.501-.585.167-.195.222-.334.334-.557.111-.223.056-.418-.028-.585-.083-.167-.751-1.812-1.03-2.48-.271-.652-.547-.564-.751-.574-.194-.01-.417-.012-.64-.012-.222 0-.585.083-.891.418-.306.334-1.168 1.142-1.168 2.786 0 1.644 1.196 3.232 1.363 3.455.167.223 2.354 3.594 5.702 5.041.797.344 1.418.55 1.903.703.799.254 1.527.218 2.101.132.641-.096 1.977-.808 2.256-1.588.279-.78.279-1.449.195-1.588-.083-.14-.306-.223-.64-.39z"/>
      </svg>
    </a>
    <a href={INSTAGRAM_HREF} target="_blank" rel="noopener noreferrer" class="sr-icon" title="Instagram" aria-label="Instagram">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="5"/>
        <circle cx="12" cy="12" r="4"/>
        <circle cx="17.5" cy="6.5" r="0.7" fill="currentColor" stroke="none"/>
      </svg>
    </a>
    <button type="button" class="sr-icon sr-icon-btn" id="cmdkTriggerRail" title="Search & jump (Ctrl+K)" aria-label="Open command palette">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="7"/>
        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
      </svg>
    </button>
  </nav>

  <!-- Bottom: copy-URL button (horizontal expand on hover, click to copy) -->
  <div class="sr-share">
    <button
      type="button"
      class="sr-copy"
      id="srCopy"
      data-path={displayPath}
      title="Copy this page's URL to clipboard"
      aria-label="Copy page URL to clipboard"
    >
      <span class="sr-copy-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="12" height="12" rx="2"/>
          <path d="M5 15V5a2 2 0 0 1 2-2h10"/>
        </svg>
      </span>
      <span class="sr-copy-label">
        atharvapatil.tech<span class="sr-copy-path">{displayPath}</span>
      </span>
    </button>
    <span class="sr-copy-toast" id="srCopyToast" aria-live="polite">Copied</span>
  </div>
</aside>

<script is:inline>
  (function () {
    // v5.14.0 sidebar wiring
    // - Mirror the nav CmdK trigger so the sidebar magnifier opens the palette
    // - Wire the copy-URL button (writes location.href to clipboard + toast)
    const railBtn = document.getElementById('cmdkTriggerRail');
    const desktopBtn = document.getElementById('cmdkTrigger');
    if (railBtn && desktopBtn) {
      railBtn.addEventListener('click', function () { desktopBtn.click(); });
    }

    const copyBtn = document.getElementById('srCopy');
    const toast = document.getElementById('srCopyToast');
    if (copyBtn && toast) {
      copyBtn.addEventListener('click', function () {
        const url = window.location.href;
        function done() {
          toast.classList.add('show');
          copyBtn.classList.add('copied');
          setTimeout(function () {
            toast.classList.remove('show');
            copyBtn.classList.remove('copied');
          }, 1600);
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(done, done);
        } else {
          // Fallback for older browsers
          const ta = document.createElement('textarea');
          ta.value = url; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta);
          ta.select();
          try { document.execCommand('copy'); } catch (e) {
            window.__nbDiag && window.__nbDiag.log('side-rail', 'Clipboard write blocked — copy fallback also failed', { recovered: false });
          }
          document.body.removeChild(ta);
          done();
        }
      });
    }
  })();
</script>

<style>
  /* v5.14.0 layout — same right-edge dock, taller room for the extra icons */
  .side-rail {
    position: fixed;
    top: 0; right: 14px;
    height: 100vh;
    width: 52px;
    display: none;
    flex-direction: column;
    align-items: center;
    z-index: 90;
    padding: 100px 0 32px;
    pointer-events: none;
  }
  .side-rail > * { pointer-events: auto; }

  /* Brand tick */
  .sr-brand {
    display: flex; align-items: center; justify-content: center;
    width: 100%;
    margin-bottom: var(--sp-5);
  }
  .sr-tick {
    display: block;
    width: 3px; height: 28px;
    background: linear-gradient(180deg, var(--purple-bright), var(--purple));
    border-radius: 2px;
    box-shadow: 0 0 12px var(--purple-bright);
  }
  :root[data-theme='light'] .sr-tick {
    box-shadow: 0 0 8px rgba(110, 68, 214, 0.4);
  }

  /* Icon column */
  .sr-icons {
    display: flex; flex-direction: column;
    gap: 6px;
    align-items: center;
  }
  .sr-icon {
    display: inline-flex; align-items: center; justify-content: center;
    width: 40px; height: 40px;
    border: 1px solid transparent;
    border-radius: 6px;
    color: var(--muted);
    background: color-mix(in oklab, var(--bg) 55%, transparent);
    backdrop-filter: blur(6px);
    transition: color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out),
                background var(--dur-fast) var(--ease-out),
                transform var(--dur-fast) var(--ease-out);
  }
  .sr-icon svg { width: 20px; height: 20px; }
  .sr-icon:hover, .sr-icon:focus-visible {
    color: var(--purple-bright);
    border-color: var(--line-strong);
    background: color-mix(in oklab, var(--purple) 14%, transparent);
    transform: translateX(-3px);
    outline: none;
  }
  .sr-icon:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 2px; }
  .sr-icon-btn { cursor: pointer; padding: 0; font: inherit; }

  /* Bottom copy-URL button — collapsed to a small icon by default,
     expands leftwards on hover to reveal the horizontal URL. */
  .sr-share {
    margin-top: auto;
    display: flex; flex-direction: column; align-items: flex-end;
    gap: 6px;
    width: 100%;
    position: relative;
  }
  .sr-copy {
    display: inline-flex; align-items: center;
    gap: 0;
    height: 34px;
    padding: 0;
    background: color-mix(in oklab, var(--bg) 60%, transparent);
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font: inherit;
    cursor: pointer;
    backdrop-filter: blur(8px);
    overflow: hidden;
    max-width: 40px;
    transition: max-width 300ms var(--ease-out),
                color var(--dur-fast) var(--ease-out),
                border-color var(--dur-fast) var(--ease-out),
                background var(--dur-fast) var(--ease-out);
    white-space: nowrap;
  }
  .sr-copy:hover, .sr-copy:focus-visible {
    max-width: 320px;
    color: var(--purple-bright);
    border-color: var(--line-strong);
    background: color-mix(in oklab, var(--purple) 12%, transparent);
    outline: none;
  }
  .sr-copy:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 2px; }
  .sr-copy.copied {
    max-width: 40px;
    color: var(--green);
    border-color: color-mix(in oklab, var(--green) 40%, var(--line-strong));
  }
  .sr-copy-icon {
    flex-shrink: 0;
    width: 40px; height: 32px;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .sr-copy-icon svg { width: 18px; height: 18px; }
  .sr-copy-label {
    display: inline-flex; align-items: center;
    padding-right: 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--text);
    opacity: 0;
    transition: opacity 200ms var(--ease-out);
  }
  .sr-copy:hover .sr-copy-label,
  .sr-copy:focus-visible .sr-copy-label { opacity: 1; }
  .sr-copy-path { color: var(--purple-bright); margin-left: 2px; }

  .sr-copy-toast {
    position: absolute;
    bottom: 42px; right: 6px;
    padding: 4px 10px;
    background: color-mix(in oklab, var(--bg) 92%, transparent);
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    color: var(--green);
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 180ms var(--ease-out), transform 180ms var(--ease-out);
    pointer-events: none;
  }
  .sr-copy-toast.show { opacity: 1; transform: translateY(0); }

  @media (min-width: 900px) { .side-rail { display: flex; } }
  @media (prefers-reduced-motion: reduce) {
    .sr-copy, .sr-copy-label, .sr-copy-toast, .sr-icon { transition: none; }
  }
</style>
