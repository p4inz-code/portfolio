---
/**
 * Meta tag — v5.6.3 de-AI-fy: dropped the rounded-pill + surface-tint
 * treatment (Vercel-adjacent). Now plain small-caps mono with a bar
 * marker on the left, matching the redesigned StatusPill's editorial
 * language.
 */
interface Props {
  label: string;
}
const { label } = Astro.props;
---
<span class="meta-tag">
  <span class="meta-bar" aria-hidden="true"></span>
  {label}
</span>

<style>
  .meta-tag {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--muted);
    padding: 0;
    background: none;
    border: none;
  }
  .meta-bar {
    display: inline-block;
    width: 2px;
    height: 0.85em;
    background: var(--muted);
    transform: translateY(0.05em);
    opacity: 0.7;
  }
</style>
