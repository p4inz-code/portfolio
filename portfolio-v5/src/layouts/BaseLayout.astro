---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import CommandPalette from '../components/features/CommandPalette.astro';
import { SITE, NAV, CONTACT } from '../data/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  themeColor?: string;
}
const {
  title,
  description = SITE.description,
  ogImage = "/og.png",
  themeColor = "#0A0517",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

// Structured data (JSON-LD) — helps Google, Bing, and LLM crawlers
// resolve "p4inz" / "p4inz github" queries back to Atharva Patil, and
// ties the site + person + studio + external repos together as one
// entity graph. The Person node is the anchor; WebSite + Organization
// reference it via @id. Emitted on every page so social/AI previews
// on any deep link resolve correctly.
const person = {
  '@type': 'Person',
  '@id': 'https://atharvapatil.tech/#person',
  name: 'Atharva Patil',
  alternateName: ['p4inz', 'p4inz-code'],
  url: 'https://atharvapatil.tech/',
  image: 'https://atharvapatil.tech/og.png',
  jobTitle: SITE.role,
  worksFor: { '@id': 'https://atharvapatil.tech/#studio' },
  email: `mailto:${CONTACT.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Navi Mumbai',
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'D. Y. Patil University',
  },
  knowsAbout: [
    'Software engineering',
    'Windows desktop development',
    'Linux systems',
    '3D animation',
    'Visual effects',
    'Privacy-first design',
    'Applied cryptography',
  ],
  sameAs: [
    CONTACT.github,
    CONTACT.discordInvite,
    'https://github.com/p4inz-code/mission-os',
    'https://github.com/p4inz-code/nexus-desktop',
    'https://github.com/p4inz-code/kanvaz',
    'https://github.com/p4inz-code/pursue-os',
  ],
};

const studio = {
  '@type': 'Organization',
  '@id': 'https://atharvapatil.tech/#studio',
  name: SITE.studio,
  url: 'https://atharvapatil.tech/',
  founder: { '@id': 'https://atharvapatil.tech/#person' },
  foundingDate: SITE.studioFounded,
  location: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Navi Mumbai',
      addressCountry: 'IN',
    },
  },
};

const website = {
  '@type': 'WebSite',
  '@id': 'https://atharvapatil.tech/#website',
  url: 'https://atharvapatil.tech/',
  name: `${SITE.title} — ${SITE.tagline}`,
  description: SITE.description,
  inLanguage: 'en',
  author: { '@id': 'https://atharvapatil.tech/#person' },
  publisher: { '@id': 'https://atharvapatil.tech/#studio' },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, studio, website],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content={themeColor} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F3EDDD" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#7B3FE4" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="me" href={CONTACT.github} />
    <link rel="me" href={`mailto:${CONTACT.email}`} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — changelog`} href="/feed.xml" />
    <link rel="search" type="application/opensearchdescription+xml" title="Atharva Patil" href="/opensearch.xml" />
    <link rel="author" href="/humans.txt" />
    <link rel="license" href="/LICENSE" />
    <meta name="application-name" content={SITE.title} />
    <meta name="apple-mobile-web-app-title" content={SITE.title} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="msapplication-TileColor" content="#0A0517" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="author" content={SITE.title} />

    <!-- Structured data — Person / Organization / WebSite entity graph.
         Ties p4inz / p4inz-code / Atharva Patil / Northbyte Studios into
         one linked graph so search + LLM crawlers resolve consistently. -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('nb-theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const theme = stored || (prefersLight ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <!-- Scroll progress bar — hairline at very top of viewport, fills as
         the page scrolls. Zero-JS: powered by CSS animation-timeline: scroll().
         Falls back to nothing (element stays at scaleX 0) on browsers without
         scroll-driven animations. Aria-hidden — decorative. -->
    <div class="scroll-progress" aria-hidden="true"></div>

    <a href="#main" class="skip-nav">Skip to content</a>

    <header class="nav">
      <div class="nav-inner wrap">
        <a href="/" class="brand" aria-label="Atharva Patil — home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 19V5l9 12V5M14 19h5" />
            </svg>
          </span>
          <span class="brand-name">Atharva Patil</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          {NAV.filter((n) => !n.cta).map((n) => (
            <a href={n.href} class:list={[currentPath === n.href && 'active']}>{n.label}</a>
          ))}
          {NAV.filter((n) => n.cta).map((n) => (
            <a href={n.href} class:list={['nav-cta', currentPath === n.href && 'active']}>{n.label}</a>
          ))}
          <button
            type="button"
            class="nav-cmdk"
            id="cmdkTrigger"
            aria-label="Open command palette (Ctrl+K)"
            title="Search & jump (Ctrl+K)"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
            </svg>
            <span>⌘K</span>
          </button>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <p class="footer-name">Atharva Patil</p>
          <p class="footer-role">{SITE.role} · {SITE.location}</p>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          <a href="/work">Work</a>
          <a href="/about">About</a>
          <a href="/resume">Resume</a>
          <a href="/contact">Contact</a>
          <a href="/status">Status</a>
          <a href="/accessibility">Accessibility</a>
        </nav>
        <div class="footer-meta">
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a href={CONTACT.github} target="_blank" rel="noopener noreferrer">{CONTACT.githubHandle}</a>
          <span class="mono">© 2026 · {SITE.currentVersion}</span>
        </div>
      </div>
    </footer>

    <CommandPalette />

    <style>
      /* Scroll progress bar */
      .scroll-progress {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 2px;
        z-index: 200;
        background: var(--purple-bright);
        transform-origin: 0 50%;
        transform: scaleX(0);
        pointer-events: none;
      }
      @supports (animation-timeline: scroll()) {
        .scroll-progress {
          animation: sp-fill linear both;
          animation-timeline: scroll(root block);
        }
      }
      @keyframes sp-fill {
        from { transform: scaleX(0); }
        to   { transform: scaleX(1); }
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-progress { animation: none; transform: scaleX(0); }
      }

      .nav {
        padding: var(--sp-5) 0;
        position: sticky; top: 0; z-index: 100;
        backdrop-filter: blur(12px);
        background: color-mix(in oklab, var(--bg) 78%, transparent);
        border-bottom: 1px solid var(--line);
      }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-6); }
      .brand { display: inline-flex; align-items: center; gap: var(--sp-3); color: var(--text); }
      .brand-mark {
        width: 34px; height: 34px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 50%; border: 1px solid var(--line-strong);
        color: var(--purple-bright);
      }
      .brand-mark svg { width: 16px; height: 16px; }
      .brand-name { font-family: var(--font-display); font-size: var(--text-md); font-style: italic; }
      .nav-links { display: flex; align-items: center; gap: var(--sp-6); }
      .nav-links a {
        color: var(--muted); font-size: var(--text-sm);
        transition: color var(--dur-fast) var(--ease-out);
        position: relative;
      }
      .nav-links a:hover, .nav-links a.active { color: var(--text); }
      .nav-links a.active::after {
        content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 1px;
        background: var(--purple-bright); border-radius: 1px;
      }
      .nav-cta {
        color: var(--text) !important;
        padding: var(--sp-2) var(--sp-5);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-pill);
      }
      .nav-cta:hover { border-color: var(--purple); color: var(--purple-bright) !important; }
      .nav-cmdk {
        display: inline-flex; align-items: center; gap: var(--sp-2);
        padding: 6px 10px 6px 8px;
        border-radius: var(--radius-pill);
        border: 1px solid var(--line-strong);
        background: color-mix(in oklab, var(--purple) 5%, transparent);
        color: var(--muted);
        font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em;
        cursor: pointer;
        transition: border-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
      }
      .nav-cmdk svg { width: 13px; height: 13px; }
      .nav-cmdk:hover {
        border-color: var(--purple-bright);
        color: var(--purple-bright);
        background: color-mix(in oklab, var(--purple) 10%, transparent);
      }
      @media (max-width: 900px) {
        .nav-cmdk { display: none; }
      }

      .site-footer {
        padding: var(--sp-11) 0 var(--sp-8);
        margin-top: var(--sp-12);
        border-top: 1px solid var(--line);
      }
      .footer-inner {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: var(--sp-8);
        align-items: start;
      }
      @media (max-width: 760px) {
        .footer-inner { grid-template-columns: 1fr; gap: var(--sp-6); }
      }
      .footer-name {
        font-family: var(--font-display);
        font-style: italic;
        font-size: var(--text-lg);
        color: var(--text);
        margin-bottom: var(--sp-2);
      }
      .footer-role { color: var(--muted); font-size: var(--text-sm); }
      .footer-nav { display: flex; flex-direction: column; gap: var(--sp-3); }
      .footer-nav a {
        color: var(--muted); font-size: var(--text-sm);
        transition: color var(--dur-fast) var(--ease-out);
      }
      .footer-nav a:hover { color: var(--purple-bright); }
      .footer-meta { display: flex; flex-direction: column; gap: var(--sp-3); font-size: var(--text-sm); color: var(--muted); }
      .footer-meta a:hover { color: var(--purple-bright); }
      .footer-meta .mono {
        font-family: var(--font-mono); font-size: var(--text-xs);
        /* --muted (not --muted-2) so this small mono line passes WCAG AA on --bg. */
        color: var(--muted); margin-top: var(--sp-2);
      }

      @media (max-width: 760px) {
        .nav-links { gap: var(--sp-4); }
        .nav-links a:not(.nav-cta) { display: none; }
      }
    </style>
  </body>
</html>
