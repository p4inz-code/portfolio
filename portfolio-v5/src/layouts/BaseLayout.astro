---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import CommandPalette from '../components/features/CommandPalette.astro';
import APMark from '../components/APMark.astro';
import SideRail from '../components/SideRail.astro';
import LiveStats from '../components/LiveStats.astro';
import { SITE, NAV, CONTACT } from '../data/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  themeColor?: string;
}
const {
  title,
  description = SITE.description,
  // v5.12.0 fix: og.png was 404-ing (Cloudflare fell back to the homepage
  // HTML). Now points at /og.svg — a real designed 1200x630 card. Discord,
  // Slack, iMessage, Signal, Telegram accept SVG og:image. LinkedIn + X
  // prefer PNG; if you need those, run svgexport over public/og.svg and
  // drop the PNG at public/og.png — the layout falls back to the SVG.
  ogImage = "/og.png",
  themeColor = "#0A0517",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;

// Structured data (JSON-LD) — helps Google, Bing, and LLM crawlers
// resolve "p4inz" / "p4inz github" queries back to Atharva Patil, and
// ties the site + person + studio + external repos together as one
// entity graph. The Person node is the anchor; WebSite + Organization
// reference it via @id. Emitted on every page so social/AI previews
// on any deep link resolve correctly.
const person = {
  '@type': 'Person',
  '@id': 'https://atharvapatil.tech/#person',
  name: 'Atharva Patil',
  alternateName: ['p4inz', 'p4inz-code'],
  url: 'https://atharvapatil.tech/',
  image: 'https://atharvapatil.tech/og.png',
  jobTitle: SITE.role,
  worksFor: { '@id': 'https://atharvapatil.tech/#studio' },
  email: `mailto:${CONTACT.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Navi Mumbai',
    addressRegion: 'Maharashtra',
    addressCountry: 'IN',
  },
  alumniOf: {
    '@type': 'EducationalOrganization',
    name: 'D. Y. Patil University',
  },
  knowsAbout: [
    'Software engineering',
    'Windows desktop development',
    'Linux systems',
    '3D animation',
    'Visual effects',
    'Privacy-first design',
    'Applied cryptography',
  ],
  sameAs: [
    CONTACT.github,
    CONTACT.discordInvite,
    'https://github.com/p4inz-code/mission-os',
    'https://github.com/p4inz-code/nexus-desktop',
    'https://github.com/p4inz-code/kanvaz',
    'https://github.com/p4inz-code/pursue-os',
  ],
};

const studio = {
  '@type': 'Organization',
  '@id': 'https://atharvapatil.tech/#studio',
  name: SITE.studio,
  url: 'https://atharvapatil.tech/',
  founder: { '@id': 'https://atharvapatil.tech/#person' },
  foundingDate: SITE.studioFounded,
  location: {
    '@type': 'Place',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Navi Mumbai',
      addressCountry: 'IN',
    },
  },
};

const website = {
  '@type': 'WebSite',
  '@id': 'https://atharvapatil.tech/#website',
  url: 'https://atharvapatil.tech/',
  name: `${SITE.title} — ${SITE.tagline}`,
  description: SITE.description,
  inLanguage: 'en',
  author: { '@id': 'https://atharvapatil.tech/#person' },
  publisher: { '@id': 'https://atharvapatil.tech/#studio' },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [person, studio, website],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content={themeColor} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F3EDDD" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.title} — ${SITE.tagline}`} />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- v5.12.0 fix: explicit twitter:image, don't rely on X falling
         back to og:image (unreliable). -->
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:image:alt" content={`${SITE.title} — ${SITE.tagline}`} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#7B3FE4" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="me" href={CONTACT.github} />
    <link rel="me" href={`mailto:${CONTACT.email}`} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} — changelog`} href="/feed.xml" />
    <!-- v5.16.0 SEO audit fix: reference llms.txt from head for AI-crawler
         discovery (audit said "no llms.txt reference"). -->
    <link rel="alternate" type="text/plain" title="llms.txt — AI-readable content index" href="/llms.txt" />
    <link rel="search" type="application/opensearchdescription+xml" title="Atharva Patil" href="/opensearch.xml" />
    <link rel="author" href="/humans.txt" />
    <link rel="license" href="/LICENSE" />
    <meta name="application-name" content={SITE.title} />
    <meta name="apple-mobile-web-app-title" content={SITE.title} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="msapplication-TileColor" content="#0A0517" />
    <meta name="msapplication-config" content="/browserconfig.xml" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="author" content={SITE.title} />

    <!-- Structured data — Person / Organization / WebSite entity graph.
         Ties p4inz / p4inz-code / Atharva Patil / Northbyte Studios into
         one linked graph so search + LLM crawlers resolve consistently. -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- v5.12.0 fix: dropped the two Google Fonts preconnects — the site
         no longer loads any Google Fonts (Neue Machina / Neue Montreal /
         Supply Mono are all Fontshare). Dead connections cost DNS+TLS
         handshakes for nothing.
         Also v5.12.0 fix: font stylesheet moved from a CSS @import (which
         was render-blocking and hidden from the preloader) to a real
         <link rel=stylesheet> here so the browser can discover + fetch
         it in parallel with the page HTML. FCP/LCP win on the hero. -->
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=neue-machina@400,500,700,800&f[]=neue-montreal@400,500,italic&f[]=supply-mono@400,500&display=swap" />

    <script is:inline>
      // ---- Shared diagnostics core (v5.17.0) ----
      // One in-memory log every interactive island reports into instead of
      // swallowing errors silently. Nothing here is persisted or sent
      // anywhere — it exists only so the live-stats widget can show real
      // caught-and-recovered errors instead of a hardcoded "0 issues"
      // claim. Defined first, before any other inline script, so it's
      // always available by the time a component needs it.
      window.__nbDiag = (function () {
        var entries = [];
        var MAX = 40;
        function log(component, message, opts) {
          opts = opts || {};
          var entry = {
            t: Date.now(),
            component: component,
            message: message,
            recovered: opts.recovered !== false,
          };
          entries.unshift(entry);
          if (entries.length > MAX) entries.length = MAX;
          try {
            document.dispatchEvent(new CustomEvent('nb-diag', { detail: entry }));
          } catch (e) { /* CustomEvent unsupported — widget will just miss the live update */ }
          return entry;
        }
        return { entries: entries, log: log };
      })();

      // Safety net for anything that throws without a local try/catch.
      // Deduped by message so a loop-firing error doesn't flood the log.
      (function () {
        var seen = {};
        function safeLog(message, component) {
          if (seen[message]) return;
          seen[message] = true;
          window.__nbDiag.log(component, message, { recovered: false });
        }
        window.addEventListener('error', function (e) {
          safeLog((e && e.message) || 'Unknown script error', 'window');
        });
        window.addEventListener('unhandledrejection', function (e) {
          var reason = e && e.reason;
          var msg = (reason && (reason.message || String(reason))) || 'Unhandled promise rejection';
          safeLog(msg, 'window');
        });
      })();

      (function () {
        try {
          const stored = localStorage.getItem('nb-theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const theme = stored || (prefersLight ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
          window.__nbDiag.log('theme', 'Stored theme preference unreadable (private browsing) — defaulted to dark', { recovered: true });
        }
      })();
    </script>
  </head>
  <body>
    <!-- Scroll progress bar — hairline at very top of viewport, fills as
         the page scrolls. Zero-JS: powered by CSS animation-timeline: scroll().
         Falls back to nothing (element stays at scaleX 0) on browsers without
         scroll-driven animations. Aria-hidden — decorative. -->
    <div class="scroll-progress" aria-hidden="true"></div>

    <a href="#main" class="skip-nav">Skip to content</a>

    <header class="nav">
      <div class="nav-inner wrap">
        <a href="/" class="brand" aria-label="Atharva Patil — home">
          <APMark size={38} />
          <span class="brand-name">Atharva Patil</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          {NAV.filter((n) => !n.cta).map((n) => (
            <a href={n.href} class:list={[currentPath === n.href && 'active']}>{n.label}</a>
          ))}
          {NAV.filter((n) => n.cta).map((n) => (
            <a href={n.href} class:list={['nav-cta', currentPath === n.href && 'active']}>{n.label}</a>
          ))}
          <button
            type="button"
            class="nav-cmdk"
            id="cmdkTrigger"
            aria-label="Open command palette (Ctrl+K)"
            title="Search & jump (Ctrl+K)"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"/>
              <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
          </button>
          <ThemeToggle />
        </nav>

        <!-- v5.12.0 fix: mobile drawer. Below 760px the desktop nav-links
             hide everything except the CTA. Was found by audit — 2 of 6
             primary sections were unreachable on mobile from the header
             AND the footer. -->
        <button
          type="button"
          class="nav-mobile-toggle"
          id="navMobileToggle"
          aria-label="Open navigation menu"
          aria-controls="navMobileDrawer"
          aria-expanded="false"
        >
          <span class="nmt-line"></span>
          <span class="nmt-line"></span>
          <span class="nmt-line"></span>
        </button>
      </div>
    </header>

    <!-- v5.17.0 fix: moved out of <header> — the header's backdrop-filter
         creates a new containing block for position:fixed descendants, so
         this drawer's inset:0 was resolving against the ~60px-tall header
         box instead of the viewport. Rendered squashed into a sliver near
         the top instead of covering the screen. Sibling of header now. -->
    <div class="nav-mobile-drawer" id="navMobileDrawer" hidden>
        <nav aria-label="Primary (mobile)">
          <ul role="list">
            {NAV.map((n) => (
              <li>
                <a href={n.href} class:list={[currentPath === n.href && 'active', n.cta && 'is-cta']}>
                  {n.label}
                </a>
              </li>
            ))}
            <li><a href="/status/">Status</a></li>
            <li><a href="/accessibility/">Accessibility</a></li>
          </ul>
          <div class="nav-mobile-utility">
            <button type="button" id="cmdkTriggerMobile" class="nmu-cmdk">
              <span>Search &amp; jump</span>
              <span class="nmu-kbd">⌘K</span>
            </button>
            <div class="nmu-theme"><ThemeToggle /></div>
          </div>
        </nav>
      </div>

    <script is:inline>
      (function () {
        const toggle = document.getElementById('navMobileToggle');
        const drawer = document.getElementById('navMobileDrawer');
        if (!toggle || !drawer) return;
        function open() {
          drawer.hidden = false;
          requestAnimationFrame(() => drawer.classList.add('open'));
          toggle.setAttribute('aria-expanded', 'true');
          toggle.classList.add('is-open');
          document.documentElement.style.overflow = 'hidden';
        }
        function close() {
          drawer.classList.remove('open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.classList.remove('is-open');
          document.documentElement.style.overflow = '';
          setTimeout(() => { drawer.hidden = true; }, 250);
        }
        toggle.addEventListener('click', () => {
          drawer.hidden ? open() : close();
        });
        drawer.addEventListener('click', (e) => {
          if (e.target && e.target.tagName === 'A') close();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !drawer.hidden) close();
        });
        const mCmdk = document.getElementById('cmdkTriggerMobile');
        const desktopCmdk = document.getElementById('cmdkTrigger');
        if (mCmdk && desktopCmdk) {
          mCmdk.addEventListener('click', () => {
            close();
            setTimeout(() => desktopCmdk.click(), 50);
          });
        }
      })();
    </script>

    <SideRail />
    <LiveStats />

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <!-- v5.16.0 trust strip — real numbers, addresses SEO audit
           E-E-A-T "no trust signals" warning. -->
      <div class="wrap">
        <ul class="trust-strip" role="list" aria-label="Trust signals">
          <li><span class="ts-num">10</span><span class="ts-label">Products in flight / shipped</span></li>
          <li><span class="ts-num">4,100+</span><span class="ts-label">Automated tests across products</span></li>
          <li><span class="ts-num">0</span><span class="ts-label">Telemetry on any product</span></li>
          <li><span class="ts-num">0</span><span class="ts-label">Third-party analytics on this site</span></li>
          <li><span class="ts-num">100%</span><span class="ts-label">Cloudflare-hosted · privacy-first</span></li>
        </ul>
      </div>

      <div class="wrap footer-inner">
        <div class="footer-brand">
          <p class="footer-name">Atharva Patil</p>
          <p class="footer-role">{SITE.role} · {SITE.location}</p>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          <a href="/work/">Work</a>
          <a href="/3d/">3D / VFX</a>
          <a href="/services/">Services</a>
          <a href="/about/">About</a>
          <a href="/resume/">Resume</a>
          <a href="/contact/">Contact</a>
          <a href="/status/">Status</a>
          <a href="/accessibility/">Accessibility</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
          <a href="/editorial/">Editorial policy</a>
        </nav>
        <div class="footer-meta">
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a href={CONTACT.github} target="_blank" rel="noopener noreferrer">{CONTACT.githubHandle}</a>
          <span class="mono">© 2026 · {SITE.currentVersion}</span>
        </div>
      </div>
    </footer>

    <CommandPalette />

    <style>
      /* Scroll progress bar */
      .scroll-progress {
        position: fixed;
        top: 0; left: 0; right: 0;
        height: 2px;
        z-index: 200;
        background: var(--purple-bright);
        transform-origin: 0 50%;
        transform: scaleX(0);
        pointer-events: none;
      }
      @supports (animation-timeline: scroll()) {
        .scroll-progress {
          animation: sp-fill linear both;
          animation-timeline: scroll(root block);
        }
      }
      @keyframes sp-fill {
        from { transform: scaleX(0); }
        to   { transform: scaleX(1); }
      }
      @media (prefers-reduced-motion: reduce) {
        .scroll-progress { animation: none; transform: scaleX(0); }
      }

      .nav {
        padding: var(--sp-5) 0;
        position: sticky; top: 0; z-index: 100;
        backdrop-filter: blur(12px);
        background: color-mix(in oklab, var(--bg) 78%, transparent);
        border-bottom: 1px solid var(--line);
      }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-6); }
      .brand { display: inline-flex; align-items: center; gap: var(--sp-3); color: var(--text); transition: opacity var(--dur-fast) var(--ease-out); }
      .brand:hover { opacity: 0.85; }
      .brand-name { font-family: var(--font-display); font-size: var(--text-md); font-style: italic; }
      .nav-links { display: flex; align-items: center; gap: var(--sp-6); }
      .nav-links a {
        color: var(--muted); font-size: var(--text-sm);
        transition: color var(--dur-fast) var(--ease-out);
        position: relative;
      }
      .nav-links a:hover, .nav-links a.active { color: var(--text); }
      .nav-links a.active::after {
        content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 1px;
        background: var(--purple-bright); border-radius: 1px;
      }
      .nav-cta {
        color: var(--text) !important;
        padding: var(--sp-2) var(--sp-5);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-pill);
      }
      .nav-cta:hover { border-color: var(--purple); color: var(--purple-bright) !important; }
      /* v5.14.0 — clean icon-only search button, no pill / no ⌘K label /
         no border. Reads as an intentional tool, not chrome-on-chrome. */
      .nav-cmdk {
        display: inline-flex; align-items: center; justify-content: center;
        width: 34px; height: 34px;
        padding: 0;
        background: transparent;
        border: none;
        color: var(--muted);
        cursor: pointer;
        border-radius: 4px;
        transition: color var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
      }
      .nav-cmdk svg { width: 18px; height: 18px; }
      .nav-cmdk:hover, .nav-cmdk:focus-visible {
        color: var(--purple-bright);
        background: color-mix(in oklab, var(--purple) 10%, transparent);
        outline: none;
      }
      .nav-cmdk:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 2px; }
      @media (max-width: 900px) {
        .nav-cmdk { display: none; }
      }

      .site-footer {
        padding: var(--sp-10) 0 var(--sp-8);
        margin-top: var(--sp-12);
        border-top: 1px solid var(--line);
      }
      /* v5.16.0 trust strip — real numbers, addresses SEO E-E-A-T warning */
      .trust-strip {
        list-style: none; padding: 0; margin: 0 0 var(--sp-9);
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1px;
        background: var(--line);
        border: 1px solid var(--line);
        border-radius: 4px;
        overflow: hidden;
      }
      @media (max-width: 900px) {
        .trust-strip { grid-template-columns: 1fr 1fr; }
      }
      @media (max-width: 480px) {
        .trust-strip { grid-template-columns: 1fr; }
      }
      .trust-strip li {
        background: var(--surface-1);
        padding: var(--sp-5) var(--sp-4);
        display: flex; flex-direction: column; gap: 4px;
      }
      .ts-num {
        font-family: var(--font-display);
        font-size: var(--text-xl);
        font-weight: 500;
        color: var(--text);
        letter-spacing: -0.02em;
        line-height: 1;
      }
      .ts-label {
        font-family: var(--font-mono);
        font-size: 10.5px;
        letter-spacing: var(--tracking-eyebrow);
        text-transform: uppercase;
        color: var(--muted);
      }
      .footer-inner {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: var(--sp-8);
        align-items: start;
      }
      @media (max-width: 760px) {
        .footer-inner { grid-template-columns: 1fr; gap: var(--sp-6); }
      }
      .footer-name {
        font-family: var(--font-display);
        font-style: italic;
        font-size: var(--text-lg);
        color: var(--text);
        margin-bottom: var(--sp-2);
      }
      .footer-role { color: var(--muted); font-size: var(--text-sm); }
      .footer-nav { display: flex; flex-direction: column; gap: var(--sp-3); }
      .footer-nav a {
        color: var(--muted); font-size: var(--text-sm);
        transition: color var(--dur-fast) var(--ease-out);
      }
      .footer-nav a:hover { color: var(--purple-bright); }
      .footer-meta { display: flex; flex-direction: column; gap: var(--sp-3); font-size: var(--text-sm); color: var(--muted); }
      .footer-meta a:hover { color: var(--purple-bright); }
      .footer-meta .mono {
        font-family: var(--font-mono); font-size: var(--text-xs);
        /* --muted (not --muted-2) so this small mono line passes WCAG AA on --bg. */
        color: var(--muted); margin-top: var(--sp-2);
      }

      /* v5.12.0 mobile navigation drawer */
      .nav-mobile-toggle {
        display: none;
        width: 40px; height: 40px;
        padding: 0;
        background: transparent; border: 1px solid var(--line-strong);
        border-radius: 4px;
        color: var(--text);
        cursor: pointer;
        flex-direction: column; align-items: center; justify-content: center;
        gap: 4px;
      }
      .nav-mobile-toggle:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 2px; }
      .nmt-line {
        display: block;
        width: 18px; height: 1.5px;
        background: currentColor;
        transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
      }
      .nav-mobile-toggle.is-open .nmt-line:nth-child(1) { transform: translateY(5.5px) rotate(45deg); }
      .nav-mobile-toggle.is-open .nmt-line:nth-child(2) { opacity: 0; }
      .nav-mobile-toggle.is-open .nmt-line:nth-child(3) { transform: translateY(-5.5px) rotate(-45deg); }

      .nav-mobile-drawer {
        position: fixed;
        inset: 0;
        z-index: 150;
        background: color-mix(in oklab, var(--bg) 96%, transparent);
        backdrop-filter: blur(20px);
        padding: 100px var(--sp-6) var(--sp-6);
        opacity: 0;
        transition: opacity var(--dur) var(--ease-out);
      }
      .nav-mobile-drawer.open { opacity: 1; }
      .nav-mobile-drawer[hidden] { display: none; }
