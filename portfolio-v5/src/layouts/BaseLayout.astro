---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import CommandPalette from '../components/features/CommandPalette.astro';
import { SITE, NAV, CONTACT } from '../data/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  themeColor?: string;
}
const {
  title,
  description = SITE.description,
  ogImage = "/og.png",
  themeColor = "#0A0517",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta name="theme-color" content={themeColor} media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F3EDDD" media="(prefers-color-scheme: light)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />

    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('nb-theme');
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          const theme = stored || (prefersLight ? 'light' : 'dark');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-nav">Skip to content</a>

    <header class="nav">
      <div class="nav-inner wrap">
        <a href="/" class="brand" aria-label="Atharva Patil — home">
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 19V5l9 12V5M14 19h5" />
            </svg>
          </span>
          <span class="brand-name">Atharva Patil</span>
        </a>
        <nav class="nav-links" aria-label="Primary">
          {NAV.filter((n) => !n.cta).map((n) => (
            <a href={n.href} class:list={[currentPath === n.href && 'active']}>{n.label}</a>
          ))}
          {NAV.filter((n) => n.cta).map((n) => (
            <a href={n.href} class:list={['nav-cta', currentPath === n.href && 'active']}>{n.label}</a>
          ))}
          <button
            type="button"
            class="nav-cmdk"
            id="cmdkTrigger"
            aria-label="Open command palette (Ctrl+K)"
            title="Search & jump (Ctrl+K)"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
              <circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
            </svg>
            <span>⌘K</span>
          </button>
          <ThemeToggle />
        </nav>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <p class="footer-name">Atharva Patil</p>
          <p class="footer-role">{SITE.role} · {SITE.location}</p>
        </div>
        <nav class="footer-nav" aria-label="Footer">
          <a href="/work">Work</a>
          <a href="/about">About</a>
          <a href="/resume">Resume</a>
          <a href="/contact">Contact</a>
          <a href="/status">Status</a>
          <a href="/accessibility">Accessibility</a>
        </nav>
        <div class="footer-meta">
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a href={CONTACT.github} target="_blank" rel="noopener noreferrer">{CONTACT.githubHandle}</a>
          <span class="mono">© 2026 · {SITE.currentVersion}</span>
        </div>
      </div>
    </footer>

    <CommandPalette />

    <style>
      .nav {
        padding: var(--sp-5) 0;
        position: sticky; top: 0; z-index: 100;
        backdrop-filter: blur(12px);
        background: color-mix(in oklab, var(--bg) 78%, transparent);
        border-bottom: 1px solid var(--line);
      }
      .nav-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-6); }
      .brand { display: inline-flex; align-items: center; gap: var(--sp-3); color: var(--text); }
      .brand-mark {
        width: 34px; height: 34px;
        display: inline-flex; align-items: center; justify-content: center;
        border-radius: 50%; border: 1px solid var(--line-strong);
        color: var(--purple-bright);
      }
      .brand-mark svg { width: 16px; height: 16px; }
      .brand-name { font-family: var(--font-display); font-size: var(--text-md); font-style: italic; }
      .nav-links { display: flex; align-items: center; gap: var(--sp-6); }
      .nav-links a {
        color: var(--muted); font-size: var(--text-sm);
        transition: color var(--dur-fast) var(--ease-out);
        position: relative;
      }
      .nav-links a:hover, .nav-links a.active { color: var(--text); }
      .nav-links a.active::after {
        content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 1px;
        background: var(--purple-bright); border-radius: 1px;
      }
      .nav-cta {
        color: var(--text) !important;
        padding: var(--sp-2) var(--sp-5);
        border: 1px solid var(--line-strong);
        border-radius: var(--radius-pill);
      }
      .nav-cta:hover { border-color: var(--purple); color: var(--purple-bright) !important; }
      .nav-cmdk {
        display: inline-flex; align-items: center; gap: var(--sp-2);
        padding: 6px 10px 6px 8px;
        border-radius: var(--radius-pill);
        border: 1px solid var(--line-strong);
        background: color-mix(in oklab, var(--purple) 5%, transparent);
        color: var(--muted);
        font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em;
        cursor: pointer;
        transition: border-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out), background var(--dur) var(--ease-out);
      }
      .nav-cmdk svg { width: 13px; height: 13px; }
      .nav-cmdk:hover {
        border-color: var(--purple-bright);
        color: var(--purple-bright);
        background: color-mix(in oklab, var(--purple) 10%, transparent);
      }
      @media (max-width: 900px) {
        .nav-cmdk { display: none; }
      }

      .site-footer {
        padding: var(--sp-11) 0 var(--sp-8);
        margin-top: var(--sp-12);
        border-top: 1px solid var(--line);
      }
      .footer-inner {
        display: grid;
        grid-template-columns: 1.4fr 1fr 1fr;
        gap: var(--sp-8);
        align-items: start;
      }
      @media (max-width: 760px) {
        .footer-inner { grid-template-columns: 1fr; gap: var(--sp-6); }
      }
      .footer-name {
        font-family: var(--font-display);
        font-style: italic;
        font-size: var(--text-lg);
        color: var(--text);
        margin-bottom: var(--sp-2);
      }
      .footer-role { color: var(--muted); font-size: var(--text-sm); }
      .footer-nav { display: flex; flex-direction: column; gap: var(--sp-3); }
      .footer-nav a {
        color: var(--muted); font-size: var(--text-sm);
        transition: color var(--dur-fast) var(--ease-out);
      }
      .footer-nav a:hover { color: var(--purple-bright); }
      .footer-meta { display: flex; flex-direction: column; gap: var(--sp-3); font-size: var(--text-sm); color: var(--muted); }
      .footer-meta a:hover { color: var(--purple-bright); }
      .footer-meta .mono {
        font-family: var(--font-mono); font-size: var(--text-xs);
        /* --muted (not --muted-2) so this small mono line passes WCAG AA on --bg. */
        color: var(--muted); margin-top: var(--sp-2);
      }

      @media (max-width: 760px) {
        .nav-links { gap: var(--sp-4); }
        .nav-links a:not(.nav-cta) { display: none; }
      }
    </style>
  </body>
</html>
