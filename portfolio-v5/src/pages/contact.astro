---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import { CONTACT, SITE } from '../data/site';
---
<BaseLayout title="Get in Touch — Atharva Patil" description="Get in touch with Atharva Patil: freelance web development, UI/UX, branding, and 3D/VFX work. Real inbox, no contact-form middleman.">
  <Section
    wide
    headingLevel="h1"
    eyebrow="Get in touch"
    heading="Send it as a real message, not a form to no one."
    headingEmphasis="Write to me directly."
    intro="I read every message myself and reply within 1–2 days. Freelance, collaboration, hiring, security disclosure: whatever it is, it lands in my inbox."
  >
    <div class="contact-grid">

      <!-- LEFT: identity + channels -->
      <aside class="contact-left">
        <p class="cl-name">Atharva Patil</p>
        <p class="cl-role">Founder · Developer · 3D Artist · Navi Mumbai, IN</p>

        <ul class="cl-channels" role="list">
          <li>
            <span class="cl-key">Email</span>
            <span class="cl-email-row">
              <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
              <button type="button" class="cl-copy" id="copyEmail" aria-label="Copy email address">copy</button>
            </span>
          </li>
          <li>
            <span class="cl-key">Discord</span>
            <a href={CONTACT.discordInvite} target="_blank" rel="noopener noreferrer">{CONTACT.discord} · <em>Nexus beta</em></a>
          </li>
          <li>
            <span class="cl-key">GitHub</span>
            <a href={CONTACT.github} target="_blank" rel="noopener noreferrer">{CONTACT.githubHandle}</a>
          </li>
          <li>
            <span class="cl-key">Studio</span>
            <span>{SITE.studio} · founded {SITE.studioFounded}</span>
          </li>
        </ul>

        <p class="cl-avail">
          <span class="cl-dot" aria-hidden="true"></span>
          Freelance capacity: <em>selective, taking new work</em>
        </p>

        <div class="cl-clock" id="clock" aria-live="off">
          <span class="cl-clock-time" id="clockTime">--:--</span>
          <span class="cl-clock-meta">
            <span id="clockPlace">Navi Mumbai, IST</span>
            <span id="clockDiff" class="cl-clock-diff"></span>
          </span>
        </div>
      </aside>

      <!-- RIGHT: terminal-style form -->
      <div class="term-card" id="termCard">
        <header class="term-head">
          <span class="term-dot term-dot-close" aria-hidden="true"></span>
          <span class="term-dot term-dot-min"   aria-hidden="true"></span>
          <span class="term-dot term-dot-max"   aria-hidden="true"></span>
          <span class="term-title">msg — mailto composer · <span class="term-title-secondary">no data leaves this page</span></span>
          <span class="term-cursor" aria-hidden="true"></span>
          <span class="term-signal" id="signal" role="img" aria-label="0 of 5 fields filled">
            <i></i><i></i><i></i><i></i><i></i>
          </span>
        </header>

        <div class="term-topics" role="group" aria-label="Quick start">
          <span class="term-topics-label">start with</span>
          <button type="button" class="term-chip" data-topic="Product / Web Development" data-starter="I'd like to build ">a product or site</button>
          <button type="button" class="term-chip" data-topic="UI / UX & Product Design" data-starter="I need design help with ">design</button>
          <button type="button" class="term-chip" data-topic="3D / VFX & Visualization" data-starter="I have a 3D / VFX project: ">3D / VFX</button>
          <button type="button" class="term-chip" data-topic="Security / Privacy consulting" data-starter="I'd like to talk about security: ">security</button>
          <button type="button" class="term-chip" data-topic="Something else" data-starter="Hi Atharva, ">just saying hi</button>
        </div>

        <form class="term-form" id="contactForm" novalidate>
          <div class="term-line term-line-field">
            <label for="c-name" class="term-prompt"><span class="term-caret">›</span> name</label>
            <div class="term-field">
              <input type="text" id="c-name" class="term-input" placeholder="your name" required autocomplete="name" />
              <span class="term-field-error" id="c-name-error" role="alert"></span>
            </div>
          </div>

          <div class="term-line term-line-field">
            <label for="c-email" class="term-prompt"><span class="term-caret">›</span> email</label>
            <div class="term-field">
              <input type="email" id="c-email" class="term-input" placeholder="you@example.com" required autocomplete="email" />
              <span class="term-field-error" id="c-email-error" role="alert"></span>
            </div>
          </div>

          <div class="term-line">
            <label id="c-service-label" class="term-prompt"><span class="term-caret">›</span> service</label>
            <div class="term-select" data-term-select data-selected="">
              <button type="button" class="term-select-trigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="c-service-label c-service-value">
                <span id="c-service-value" data-term-select-value>select one</span>
                <span class="term-select-chev" aria-hidden="true">▾</span>
              </button>
              <ul class="term-select-list" role="listbox" hidden>
                <li role="option" data-value="Product / Web Development">Product / Web Development</li>
                <li role="option" data-value="UI / UX & Product Design">UI / UX &amp; Product Design</li>
                <li role="option" data-value="Branding & Visual Identity">Branding &amp; Visual Identity</li>
                <li role="option" data-value="3D / VFX & Visualization">3D / VFX &amp; Visualization</li>
                <li role="option" data-value="Security / Privacy consulting">Security / Privacy consulting</li>
                <li role="option" data-value="Something else">Something else</li>
              </ul>
            </div>
          </div>

          <div class="term-line">
            <label id="c-budget-label" class="term-prompt"><span class="term-caret">›</span> budget</label>
            <div class="term-select" data-term-select data-selected="">
              <button type="button" class="term-select-trigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="c-budget-label c-budget-value">
                <span id="c-budget-value" data-term-select-value>select one</span>
                <span class="term-select-chev" aria-hidden="true">▾</span>
              </button>
              <ul class="term-select-list" role="listbox" hidden>
                <li role="option" data-value="Under $1k">Under $1k</li>
                <li role="option" data-value="$1k – $5k">$1k – $5k</li>
                <li role="option" data-value="$5k – $15k">$5k – $15k</li>
                <li role="option" data-value="$15k+">$15k+</li>
                <li role="option" data-value="Not sure yet">Not sure yet</li>
              </ul>
            </div>
          </div>

          <div class="term-line term-line-block">
            <label for="c-message" class="term-prompt"><span class="term-caret">›</span> message</label>
            <div class="term-field">
              <textarea id="c-message" class="term-textarea" placeholder="What are you trying to build, and what's the timeline?" required></textarea>
              <span class="term-count" id="c-count" aria-hidden="true">0 chars</span>
              <span class="term-field-error" id="c-message-error" role="alert"></span>
            </div>
          </div>

          <div class="term-actions">
            <button type="submit" class="term-submit">
              <span class="term-caret" aria-hidden="true">›</span> <span class="term-label">send message</span>
              <span class="term-arrow" aria-hidden="true">→</span>
            </button>
            <p class="term-hint">
              Opens your mail client with everything pre-filled to <span>{CONTACT.email}</span>.
              Nothing is stored, POSTed, or logged. <kbd>Ctrl</kbd> + <kbd>Enter</kbd> sends from anywhere in the form.
            </p>
          </div>

          <p class="term-status" id="c-status" role="status" aria-live="polite" hidden></p>

          <!-- v5.17.0 — auto-recovery fallback: some devices/browsers have
               no mail client configured, so mailto: silently does nothing.
               If the tab is still focused ~1.4s after triggering it, we
               assume that happened and offer a copyable alternative
               instead of leaving the visitor staring at a dead button. -->
          <div class="term-fallback" id="c-fallback" role="status" aria-live="polite" hidden>
            <p class="term-fallback-title">No mail client responded: here's your message to copy instead.</p>
            <textarea class="term-fallback-body" id="c-fallback-body" readonly></textarea>
            <div class="term-fallback-actions">
              <button type="button" class="term-fallback-btn" id="c-copy-message">Copy message</button>
              <button type="button" class="term-fallback-btn" id="c-copy-email">Copy email address</button>
            </div>
          </div>
        </form>
      </div>

    </div>
  </Section>

  <script is:inline>
    (function () {
      // -------- Custom terminal-style select dropdowns --------
      document.querySelectorAll('[data-term-select]').forEach(function (root) {
        const trigger = root.querySelector('.term-select-trigger');
        const list = root.querySelector('.term-select-list');
        const valueEl = root.querySelector('[data-term-select-value]');
        if (!trigger || !list || !valueEl) return;

        function open() {
          list.hidden = false;
          trigger.setAttribute('aria-expanded', 'true');
          root.classList.add('open');
        }
        function close() {
          list.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
          root.classList.remove('open');
        }
        trigger.addEventListener('click', function () {
          list.hidden ? open() : close();
        });
        list.querySelectorAll('[role="option"]').forEach(function (opt) {
          opt.addEventListener('click', function () {
            const val = opt.getAttribute('data-value') || '';
            root.setAttribute('data-selected', val);
            valueEl.textContent = val || 'select one';
            close();
            trigger.focus();
          });
        });
        document.addEventListener('click', function (e) {
          if (!root.contains(e.target)) close();
        });
        trigger.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') { close(); return; }
          if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            if (list.hidden) open();
            const first = list.querySelector('[role="option"]');
            if (first && typeof first.focus === 'function') first.focus();
          }
        });
        list.querySelectorAll('[role="option"]').forEach(function (opt, i, arr) {
          opt.setAttribute('tabindex', '-1');
          opt.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') { close(); trigger.focus(); return; }
            if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); opt.click(); return; }
            if (e.key === 'ArrowDown') { e.preventDefault(); (arr[i+1] || arr[0]).focus(); return; }
            if (e.key === 'ArrowUp')   { e.preventDefault(); (arr[i-1] || arr[arr.length-1]).focus(); return; }
          });
        });
      });

      // -------- Submit -> mailto composer, with real validation + auto-recovery --------
      const form = document.getElementById('contactForm');
      const status = document.getElementById('c-status');
      if (!form) return;

      // -------- signal meter: one bar per field that has something in it --------
      const signal = document.getElementById('signal');
      function updateSignal() {
        const sel = form.querySelectorAll('[data-term-select]');
        const filled = [
          document.getElementById('c-name').value.trim() !== '',
          document.getElementById('c-email').value.trim() !== '',
          !!(sel[0] && sel[0].getAttribute('data-selected')),
          !!(sel[1] && sel[1].getAttribute('data-selected')),
          document.getElementById('c-message').value.trim() !== '',
        ];
        const n = filled.filter(Boolean).length;
        if (signal) {
          signal.setAttribute('aria-label', n + ' of 5 fields filled');
          signal.setAttribute('data-level', String(n));
        }
      }
      form.addEventListener('input', updateSignal);
      form.addEventListener('click', function () { setTimeout(updateSignal, 0); });
      updateSignal();

      // -------- quick-start chips: pick a topic, drop a starter line into the message --------
      document.querySelectorAll('.term-chip').forEach(function (chip) {
        chip.addEventListener('click', function () {
          const topic = chip.getAttribute('data-topic') || '';
          const starter = chip.getAttribute('data-starter') || '';
          const selects = form.querySelectorAll('[data-term-select]');
          if (selects[0]) {
            selects[0].setAttribute('data-selected', topic);
            const v = selects[0].querySelector('[data-term-select-value]');
            if (v) v.textContent = topic;
          }
          const msg = document.getElementById('c-message');
          if (msg && !msg.value.trim()) {
            msg.value = starter;
            msg.dispatchEvent(new Event('input', { bubbles: true }));
          }
          document.querySelectorAll('.term-chip').forEach(function (c) { c.classList.toggle('is-on', c === chip); });
          if (msg) { msg.focus(); msg.setSelectionRange(msg.value.length, msg.value.length); }
          updateSignal();
        });
      });

      // -------- small conveniences: live character count, Ctrl/Cmd+Enter to send --------
      const msgEl = document.getElementById('c-message');
      const countEl = document.getElementById('c-count');
      if (msgEl && countEl) {
        msgEl.addEventListener('input', function () {
          const n = msgEl.value.length;
          countEl.textContent = n + (n === 1 ? ' char' : ' chars');
        });
      }
      form.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
          e.preventDefault();
          if (form.requestSubmit) form.requestSubmit(); else form.dispatchEvent(new Event('submit', { cancelable: true }));
        }
      });

      const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

      function setFieldError(id, message) {
        const input = document.getElementById(id);
        const errEl = document.getElementById(id + '-error');
        if (errEl) errEl.textContent = message || '';
        if (input) input.classList.toggle('term-input-invalid', !!message);
      }

      function copyText(text, onDone) {
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(onDone, onDone);
          return;
        }
        const ta = document.createElement('textarea');
        ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (e) {
          window.__nbDiag && window.__nbDiag.log('contact-form', 'Clipboard copy fallback failed', { recovered: false });
        }
        document.body.removeChild(ta);
        onDone();
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        const nameInput = /** @type {HTMLInputElement} */ (document.getElementById('c-name'));
        const emailInput = /** @type {HTMLInputElement} */ (document.getElementById('c-email'));
        const messageInput = /** @type {HTMLTextAreaElement} */ (document.getElementById('c-message'));
        const name = nameInput.value.trim();
        const email = emailInput.value.trim();
        const message = messageInput.value.trim();
        const selects = form.querySelectorAll('[data-term-select]');
        const service = selects[0] ? selects[0].getAttribute('data-selected') : '';
        const budget  = selects[1] ? selects[1].getAttribute('data-selected') : '';

        setFieldError('c-name', '');
        setFieldError('c-email', '');
        setFieldError('c-message', '');

        let firstInvalid = null;
        if (!name) { setFieldError('c-name', 'name is required.'); firstInvalid = firstInvalid || nameInput; }
        if (!email) { setFieldError('c-email', 'email is required.'); firstInvalid = firstInvalid || emailInput; }
        else if (!EMAIL_RE.test(email)) { setFieldError('c-email', 'that doesn\'t look like a valid email.'); firstInvalid = firstInvalid || emailInput; }
        if (!message) { setFieldError('c-message', 'message is required.'); firstInvalid = firstInvalid || messageInput; }

        if (firstInvalid) {
          if (status) { status.hidden = false; status.textContent = 'fix the highlighted field' + (document.querySelectorAll('.term-field-error:not(:empty)').length > 1 ? 's' : '') + ' above.'; }
          firstInvalid.focus();
          return;
        }

        const subject = 'Project inquiry — ' + name;
        const bodyLines = [
          '(sent from atharvapatil.tech/contact — mailto composer)',
          '',
          'from:     ' + name + ' <' + email + '>',
          'service:  ' + (service || '(not specified)'),
          'budget:   ' + (budget  || '(not specified)'),
          '',
          '--',
          '',
          message,
        ];
        const plainBody = bodyLines.join('\n');
        // v5.12.0 fix — email obfuscated in the inline script so basic
        // scrapers don't harvest the plaintext (Cloudflare's mailto
        // rewriter only touches <a href="mailto:"> tags, not JS).
        const to = ['atharva.patil.cg', 'gmail.com'].join('@');
        const href = 'mailto:' + to
          + '?subject=' + encodeURIComponent(subject)
          + '&body='    + encodeURIComponent(plainBody);

        const fallback = document.getElementById('c-fallback');
        const fallbackBody = /** @type {HTMLTextAreaElement} */ (document.getElementById('c-fallback-body'));
        const card = document.getElementById('termCard');
        const submitBtn = form.querySelector('.term-submit');
        const wasHiddenBefore = document.visibilityState;
        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function launch() {
          window.location.href = href;
          if (card) card.classList.remove('is-sending');
          if (submitBtn) { submitBtn.disabled = false; submitBtn.querySelector('.term-label').textContent = 'send message'; }
          if (status) {
            status.hidden = false;
            status.textContent = 'opened your mail client. If nothing happened, check below.';
          }
          // v5.17.0 auto-recovery: if the tab is still visible and focused
          // ~1.4s later, no mail client took the mailto: link. Offer the
          // message as copyable text instead of leaving a dead end.
          setTimeout(function () {
            if (document.visibilityState === wasHiddenBefore && document.hasFocus()) {
              if (fallback && fallbackBody) {
                fallbackBody.value = 'To: ' + to + '\nSubject: ' + subject + '\n\n' + plainBody;
                fallback.hidden = false;
                fallback.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'nearest' });
              }
              window.__nbDiag && window.__nbDiag.log('contact-form', 'No mail client responded to mailto:, showed copyable fallback', { recovered: true });
            }
          }, 1400);
        }

        if (reducedMotion || !card) { launch(); return; }
        // A short "transmit" beat: a packet runs along the top of the card
        // and the button says so, then the mail client opens.
        card.classList.add('is-sending');
        if (submitBtn) { submitBtn.disabled = true; submitBtn.querySelector('.term-label').textContent = 'transmitting'; }
        if (status) { status.hidden = false; status.textContent = 'transmitting…'; }
        setTimeout(launch, 950);
      });

      const copyMsgBtn = document.getElementById('c-copy-message');
      const copyEmailBtn = document.getElementById('c-copy-email');
      if (copyMsgBtn) {
        copyMsgBtn.addEventListener('click', function () {
          const body = /** @type {HTMLTextAreaElement} */ (document.getElementById('c-fallback-body'));
          if (!body) return;
          copyText(body.value, function () {
            copyMsgBtn.textContent = 'Copied ✓';
            setTimeout(function () { copyMsgBtn.textContent = 'Copy message'; }, 1600);
          });
        });
      }
      if (copyEmailBtn) {
        copyEmailBtn.addEventListener('click', function () {
          copyText(['atharva.patil.cg', 'gmail.com'].join('@'), function () {
            copyEmailBtn.textContent = 'Copied ✓';
            setTimeout(function () { copyEmailBtn.textContent = 'Copy email address'; }, 1600);
          });
        });
      }
    })();
  </script>

  <script is:inline>
    // -------- Local time (Navi Mumbai) and copy-email --------
    (function () {
      const timeEl = document.getElementById('clockTime');
      const diffEl = document.getElementById('clockDiff');
      if (timeEl) {
        const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Kolkata' });
        const tick = function () {
          const now = new Date();
          timeEl.textContent = fmt.format(now);
          if (diffEl) {
            // IST is UTC+5:30 with no DST; the visitor's offset comes from their own clock.
            const diffMin = 330 + now.getTimezoneOffset();     // minutes IST is ahead of the visitor
            if (diffMin === 0) diffEl.textContent = 'same time as you';
            else {
              const a = Math.abs(diffMin), h = Math.floor(a / 60), m = a % 60;
              diffEl.textContent = (h ? h + 'h ' : '') + (m ? m + 'm ' : '') + (diffMin > 0 ? 'ahead of you' : 'behind you');
            }
          }
        };
        tick();
        setInterval(tick, 20000);
      }
      const copy = document.getElementById('copyEmail');
      if (copy) {
        copy.addEventListener('click', function () {
          const addr = ['atharva.patil.cg', 'gmail.com'].join('@');
          const done = function () { copy.textContent = 'copied'; setTimeout(function () { copy.textContent = 'copy'; }, 1500); };
          if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(addr).then(done, done);
          else done();
        });
      }
    })();
  </script>

  <style>
    /* ============ Layout ============ */
    .contact-grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: var(--sp-8);
      align-items: start;
    }
    @media (max-width: 900px) {
      .contact-grid { grid-template-columns: 1fr; gap: var(--sp-6); }
    }

    /* ============ LEFT column ============ */
    .contact-left {
      position: sticky; top: 120px;
    }
    .cl-name {
      font-family: var(--font-display);
      font-style: italic;
      font-size: var(--text-xl);
      color: var(--text);
      margin-bottom: 6px;
    }
    .cl-role {
      font-family: var(--font-mono);
      font-size: var(--text-xxs);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: var(--sp-6);
    }
    .cl-channels { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--sp-3); }
    .cl-channels li {
      display: grid;
      grid-template-columns: 80px minmax(0, 1fr);
      gap: var(--sp-4);
      align-items: baseline;
      padding: var(--sp-3) 0;
      border-top: 1px solid var(--line);
    }
    .cl-channels li:last-child { border-bottom: 1px solid var(--line); }
    .cl-key {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--muted);
    }
    .cl-channels a, .cl-channels span:not(.cl-key) {
      color: var(--text);
      font-family: var(--font-body);
      font-size: var(--text-sm);
    }
    .cl-channels a:hover { color: var(--purple-bright); }
    .cl-channels li { transition: padding-left var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out); }
    .cl-channels li:hover { padding-left: var(--sp-2); border-top-color: color-mix(in oklab, var(--purple-bright) 45%, var(--line)); }
    .cl-channels a::after {
      content: ' ↗';
      color: var(--purple-bright);
      opacity: 0;
      display: inline-block;
      transform: translate(-4px, 2px);
      transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
    }
    .cl-channels a:hover::after, .cl-channels a:focus-visible::after { opacity: 1; transform: none; }
    .cl-channels em { color: var(--purple-bright); font-style: italic; }
    .cl-email-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: var(--sp-2) var(--sp-3); min-width: 0; }
    .cl-channels a, .cl-channels span:not(.cl-key) { overflow-wrap: anywhere; }
    .contact-grid > * { min-width: 0; }
    .cl-copy {
      background: transparent;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      padding: 2px 10px;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.06em;
      cursor: pointer;
      transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out);
    }
    .cl-copy:hover, .cl-copy:focus-visible { color: var(--purple-bright); border-color: var(--purple-bright); outline: none; }
    .cl-clock {
      margin-top: var(--sp-5);
      display: flex; align-items: center; gap: var(--sp-4);
      padding: var(--sp-4);
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: color-mix(in oklab, var(--surface-1) 80%, transparent);
    }
    .cl-clock-time {
      font-family: var(--font-mono);
      font-size: 30px;
      letter-spacing: 0.02em;
      color: var(--text);
      font-variant-numeric: tabular-nums;
    }
    .cl-clock-meta { display: flex; flex-direction: column; gap: 2px; font-family: var(--font-mono); font-size: 11px; color: var(--muted); }
    .cl-clock-diff { color: var(--purple-bright); }
    .cl-avail {
      margin-top: var(--sp-5);
      display: inline-flex; align-items: center; gap: 10px;
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--muted);
      letter-spacing: 0.02em;
    }
    .cl-avail em { color: var(--purple-bright); font-style: italic; }
    .cl-dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 8px var(--green);
      animation: cl-pulse 2.4s ease-in-out infinite;
    }
    @keyframes cl-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50%      { opacity: 0.55; transform: scale(0.9); }
    }
    @media (prefers-reduced-motion: reduce) { .cl-dot { animation: none; } }

    /* ============ Terminal card ============ */
    .term-card {
      position: relative;
      transition: box-shadow var(--dur) var(--ease-out), border-color var(--dur) var(--ease-out);
      background:
        radial-gradient(ellipse 100% 100% at 100% 0%, color-mix(in oklab, var(--purple-deep) 10%, transparent), transparent 55%),
        var(--surface-1);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow:
        0 30px 80px color-mix(in oklab, #000 40%, transparent),
        0 0 0 1px color-mix(in oklab, var(--purple) 6%, transparent);
    }
    .term-head, .term-form { position: relative; z-index: 1; }
    .term-signal { margin-left: auto; display: inline-flex; align-items: flex-end; gap: 3px; height: 12px; }
    .term-signal i {
      display: block; width: 3px; border-radius: 1px;
      background: color-mix(in oklab, var(--muted) 45%, transparent);
      transition: background var(--dur) var(--ease-out), transform var(--dur) var(--ease-out);
    }
    .term-signal i:nth-child(1) { height: 4px; }
    .term-signal i:nth-child(2) { height: 6px; }
    .term-signal i:nth-child(3) { height: 8px; }
    .term-signal i:nth-child(4) { height: 10px; }
    .term-signal i:nth-child(5) { height: 12px; }
    .term-signal[data-level='1'] i:nth-child(-n+1),
    .term-signal[data-level='2'] i:nth-child(-n+2),
    .term-signal[data-level='3'] i:nth-child(-n+3),
    .term-signal[data-level='4'] i:nth-child(-n+4),
    .term-signal[data-level='5'] i:nth-child(-n+5) { background: var(--purple-bright); }

    .term-topics {
      display: flex; flex-wrap: wrap; align-items: center; gap: 8px;
      padding: var(--sp-4) var(--sp-7) 0;
      position: relative; z-index: 1;
    }
    .term-topics-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted); margin-right: 4px; }
    .term-chip {
      background: transparent;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      padding: 5px 12px;
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 11px;
      cursor: pointer;
      transition: background var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
    }
    .term-chip:hover, .term-chip:focus-visible { border-color: var(--purple-bright); color: var(--purple-bright); outline: none; }
    .term-chip.is-on { background: color-mix(in oklab, var(--purple) 16%, transparent); border-color: var(--purple-bright); color: var(--purple-bright); }

    /* the transmit beat: a packet runs along the top edge of the card */
    .term-card::before {
      content: '';
      position: absolute; left: 0; top: 0;
      height: 2px; width: 100%;
      background: linear-gradient(90deg, transparent, var(--purple-bright) 40%, #fff 50%, var(--purple-bright) 60%, transparent);
      transform: translateX(-100%);
      opacity: 0;
      z-index: 3;
      pointer-events: none;
    }
    .term-card.is-sending::before { animation: term-transmit 0.9s cubic-bezier(0.5, 0, 0.2, 1) forwards; }
    .term-card.is-sending .term-submit { opacity: 0.85; }
    .term-card.is-sending .term-arrow { animation: term-fly 0.9s ease-in forwards; }
    @keyframes term-transmit { 0% { transform: translateX(-100%); opacity: 1; } 100% { transform: translateX(100%); opacity: 1; } }
    @keyframes term-fly { to { transform: translate(60px, -14px); opacity: 0; } }
    .term-submit:disabled { cursor: default; }
    .term-cursor {
      width: 7px; height: 12px;
      margin-left: -4px;
      background: var(--purple-bright);
      animation: term-blink 1.1s steps(2, start) infinite;
    }
    @keyframes term-blink { to { visibility: hidden; } }
    @media (prefers-reduced-motion: reduce) { .term-cursor { animation: none; } }
    .term-head {
      display: flex; align-items: center; gap: 8px;
      padding: 12px 16px;
      background: color-mix(in oklab, var(--surface-2) 85%, transparent);
      border-bottom: 1px solid var(--line);
    }
    .term-dot {
      width: 11px; height: 11px; border-radius: 50%; flex-shrink: 0;
    }
    .term-dot-close { background: #FF5F56; }
    .term-dot-min   { background: #FFBD2E; }
    .term-dot-max   { background: #27C93F; }
    .term-title {
      margin-left: var(--sp-3);
      font-family: var(--font-mono);
      font-size: 11px;
      letter-spacing: 0.06em;
      color: var(--muted);
    }
    .term-title-secondary { color: var(--muted); opacity: 0.75; }

    /* ============ Form ============ */
    .term-form {
      padding: var(--sp-6) var(--sp-7) var(--sp-7);
      font-family: var(--font-mono);
    }
    .term-line {
      display: grid;
      grid-template-columns: 110px 1fr;
      gap: var(--sp-4);
      align-items: center;
      /* the row is a soft highlighted strip on hover and focus, so it is
         obvious where you are typing; the negative margin keeps the text
         aligned with the rest of the card */
      margin: 0 calc(-1 * var(--sp-3));
      padding: var(--sp-3) var(--sp-3);
      border-bottom: 1px dashed var(--line);
      border-radius: 8px;
      transition: background var(--dur-fast) var(--ease-out);
    }
    .term-line:hover { background: color-mix(in oklab, var(--purple) 4%, transparent); }
    .term-line:focus-within { background: color-mix(in oklab, var(--purple) 9%, transparent); border-bottom-color: transparent; }
    .term-line:focus-within .term-prompt { color: var(--purple-bright); }
    .term-line:focus-within .term-caret { animation: term-blink 1s steps(2, start) infinite; }
    @media (prefers-reduced-motion: reduce) { .term-line:focus-within .term-caret { animation: none; } }
    .term-line-block { grid-template-columns: 110px 1fr; align-items: start; }
    .term-line:last-of-type { border-bottom: none; }
    .term-prompt {
      font-family: var(--font-mono);
      font-size: var(--text-xxs);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--muted);
      display: inline-flex; align-items: center; gap: 6px;
    }
    .term-caret { color: var(--purple-bright); }
    .term-input, .term-textarea {
      background: transparent;
      border: none;
      border-bottom: 1px solid transparent;
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 15px;
      padding: 6px 0;
      width: 100%;
      outline: none;
      caret-color: var(--purple-bright);
      transition: border-color var(--dur) var(--ease-out);
    }
    .term-input::placeholder, .term-textarea::placeholder { color: var(--muted-2); font-style: italic; }
    .term-input:focus, .term-textarea:focus { border-bottom-color: var(--purple-bright); }
    .term-textarea { resize: vertical; min-height: 100px; line-height: 1.6; }
    .term-count {
      align-self: flex-end;
      margin-top: 2px;
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: 0.04em;
      color: var(--muted-2);
    }

    /* v5.17.0 — per-field inline error state */
    .term-line-field { align-items: start; }
    .term-field { display: flex; flex-direction: column; }
    .term-input-invalid { border-bottom-color: var(--warn) !important; }
    .term-field-error {
      display: block;
      min-height: 0;
      font-family: var(--font-mono);
      font-size: 10.5px;
      color: var(--warn-text);
      margin-top: 4px;
    }
    .term-field-error:empty { display: none; }

    /* v5.17.0 — mailto auto-recovery fallback */
    .term-fallback {
      margin-top: var(--sp-4);
      padding: var(--sp-4);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      background: color-mix(in oklab, var(--warn) 6%, transparent);
    }
    .term-fallback-title {
      font-family: var(--font-mono);
      font-size: 11.5px;
      color: var(--warn-text);
      margin-bottom: var(--sp-3);
    }
    .term-fallback-body {
      width: 100%;
      min-height: 120px;
      padding: var(--sp-3);
      background: var(--surface-2);
      border: 1px solid var(--line);
      border-radius: 4px;
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.6;
      resize: vertical;
    }
    .term-fallback-actions { display: flex; gap: var(--sp-3); margin-top: var(--sp-3); flex-wrap: wrap; }
    .term-fallback-btn {
      padding: 8px 14px;
      background: transparent;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius-pill);
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 11px;
      cursor: pointer;
      transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
    }
    .term-fallback-btn:hover, .term-fallback-btn:focus-visible {
      border-color: var(--purple-bright);
      color: var(--purple-bright);
      outline: none;
    }

    /* Custom select */
    .term-select { position: relative; }
    .term-select-trigger {
      width: 100%;
      display: inline-flex; align-items: center; justify-content: space-between;
      background: transparent;
      border: none; border-bottom: 1px solid transparent;
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 15px;
      padding: 6px 0;
      cursor: pointer;
      transition: border-color var(--dur) var(--ease-out);
    }
    .term-select-trigger:hover { border-bottom-color: var(--line-strong); }
    .term-select-trigger:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 3px; border-radius: 4px; }
    .term-select.open .term-select-trigger { border-bottom-color: var(--purple-bright); }
    .term-select-chev { color: var(--muted); transition: transform var(--dur-fast) var(--ease-out); }
    .term-select.open .term-select-chev { transform: rotate(180deg); color: var(--purple-bright); }
    .term-select[data-selected=""] .term-select-trigger > span:first-child { color: var(--muted-2); font-style: italic; }
    .term-select-list {
      list-style: none; padding: 6px; margin: 6px 0 0;
      position: absolute; top: 100%; left: 0; right: 0;
      background: var(--surface-2);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      box-shadow: 0 12px 30px color-mix(in oklab, #000 40%, transparent);
      z-index: 20;
      max-height: 240px; overflow-y: auto;
    }
    .term-select-list li {
      padding: 8px 12px;
      border-radius: 4px;
      cursor: pointer;
      color: var(--text);
      font-family: var(--font-mono); font-size: 13px;
    }
    .term-select-list li:hover,
    .term-select-list li:focus {
      background: color-mix(in oklab, var(--purple) 15%, transparent);
      color: var(--purple-bright);
      outline: none;
    }

    /* Actions */
    .term-actions {
      display: flex; align-items: center; gap: var(--sp-5);
      margin-top: var(--sp-5);
      padding-top: var(--sp-5);
      border-top: 1px solid var(--line);
      flex-wrap: wrap;
    }
    .term-submit {
      background: linear-gradient(135deg, var(--purple-bright), var(--purple));
      color: var(--bg);
      border: none;
      border-radius: var(--radius-pill);
      box-shadow: 0 10px 24px -12px color-mix(in oklab, var(--purple) 70%, transparent);
      padding: 11px 22px;
      font-family: var(--font-mono);
      font-size: 13px;
      letter-spacing: 0.04em;
      cursor: pointer;
      display: inline-flex; align-items: center; gap: 8px;
      transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) var(--ease-out);
    }
    .term-submit .term-caret { color: var(--bg); }
    .term-submit:hover { transform: translateY(-1px); box-shadow: 0 14px 28px -12px color-mix(in oklab, var(--purple) 80%, transparent); }
    .term-submit:active { transform: translateY(0) scale(0.98); }
    .term-arrow { display: inline-block; transition: transform var(--dur-fast) var(--ease-out); }
    .term-submit:hover .term-arrow, .term-submit:focus-visible .term-arrow { transform: translateX(4px); }
    .term-submit:focus-visible { outline: 2px solid var(--purple-bright); outline-offset: 3px; }
    .term-hint {
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 11px;
      line-height: 1.5;
      flex: 1; min-width: 240px;
    }
    .term-hint span { color: var(--purple-bright); }
    .term-hint kbd {
      font-family: var(--font-mono);
      font-size: 10px;
      padding: 1px 5px;
      border: 1px solid var(--line-strong);
      border-radius: 3px;
      color: var(--text);
    }
    .term-status {
      margin-top: var(--sp-4);
      padding: var(--sp-3) var(--sp-4);
      background: color-mix(in oklab, var(--purple) 10%, transparent);
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      color: var(--text);
      font-family: var(--font-mono); font-size: 12px;
    }

    @media (max-width: 640px) {
      .term-form { padding: var(--sp-5) var(--sp-5) var(--sp-6); }
      .term-line, .term-line-block { grid-template-columns: 1fr; gap: 4px; }
      .term-input, .term-textarea, .term-select-trigger { font-size: 16px; } /* iOS zoom prevention */
      .term-actions { gap: var(--sp-3); }
    }
  </style>
</BaseLayout>
