---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import { SITE, CONTACT } from '../data/site';

// v5.17.4 resume redesign — curated selection, not the full roster.
// Matches Atharva_Patil_Resume.md exactly: prove engineering depth and
// ownership through the strongest projects, not every project that exists.
const primaryProjects = [
  {
    name: 'Nexus', tagline: 'Encrypted Personal Vault', period: 'Mar 2026 – Present · Windows Desktop',
    bullets: [
      'Built a Windows encrypted vault using AES-256-GCM authenticated encryption and Argon2id key derivation, with Windows Hello as a secondary unlock.',
      'Zero telemetry, zero cloud — content stays encrypted at rest and exists decrypted only in memory while the vault is unlocked.',
      'Rebuilt the entire v11 interface (lock screen, media browser, credentials, notes, settings, updater) without touching the cryptographic core underneath it.',
    ],
  },
  {
    name: 'Mission OS', tagline: 'Privacy-First Linux Distribution', period: '2026 – Present · Linux, GPLv3',
    bullets: [
      'Building a privacy-first Linux distribution on Debian Stable and KDE Plasma, with an installer that explains the trade-off of every advanced option next to the toggle instead of burying it in docs.',
      '141/141 pixel checks passed on the installer foundation, backed by 14 CTest and 13 runtime suites.',
    ],
  },
  {
    name: 'MINK', tagline: 'Programming Language', period: '2026 – In Development · Rust, Apache 2.0',
    bullets: [
      'Designing and building a compiled, general-purpose language from scratch — its own lexer, parser, type system, optimizer, and native code generator, producing a working executable with no external toolchain.',
      '878 compiler tests passing.',
    ],
  },
  {
    name: 'Pursue OS', tagline: 'Investigation-Focused Linux OS', period: '2026 – Present · Linux, Apache 2.0',
    bullets: [
      'Building a Linux OS for OSINT, DFIR, and evidence-driven investigation work, centered on two flagship surfaces: an Investigation Terminal and an Investigation Browser with integrated Tor.',
    ],
  },
];
const additionalProjects = [
  { name: 'Kanvaz', desc: 'Electron visual reference workspace for VFX artists · MIT · v4.2.2, final release' },
  { name: 'Obscura', desc: 'Luau AST toolkit for Roblox developers · MIT · v1.0.0, 340/340 tests passing' },
  { name: 'repo-map', desc: 'TypeScript engineering-intelligence CLI, published on npm · MIT · 870+ tests' },
];
---
<BaseLayout title={`Resume — ${SITE.title}`} description="Atharva Patil's resume — software engineer, founder of Northbyte Studios. Download as PDF or plain-text Markdown.">
  <div class="resume-wrap wrap">
    <header class="resume-header">
      <div class="resume-header-left">
        <h1 class="resume-name">Atharva Patil</h1>
        <p class="resume-role">Software engineer, <em>founder of Northbyte Studios</em></p>
        <div class="resume-meta">
          <div class="meta-item"><span class="meta-label">Email</span><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></div>
          <div class="meta-item"><span class="meta-label">GitHub</span><a href={CONTACT.github} target="_blank" rel="noopener noreferrer">{CONTACT.githubHandle}</a></div>
          <div class="meta-item"><span class="meta-label">Discord</span><span>{CONTACT.discord}</span></div>
          <div class="meta-item"><span class="meta-label">Based in</span><span>{SITE.location}</span></div>
        </div>
      </div>
      <div class="resume-header-actions">
        <a href="/resume/Atharva_Patil_Resume.pdf" class="resume-dl" download>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13M6 11l6 6 6-6M4 21h16"/></svg>
          Download PDF
        </a>
        <a href="/resume/Atharva_Patil_Resume.md" class="resume-dl resume-dl-ghost" download>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13M6 11l6 6 6-6M4 21h16"/></svg>
          Download Markdown
        </a>
        <span class="resume-updated">Updated 16 August 2026</span>
      </div>
    </header>

    <p class="resume-summary">Software engineer and product builder focused on desktop applications, developer tools, and systems programming. Founder of Northbyte Studios, where I independently design, build, test, and ship privacy-first software — currently an encrypted vault, two Linux distributions, and a compiled programming language.</p>

    <Section eyebrow="Experience" heading="Northbyte Studios — Founder & Independent Software Studio">
      <article class="experience-block">
        <p class="experience-period">2026 — Present · Navi Mumbai, India (remote-friendly)</p>
        <ul class="experience-bullets">
          <li>Own the full product cycle myself on every product below: direction, architecture, engineering, UI/UX, testing, and release.</li>
          <li>Every product ships on the same principles — no telemetry, trade-offs explained on-screen instead of buried in docs, free wherever the studio can afford it to be.</li>
        </ul>
      </article>
      <article class="experience-block">
        <p class="experience-org">Freelance — Web, UX &amp; Brand</p>
        <p class="experience-period">2025 — Present</p>
        <ul class="experience-bullets">
          <li>Independent client work in web development, UI/UX, and 3D/VFX visualization, including a full production website build for a performing-arts academy.</li>
        </ul>
      </article>
    </Section>

    <Section eyebrow="Selected projects" heading="What I've built and shipped.">
      <div class="proj-list">
        {primaryProjects.map((p) => (
          <article class="proj-item">
            <div class="proj-item-head">
              <h3 class="proj-item-name">{p.name} <span class="proj-item-tagline">— {p.tagline}</span></h3>
              <span class="proj-item-period">{p.period}</span>
            </div>
            <ul class="proj-item-bullets">
              {p.bullets.map((b) => <li>{b}</li>)}
            </ul>
          </article>
        ))}
      </div>
      <div class="additional-list">
        <p class="additional-label">Additional projects</p>
        {additionalProjects.map((p) => (
          <p class="additional-row"><strong>{p.name}</strong> — {p.desc}</p>
        ))}
      </div>
    </Section>

    <Section eyebrow="Technical skills" heading="Stack & Tools">
      <div class="skills-grid">
        <div class="skill-block">
          <p class="skill-label">Languages</p>
          <p class="skill-value">C# · Rust · TypeScript · C / C++ · JavaScript · Lua / Luau</p>
        </div>
        <div class="skill-block">
          <p class="skill-label">Frameworks</p>
          <p class="skill-value">.NET 8 · WPF · Node.js · Astro · Qt / QML · Debian Linux</p>
        </div>
        <div class="skill-block">
          <p class="skill-label">Security</p>
          <p class="skill-value">AES-256-GCM · Argon2id · LUKS2 · TPM · Secure Boot · Windows Hello</p>
        </div>
        <div class="skill-block">
          <p class="skill-label">Tools</p>
          <p class="skill-value">Git / GitHub Actions · VS Code · FFmpeg · Cloudflare Pages</p>
        </div>
      </div>
    </Section>

    <Section eyebrow="Education" heading="B.Sc. Animation">
      <p class="education-line">D. Y. Patil University, Nerul, Navi Mumbai · 2025 – 2028, second year in progress</p>
    </Section>
  </div>

  <style>
    .resume-wrap { padding-top: var(--sp-9); }
    .resume-header {
      display: grid; grid-template-columns: 1fr auto; gap: var(--sp-8); align-items: end;
      padding-bottom: var(--sp-8); border-bottom: 1px solid var(--line);
      margin-bottom: var(--sp-9);
    }
    @media (max-width: 760px) { .resume-header { grid-template-columns: 1fr; gap: var(--sp-6); } }
    .resume-name {
      font-family: var(--font-display);
      font-size: clamp(48px, 7vw, 76px);
      font-weight: 400; font-style: italic;
      letter-spacing: -0.025em; line-height: 1.02;
      margin-bottom: var(--sp-4);
    }
    .resume-role {
      font-family: var(--font-display);
      font-size: clamp(16px, 1.6vw, 20px);
      color: var(--muted);
      margin-bottom: var(--sp-6);
    }
    .resume-role em { font-style: italic; color: var(--purple-bright); font-weight: 500; }
    .resume-meta {
      display: grid; grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-3) var(--sp-7);
      font-family: var(--font-display); font-size: var(--text-sm);
      color: var(--muted);
    }
    @media (max-width: 640px) { .resume-meta { grid-template-columns: 1fr; } }
    .meta-item { display: flex; flex-direction: column; gap: 2px; }
    .meta-label {
      font-family: var(--font-mono); font-size: 10px;
      letter-spacing: var(--tracking-eyebrow); text-transform: uppercase;
      color: var(--muted-2);
    }
    .meta-item a { color: var(--text); border-bottom: 1px solid transparent; transition: border-color var(--dur) var(--ease-out); }
    .meta-item a:hover { border-bottom-color: var(--purple-bright); color: var(--purple-bright); }
    .resume-header-actions {
      display: flex; flex-direction: column; gap: var(--sp-3); align-items: flex-end;
    }
    @media (max-width: 760px) { .resume-header-actions { flex-direction: row; flex-wrap: wrap; } }
    .resume-dl {
      display: inline-flex; align-items: center; gap: var(--sp-2);
      padding: var(--sp-3) var(--sp-5); border-radius: var(--radius-pill);
      border: 1px solid var(--line-strong);
      background: color-mix(in oklab, var(--purple) 5%, transparent);
      color: var(--text); font-family: var(--font-display); font-size: var(--text-sm);
      transition: border-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
    }
    .resume-dl:hover { border-color: var(--purple-bright); color: var(--purple-bright); }
    .resume-dl svg { width: 14px; height: 14px; }
    .resume-updated {
      font-family: var(--font-mono); font-size: var(--text-xxs);
      letter-spacing: var(--tracking-eyebrow); text-transform: uppercase;
      color: var(--muted-2);
    }
    .resume-summary {
      max-width: var(--wrap-narrow);
      color: var(--muted); font-size: var(--text-md);
      line-height: var(--leading-body);
      margin-bottom: var(--sp-11);
    }
    .resume-summary strong { color: var(--text); font-weight: 500; }
    .experience-block { padding-bottom: var(--sp-5); }
    .experience-block + .experience-block { margin-top: var(--sp-5); padding-top: var(--sp-5); border-top: 1px solid var(--line); }
    .experience-org { font-family: var(--font-display); font-size: var(--text-md); font-weight: 500; }
    .experience-period { font-family: var(--font-mono); font-size: var(--text-xxs); color: var(--muted-2); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; margin: 2px 0 var(--sp-3); }
    .experience-bullets { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--sp-2); max-width: var(--wrap-narrow); }
    .experience-bullets li { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); padding-left: var(--sp-4); position: relative; }
    .experience-bullets li::before { content: ''; position: absolute; left: 0; top: 10px; width: 8px; height: 1px; background: var(--purple-bright); }

    .proj-list { display: flex; flex-direction: column; gap: var(--sp-5); }
    .proj-item { padding: var(--sp-6); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface-1); }
    .proj-item-head { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-4); margin-bottom: var(--sp-3); flex-wrap: wrap; }
    .proj-item-name { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 500; }
    .proj-item-tagline { font-weight: 400; color: var(--muted); font-size: var(--text-sm); }
    .proj-item-period { font-family: var(--font-mono); font-size: var(--text-xxs); letter-spacing: var(--tracking-mono); text-transform: uppercase; color: var(--purple-bright); white-space: nowrap; }
    .proj-item-bullets { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--sp-2); }
    .proj-item-bullets li { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); padding-left: var(--sp-4); position: relative; }
    .proj-item-bullets li::before { content: ''; position: absolute; left: 0; top: 10px; width: 8px; height: 1px; background: var(--purple-bright); }

    .additional-list { margin-top: var(--sp-6); padding-top: var(--sp-5); border-top: 1px solid var(--line); }
    .additional-label { font-family: var(--font-mono); font-size: var(--text-xxs); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted-2); margin-bottom: var(--sp-3); }
    .additional-row { color: var(--muted); font-size: var(--text-sm); line-height: 1.8; }
    .additional-row strong { color: var(--text); font-weight: 500; }

    .skills-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-5); }
    @media (max-width: 760px) { .skills-grid { grid-template-columns: 1fr; } }
    .skill-block { padding: var(--sp-5); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface-1); }
    .skill-label { font-family: var(--font-mono); font-size: var(--text-xxs); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted-2); margin-bottom: var(--sp-3); }
    .skill-value { color: var(--text); font-size: var(--text-sm); line-height: var(--leading-body); }

    .education-line { color: var(--muted); font-size: var(--text-sm); }
  </style>
</BaseLayout>
