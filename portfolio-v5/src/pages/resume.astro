---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import Button from '../components/ui/Button.astro';
import { SITE, CONTACT } from '../data/site';
import { FEATURED_PROJECTS, SUPPORTING_PROJECTS } from '../data/projects';
---
<BaseLayout title={`Resume — ${SITE.title}`}>
  <div class="resume-wrap wrap">
    <header class="resume-header">
      <div class="resume-header-left">
        <h1 class="resume-name">Atharva Patil</h1>
        <p class="resume-role">Software engineer, <em>founder of Northbyte Studios</em></p>
        <div class="resume-meta">
          <div class="meta-item"><span class="meta-label">Email</span><a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></div>
          <div class="meta-item"><span class="meta-label">GitHub</span><a href={CONTACT.github} target="_blank" rel="noopener noreferrer">{CONTACT.githubHandle}</a></div>
          <div class="meta-item"><span class="meta-label">Discord</span><span>{CONTACT.discord}</span></div>
          <div class="meta-item"><span class="meta-label">Based in</span><span>{SITE.location}</span></div>
        </div>
      </div>
      <div class="resume-header-actions">
        <a href="/resume/Atharva_Patil_Resume.pdf" class="resume-dl" download>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13M6 11l6 6 6-6M4 21h16"/></svg>
          Download PDF
        </a>
        <a href="/resume/Atharva_Patil_Resume.md" class="resume-dl" download>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v13M6 11l6 6 6-6M4 21h16"/></svg>
          Download MD
        </a>
        <span class="resume-updated">Updated August 2026 · v3.0</span>
      </div>
    </header>

    <p class="resume-summary">Software engineer focused on desktop applications, developer tooling, and product engineering. I build software from architecture through production, combining engineering, UI/UX, testing, documentation, branding, and long-term maintenance. My work emphasizes <strong>privacy, performance, maintainability, and developer experience.</strong></p>

    <Section eyebrow="Experience" heading="Founder & Software Engineer">
      <article class="experience-block">
        <p class="experience-org">Northbyte Studios</p>
        <p class="experience-period">June 2026 — Present</p>
        <p class="experience-desc">Independent software studio developing desktop applications, engineering platforms, creative software, and open-source systems. Full-cycle ownership: architecture, product engineering, UI/UX, testing & QA, documentation, branding, and release engineering.</p>
      </article>
    </Section>

    <Section eyebrow="Core systems" heading="Featured Work">
      <div class="proj-list">
        {FEATURED_PROJECTS.map((p) => (
          <article class="proj-item">
            <div class="proj-item-head">
              <h3 class="proj-item-name">{p.name}</h3>
              <span class="proj-item-status">{p.status.label}</span>
            </div>
            <p class="proj-item-desc">{p.description}</p>
            {p.stack && (
              <p class="proj-item-stack">
                {p.stack.map((s, i) => <><span>{s}</span>{i < p.stack!.length - 1 && <span class="dot">·</span>}</>)}
              </p>
            )}
          </article>
        ))}
      </div>
    </Section>

    <Section eyebrow="Active systems" heading="Supporting Work">
      <div class="tier2-grid">
        {SUPPORTING_PROJECTS.map((p) => (
          <article class="tier2-card">
            <div class="tier2-head">
              <h3 class="tier2-name">{p.name}</h3>
              <span class="tier2-status">{p.status.label}</span>
            </div>
            <p class="tier2-desc">{p.description}</p>
          </article>
        ))}
      </div>
    </Section>

    <Section eyebrow="Technical skills" heading="Stack & Tools">
      <div class="skills-grid">
        <div class="skill-block">
          <p class="skill-label">Languages</p>
          <p class="skill-value">C# · TypeScript · JavaScript · HTML · CSS · Luau</p>
        </div>
        <div class="skill-block">
          <p class="skill-label">Runtimes / frameworks</p>
          <p class="skill-value">.NET 8 · WPF · Avalonia · Electron · Node.js · Astro</p>
        </div>
        <div class="skill-block">
          <p class="skill-label">Systems + platforms</p>
          <p class="skill-value">Windows desktop · Linux (Debian + KDE Plasma) · Cloudflare Pages · GitHub Actions CI</p>
        </div>
        <div class="skill-block">
          <p class="skill-label">Security</p>
          <p class="skill-value">AES-256-GCM · Argon2id · SHA-256 · signed releases · offline-first architecture</p>
        </div>
      </div>
    </Section>

    <Section eyebrow="Education" heading="Academic Background">
      <article class="education-block">
        <p class="education-name">B.Sc. Animation</p>
        <p class="education-org">D. Y. Patil University · Expected 2028</p>
        <p class="education-desc">Studying VFX and 3D animation alongside independent software development.</p>
      </article>
    </Section>

    <Section eyebrow="Engineering principles" heading="How I Build">
      <div class="principles-grid">
        <p class="principle">Design + code, together</p>
        <p class="principle">Privacy-first, offline-first</p>
        <p class="principle">Evidence over assertions</p>
        <p class="principle">Long-term maintainability</p>
        <p class="principle">Developer experience matters</p>
        <p class="principle">Open source where appropriate</p>
      </div>
    </Section>
  </div>

  <style>
    .resume-wrap { padding-top: var(--sp-9); }
    .resume-header {
      display: grid; grid-template-columns: 1fr auto; gap: var(--sp-8); align-items: end;
      padding-bottom: var(--sp-8); border-bottom: 1px solid var(--line);
      margin-bottom: var(--sp-9);
    }
    @media (max-width: 760px) { .resume-header { grid-template-columns: 1fr; gap: var(--sp-6); } }
    .resume-name {
      font-family: var(--font-display);
      font-size: clamp(48px, 7vw, 76px);
      font-weight: 400; font-style: italic;
      letter-spacing: -0.025em; line-height: 1.02;
      margin-bottom: var(--sp-4);
    }
    .resume-role {
      font-family: var(--font-display);
      font-size: clamp(16px, 1.6vw, 20px);
      color: var(--muted);
      margin-bottom: var(--sp-6);
    }
    .resume-role em { font-style: italic; color: var(--purple-bright); font-weight: 500; }
    .resume-meta {
      display: grid; grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-3) var(--sp-7);
      font-family: var(--font-display); font-size: var(--text-sm);
      color: var(--muted);
    }
    @media (max-width: 640px) { .resume-meta { grid-template-columns: 1fr; } }
    .meta-item { display: flex; flex-direction: column; gap: 2px; }
    .meta-label {
      font-family: var(--font-mono); font-size: 10px;
      letter-spacing: var(--tracking-eyebrow); text-transform: uppercase;
      color: var(--muted-2);
    }
    .meta-item a { color: var(--text); border-bottom: 1px solid transparent; transition: border-color var(--dur) var(--ease-out); }
    .meta-item a:hover { border-bottom-color: var(--purple-bright); color: var(--purple-bright); }
    .resume-header-actions {
      display: flex; flex-direction: column; gap: var(--sp-3); align-items: flex-end;
    }
    @media (max-width: 760px) { .resume-header-actions { flex-direction: row; flex-wrap: wrap; } }
    .resume-dl {
      display: inline-flex; align-items: center; gap: var(--sp-2);
      padding: var(--sp-3) var(--sp-5); border-radius: var(--radius-pill);
      border: 1px solid var(--line-strong);
      background: color-mix(in oklab, var(--purple) 5%, transparent);
      color: var(--text); font-family: var(--font-display); font-size: var(--text-sm);
      transition: border-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
    }
    .resume-dl:hover { border-color: var(--purple-bright); color: var(--purple-bright); }
    .resume-dl svg { width: 14px; height: 14px; }
    .resume-updated {
      font-family: var(--font-mono); font-size: var(--text-xxs);
      letter-spacing: var(--tracking-eyebrow); text-transform: uppercase;
      color: var(--muted-2);
    }
    .resume-summary {
      max-width: var(--wrap-narrow);
      color: var(--muted); font-size: var(--text-md);
      line-height: var(--leading-body);
      margin-bottom: var(--sp-11);
    }
    .resume-summary strong { color: var(--text); font-weight: 500; }
    .experience-block { padding-bottom: var(--sp-4); }
    .experience-org { font-family: var(--font-display); font-size: var(--text-md); font-weight: 500; }
    .experience-period { font-family: var(--font-mono); font-size: var(--text-xxs); color: var(--muted-2); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; margin: var(--sp-2) 0 var(--sp-3); }
    .experience-desc { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); max-width: var(--wrap-narrow); }
    .proj-list { display: flex; flex-direction: column; gap: var(--sp-5); }
    .proj-item { padding: var(--sp-6); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface-1); }
    .proj-item-head { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); margin-bottom: var(--sp-3); flex-wrap: wrap; }
    .proj-item-name { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 500; }
    .proj-item-status { font-family: var(--font-mono); font-size: var(--text-xxs); letter-spacing: var(--tracking-mono); text-transform: uppercase; color: var(--purple-bright); }
    .proj-item-desc { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); margin-bottom: var(--sp-3); }
    .proj-item-stack { color: var(--muted-2); font-size: var(--text-xs); font-family: var(--font-mono); }
    .proj-item-stack .dot { padding: 0 var(--sp-2); }
    .tier2-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
    @media (max-width: 900px) { .tier2-grid { grid-template-columns: 1fr; } }
    .tier2-card { padding: var(--sp-5); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface-1); }
    .tier2-head { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-3); margin-bottom: var(--sp-3); }
    .tier2-name { font-family: var(--font-display); font-size: var(--text-md); font-weight: 500; }
    .tier2-status { font-family: var(--font-mono); font-size: 9.5px; letter-spacing: var(--tracking-mono); text-transform: uppercase; color: var(--muted-2); }
    .tier2-desc { color: var(--muted); font-size: var(--text-xs); line-height: var(--leading-body); }
    .skills-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-5); }
    @media (max-width: 760px) { .skills-grid { grid-template-columns: 1fr; } }
    .skill-block { padding: var(--sp-5); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface-1); }
    .skill-label { font-family: var(--font-mono); font-size: var(--text-xxs); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted-2); margin-bottom: var(--sp-3); }
    .skill-value { color: var(--text); font-size: var(--text-sm); line-height: var(--leading-body); }
    .education-block { padding: var(--sp-5); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface-1); max-width: var(--wrap-narrow); }
    .education-name { font-family: var(--font-display); font-size: var(--text-md); font-weight: 500; margin-bottom: var(--sp-2); }
    .education-org { font-family: var(--font-mono); font-size: var(--text-xxs); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--purple-bright); margin-bottom: var(--sp-3); }
    .education-desc { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); }
    .principles-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-3); }
    @media (max-width: 760px) { .principles-grid { grid-template-columns: 1fr; } }
    .principle {
      padding: var(--sp-4) var(--sp-5);
      border-left: 2px solid var(--purple-bright);
      background: color-mix(in oklab, var(--surface-1) 60%, transparent);
      font-family: var(--font-display); font-size: var(--text-sm); color: var(--text);
    }
  </style>
</BaseLayout>
