---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import StatusPill from '../components/ui/StatusPill.astro';
import { PROJECTS } from '../data/projects';
import { SITE } from '../data/site';
import { CHANGELOG } from '../data/changelog';
---
<BaseLayout title={`Status — ${SITE.title}`}>
  <Section headingLevel="h1" eyebrow="Site status" heading="Real status, not a fixed claim." intro="This page tracks what's shipped, what's in flight, and every version-bump reasoning. No fabricated uptime figures.">
    <div class="site-status">
      <div class="site-status-row">
        <div class="site-status-name"><span class="dot"></span> atharvapatil.tech · build {SITE.currentVersion}</div>
        <span class="site-status-tag">Operational</span>
      </div>
      <p class="site-status-desc">0 known critical issues. Migrated to Astro on 2026-08-09; live on a preview branch. Main site (v4.7) unaffected until v5 has full parity.</p>
    </div>
  </Section>

  <Section eyebrow="Products" heading="Every product, current status.">
    <div class="product-status-list">
      {PROJECTS.map((p) => (
        <div class="product-row">
          <div class="product-head">
            <StatusPill status={p.status} size="sm" />
            <h3 class="product-name">{p.name}</h3>
          </div>
          <p class="product-desc">{p.description}</p>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Changelog" intro={`${CHANGELOG.length} entries. Newest three expanded by default; click any older row to open.`}>
    <div class="changelog">
      {CHANGELOG.map((entry, i) => (
        <details class="cl-entry" open={i < 3}>
          <summary class="cl-summary">
            <span class="cl-version">{entry.version}</span>
            <span class="cl-text">{entry.summary}</span>
          </summary>
          <div class="cl-body">
            {entry.body.map((p) => <p>{p}</p>)}
          </div>
        </details>
      ))}
    </div>
  </Section>

  <style>
    .site-status {
      padding: var(--sp-6);
      border: 1px solid var(--line);
      border-radius: var(--radius-xl);
      background: var(--surface-1);
    }
    .site-status-row {
      display: flex; align-items: center; justify-content: space-between;
      gap: var(--sp-4); margin-bottom: var(--sp-3);
    }
    .site-status-name {
      display: inline-flex; align-items: center; gap: var(--sp-3);
      font-family: var(--font-display); font-size: var(--text-md);
    }
    .site-status-name .dot {
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--green); box-shadow: 0 0 10px var(--green);
    }
    .site-status-tag {
      font-family: var(--font-mono); font-size: var(--text-xxs);
      letter-spacing: var(--tracking-mono); text-transform: uppercase;
      color: var(--green);
      padding: 4px 10px; border-radius: var(--radius-pill);
      border: 1px solid color-mix(in oklab, var(--green) 30%, transparent);
    }
    .site-status-desc { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); }

    .product-status-list { display: flex; flex-direction: column; gap: var(--sp-4); }
    .product-row {
      padding: var(--sp-5) var(--sp-6);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--surface-1);
    }
    .product-head {
      display: flex; align-items: center; gap: var(--sp-3);
      margin-bottom: var(--sp-3);
    }
    .product-name { font-family: var(--font-display); font-size: var(--text-md); font-weight: 500; }
    .product-desc { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); }

    .changelog { display: flex; flex-direction: column; gap: var(--sp-3); }
    .cl-entry {
      padding: var(--sp-5) var(--sp-6);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--surface-1);
    }
    .cl-summary {
      display: flex; align-items: center; gap: var(--sp-4);
      cursor: pointer; list-style: none; padding: 0;
    }
    .cl-summary::-webkit-details-marker { display: none; }
    .cl-version {
      font-family: var(--font-mono);
      font-size: var(--text-xxs);
      letter-spacing: var(--tracking-mono);
      text-transform: uppercase;
      color: var(--purple-bright);
      border: 1px solid var(--line-strong);
      padding: 4px 10px; border-radius: var(--radius-pill);
      flex-shrink: 0;
    }
    .cl-text { font-family: var(--font-display); font-size: var(--text-md); color: var(--text); }
    .cl-body { margin-top: var(--sp-4); color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); }
    .cl-body p + p { margin-top: var(--sp-3); }
  </style>
</BaseLayout>
