---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseHero from '../components/layout/CaseHero.astro';
import Section from '../components/layout/Section.astro';
import Screenshot from '../components/features/Screenshot.astro';
import { PROJECTS } from '../data/projects';

const project = PROJECTS.find((p) => p.slug === 'nexus')!;
---
<BaseLayout title={`${project.name} — ${project.tagline}`}>
  <CaseHero project={project} />

  <section class="stat-row-wrap">
    <div class="wrap">
      <dl class="stat-row">
        <div class="stat-cell"><dt>Authenticated cipher</dt><dd>AES-256-GCM</dd></div>
        <div class="stat-cell"><dt>Network calls</dt><dd>0</dd></div>
        <div class="stat-cell"><dt>Current build</dt><dd>v10.12.0</dd></div>
        <div class="stat-cell"><dt>Dark themes</dt><dd>12</dd></div>
      </dl>
    </div>
  </section>

  <Section eyebrow="The problem" heading="Most 'secure' tools still trust someone else with your data.">
    <div class="body-copy">
      <p>Password managers, note apps, file vaults — most are excellent at encryption in transit. But the data still lives on someone else's server. A breach, a policy change, a shutdown, a subpoena — any of these can expose what was supposed to be private.</p>
      <p>Nexus is a single vault for the things that actually matter — files, passwords, notes, bookmarks, contacts — that <strong>never leaves the device it's created on.</strong> There's no cloud sync to turn off, because there's no cloud to begin with.</p>
    </div>
  </Section>

  <Section heading="One vault. Everything sealed behind a single master password.">
    <div class="feature-grid">
      <article class="feature-card"><h3 class="feature-name">Credentials + TOTP</h3><p class="feature-desc">Passwords, usernames, built-in TOTP — no separate authenticator app needed.</p></article>
      <article class="feature-card"><h3 class="feature-name">Notes + Journal</h3><p class="feature-desc">Markdown-formatted encrypted notes, plus a private daily journal with a 30-day calendar view.</p></article>
      <article class="feature-card"><h3 class="feature-name">Zero-Trace Launcher</h3><p class="feature-desc">Run any app through Nexus in a monitored session — temp files are securely deleted when you're done.</p></article>
      <article class="feature-card"><h3 class="feature-name">Streamer Mode</h3><p class="feature-desc">Makes Nexus invisible to screen capture, OBS, and screenshots — your vault stays private even on stream.</p></article>
      <article class="feature-card"><h3 class="feature-name">Smart Collections</h3><p class="feature-desc">Auto-grouped views that surface related files, notes, and credentials across the vault.</p></article>
      <article class="feature-card"><h3 class="feature-name">Multiple + decoy vaults</h3><p class="feature-desc">Run several independent vaults side by side, including decoy vaults that unlock in place of your primary.</p></article>
    </div>
  </Section>

  <Section heading="Current status + what's next.">
    <div class="feature-grid feature-grid-4">
      <article class="feature-card"><h3 class="feature-name">v10.12.0 · In-app updater</h3><p class="feature-desc">Settings → Updates. SHA-256-verified downloads, manual restart-to-install always required. Off / Notify / Automatic modes.</p></article>
      <article class="feature-card"><h3 class="feature-name">v10.12.0 · AES-256-GCM upgrade</h3><p class="feature-desc">Vault cipher upgraded to real AES-256-GCM under a new NXG1 format. Old vaults stay readable forever; new writes get GCM automatically.</p></article>
      <article class="feature-card"><h3 class="feature-name">Windows Hello unlock</h3><p class="feature-desc">Optional Windows Hello unlock on top of the master password — face, fingerprint, or PIN, backed by the platform TPM.</p></article>
      <article class="feature-card"><h3 class="feature-name">v10.11.0 · Theme consistency</h3><p class="feature-desc">Whole-app theme pass across 17 screens and all 12 themes. Visible keyboard-focus indicator app-wide. Destructive-action styling fixed on Factory Reset.</p></article>
    </div>
  </Section>

  <!-- v11 preview — real mockup screens from the internal design deck. -->
  <Section eyebrow="v11 · in prep" heading="A ground-up UI overhaul is coming.">
    <div class="v11-block">
      <p class="v11-lede">
        Nexus <em>v11 · final release</em> is being finished right now — a complete UI redesign on top of the v10.x security architecture. Every screen redrawn from scratch: lock screen, vault browser, credential detail, notes editor, settings, updater. The cryptographic core (AES-256-GCM · Argon2id · Windows Hello · signed updates) stays untouched — v11 is a design + interaction refresh, not a rewrite of trust.
      </p>
    </div>
  </Section>

  <Section eyebrow="v11 · design deck" heading="Real screens from the internal mockup pack.">
    <p class="v11-shots-note">
      Frames below are pulled straight from the v11 design deck. These are the surfaces that ship — not concept sketches — pending final external hardening + a11y sign-off.
    </p>
    <div class="shot-grid">
      <Screenshot
        src="/assets/nexus/nexus-v11-01.png"
        alt="Nexus v11 Lock Screen — split brand + master password entry. Left column: Nexus wordmark with 'Your private files, sealed behind one password' + four trust chips (AES-256-GCM, Zero Telemetry, Offline-First, Anti-Tamper). Right column: master password field, Unlock Vault CTA, Sign in with Windows Hello, remember-device toggle. Bottom bar: verified build indicator + v1.4.2 version tag."
        caption="Lock Screen · v2 — split brand + form, trust context always visible"
        aspect="16 / 10"
        span="full"
      />
      <Screenshot
        src="/assets/nexus/nexus-v11-05.png"
        alt="Nexus v11 Splash Screen — centered isometric vault cube glyph, Nexus wordmark, 'Encrypted Personal Vault' subtitle, three animated loading dots. Version tag v1.4.2, build 20260312, Northbyte Studios credit at bottom."
        caption="Splash — startup / loading"
        aspect="16 / 10"
        span="half"
      />
      <Screenshot
        src="/assets/nexus/nexus-v11-09.png"
        alt="Nexus v11 Media Browser — dark left sidebar with vault sections (Dashboard, Vault Files, Media selected, Secure Notes, Import Files, then System group: Security, Settings, Backup, What's New, About, then Personal: Credentials, Journal, Bookmarks, Contacts). Vault-unlocked indicator + AES-256-GCM local-only chip. Right pane: Media header with 412 items, 3.2 GB, filter tabs (All 412, Images 284, Videos 96, Audio 32), 5×3 grid of thumbnails with filenames, videos with duration overlay."
        caption="Media Browser — thumbnail grid, sidebar navigation"
        aspect="16 / 10"
        span="half"
      />
      <Screenshot
        src="/assets/nexus/nexus-v11-11.png"
        alt="Nexus v11 Import Files — same left sidebar, right pane shows a large dashed drop zone with soft purple encrypted-container icon, 'Drop files here or click to browse' text, file type constraints, Browse Files (primary) + Browse Folder buttons. Progress row underneath shows Encrypting · travel-japan-2026.zip at 62%, 4 of 7 files, 2.4 GB / 3.8 GB. Footer: 'Import behavior: Ask each time — Change in Settings'."
        caption="Import Files — drop-zone + live encryption progress"
        aspect="16 / 10"
        span="half"
      />
      <Screenshot
        src="/assets/nexus/nexus-v11-25.png"
        alt="Nexus v11 Image Viewer — full-window preview of an image (travel-japan-2026-day3.jpg, 4.2 MB, 4032×3024). Filename chip at top-left. Bottom action bar: 3 of 284 counter, zoom slider at 132%, Fit / Fill toggle, Export button, Close button. Blurred purple/blue image content shown."
        caption="Image Viewer — full-window preview with zoom / export controls"
        aspect="16 / 10"
        span="half"
      />
      <Screenshot
        src="/assets/nexus/nexus-v11-27.png"
        alt="Nexus v11 Audio Player — centered purple album artwork, filename voice-memo-thursday.m4a, metadata line (Recorded Mar 12 2026 · 14:32 · AAC · 256 kbps), animated waveform, timestamps 3:24 / 8:12, transport controls with -15 rewind / play button / +30 skip, scrub bar, playback rate 1.0×."
        caption="Audio Player — waveform + transport"
        aspect="16 / 10"
        span="half"
      />
    </div>
  </Section>

  <div class="ymyl-note wrap">
    <p><strong>Not security advice.</strong> This page describes the cryptographic architecture of the Nexus vault product. It is not a substitute for professional security or compliance review before you rely on any encryption tool for critical data. Verify claims against the Nexus documentation and release notes at the linked repository.</p>
  </div>

  <Section eyebrow="v11 · what changes, what doesn't">
    <dl class="v11-list">
      <div class="v11-item">
        <dt>What changes</dt>
        <dd>Full visual system rebuild, new lock screen, refreshed vault browser, cleaner credential and note detail views, tighter settings, redesigned updater flow, new media surfaces (browser / image viewer / audio player) that never existed before v11. Kept: every keyboard shortcut, every existing vault format, every security guarantee.</dd>
      </div>
      <div class="v11-item">
        <dt>What does NOT change</dt>
        <dd>Every v10.x vault opens in v11 unchanged. AES-256-GCM stays. Argon2id stays. Windows Hello stays. Portable mode stays. Zero telemetry stays. This is a UI ship, not a security ship.</dd>
      </div>
      <div class="v11-item">
        <dt>When it lands</dt>
        <dd>Ships once the external hardening pass + accessibility audit on the new UI are green. No fixed date; shipped when it's honest to ship.</dd>
      </div>
    </dl>
  </Section>

  <style>
    .stat-row-wrap { padding: 0 0 var(--sp-8); }
    .stat-row {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 1px; background: var(--line); border: 1px solid var(--line);
      border-radius: var(--radius-xl); overflow: hidden;
    }
    @media (max-width: 760px) { .stat-row { grid-template-columns: 1fr 1fr; } }
    .stat-cell { background: var(--surface-1); padding: var(--sp-6); display: flex; flex-direction: column-reverse; gap: var(--sp-2); }
    .stat-cell dt { font-family: var(--font-mono); font-size: var(--text-xxs); letter-spacing: var(--tracking-eyebrow); text-transform: uppercase; color: var(--muted-2); }
    .stat-cell dd { font-family: var(--font-display); font-size: var(--text-xl); font-weight: 400; color: var(--text); letter-spacing: -0.01em; }
    .body-copy { max-width: var(--wrap-narrow); color: var(--muted); font-size: var(--text-md); line-height: var(--leading-body); }
    .body-copy p + p { margin-top: var(--sp-4); }
    .body-copy strong { color: var(--text); font-weight: 500; }
    .feature-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); }
    .feature-grid-4 { grid-template-columns: repeat(2, 1fr); }
    @media (max-width: 900px) { .feature-grid, .feature-grid-4 { grid-template-columns: 1fr; } }
    .feature-card { padding: var(--sp-6); border: 1px solid var(--line); border-radius: var(--radius-lg); background: var(--surface-1); }
    .feature-name { font-family: var(--font-display); font-size: var(--text-md); font-weight: 500; margin-bottom: var(--sp-3); }
    .feature-desc { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); }

    /* v11 shot grid — matches the Kanvaz layout */
    .shot-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: var(--sp-5);
      margin-top: var(--sp-5);
    }
    .shot-grid :global(.span-full)  { grid-column: span 12; }
    .shot-grid :global(.span-half)  { grid-column: span 6; }
    .shot-grid :global(.span-third) { grid-column: span 4; }
    @media (max-width: 900px) {
      .shot-grid :global(.span-half),
      .shot-grid :global(.span-third) { grid-column: span 12; }
    }
    .v11-shots-note {
      max-width: var(--wrap-narrow);
      color: var(--muted);
      font-size: var(--text-sm);
      line-height: var(--leading-body);
    }

    /* v5.16.0 YMYL disclaimer — SEO audit E-E-A-T fix */
    .ymyl-note {
      margin: var(--sp-8) auto;
      max-width: var(--wrap-narrow);
      padding: var(--sp-4) var(--sp-5);
      border-left: 3px solid var(--warn);
      background: color-mix(in oklab, var(--warn) 6%, transparent);
      color: var(--muted);
      font-size: var(--text-xs);
      line-height: var(--leading-body);
    }
    .ymyl-note strong { color: var(--warn-text); }

    /* v11 preview block */
    .v11-block { max-width: var(--wrap-narrow); }
    .v11-lede {
      color: var(--text);
      font-size: var(--text-md);
      line-height: var(--leading-body);
      margin-bottom: var(--sp-6);
      padding: var(--sp-5) var(--sp-6);
      border-left: 3px solid var(--purple-bright);
      background: color-mix(in oklab, var(--purple) 6%, transparent);
    }
    .v11-lede em { color: var(--purple-bright); font-style: italic; font-weight: 500; }
    .v11-list { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
    .v11-item {
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: var(--sp-5);
      padding: var(--sp-4) 0;
      border-bottom: 1px solid var(--line);
      align-items: baseline;
    }
    @media (max-width: 640px) { .v11-item { grid-template-columns: 1fr; gap: 4px; } }
    .v11-item dt {
      color: var(--text);
      font-family: var(--font-display);
      font-size: var(--text-sm);
      font-weight: 500;
    }
    .v11-item dd {
      color: var(--muted);
      font-size: var(--text-sm);
      line-height: var(--leading-body);
    }
  </style>
</BaseLayout>
