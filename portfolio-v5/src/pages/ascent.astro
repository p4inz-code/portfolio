---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseHero from '../components/layout/CaseHero.astro';
import Section from '../components/layout/Section.astro';
import Screenshot from '../components/features/Screenshot.astro';
import RelatedProjects from '../components/features/RelatedProjects.astro';
import { PROJECTS } from '../data/projects';

const project = PROJECTS.find((p) => p.slug === 'ascent')!;

const softwareJsonLd = {
  '@type': 'SoftwareApplication',
  '@id': 'https://atharvapatil.tech/ascent/#software',
  name: 'Project Ascent',
  description: 'Free, open source 2D platformer with 40 levels and 8 bosses, built in Godot 4. Levels rebuild themselves every time you die. Cross-platform, no accounts or tracking.',
  applicationCategory: 'GameApplication',
  operatingSystem: 'Windows, macOS, Linux, Web',
  softwareVersion: project.currentVersion,
  license: 'https://www.gnu.org/licenses/gpl-3.0.html',
  url: 'https://atharvapatil.tech/ascent/',
  author: { '@id': 'https://atharvapatil.tech/#person' },
  keywords: 'Project Ascent, project ascent p4inz, project ascent painz, p4inz game dev, Godot platformer',
  // Ties the case study to the actual playable build and source, not
  // just this write-up about it.
  sameAs: ['https://p4inz-code.itch.io/project-ascent', 'https://github.com/p4inz-code/project-ascent'],
};
const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://atharvapatil.tech/' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://atharvapatil.tech/work/' },
    { '@type': 'ListItem', position: 3, name: 'Project Ascent', item: 'https://atharvapatil.tech/ascent/' },
  ],
};

const moveset = [
  { name: 'Run', desc: 'Acceleration, deceleration, and real air control, not an instant top speed.' },
  { name: 'Jump', desc: 'Coyote time, jump buffering, and variable height baked in from the start.' },
  { name: 'Wall slide + wall jump', desc: 'Run into a wall with speed to catch it.' },
  { name: 'Dash', desc: 'Air dash with landing refresh and momentum handling.' },
  { name: 'Spin', desc: 'Double-tap jump in mid-air for brief hazard invulnerability on a cooldown.' },
  { name: 'Slide, ground pound, wall run, ledge grab, grapple', desc: 'Five more verbs, only some of which claim their own key: the rest derive from inputs the player already knows.' },
  { name: 'Slash + three health cells', desc: 'Slash drones, flip switches and stun chasers. Spikes and drones take one cell, lava takes all three.' },
  { name: 'One-charge abilities', desc: 'Super jump and glide pickups, spent with the ability key.' },
];

const acts = [
  { act: 'Act I: Cinder', levels: 'L1-L5', desc: 'Ends with the Borer: an auto-run over thin tiles on a lava lake while it surfaces behind you.' },
  { act: 'Act II: Scrapyard', levels: 'L6-L10', desc: 'The first levels that rebuild on every death. Ends with the Compactor, a climb up a shaft with a rising flood and falling junk.' },
  { act: 'Act III: Freezer', levels: 'L11-L15', desc: "Ends with the Warden's Mile: an ice corridor, a lantern-carrying Warden and shadow pockets to hide in." },
  { act: 'Act IV: Storm', levels: 'L16-L20', desc: 'Ends with the Tempest: ground-pound the reactor rods while lightning strikes where you stood a moment ago.' },
  { act: 'Act V: Summit Forge', levels: 'L21-L25', desc: 'Ends with Dawn: outrun a collapse across heat vents.' },
  { act: 'Act VI: Underworks', levels: 'L26-L30', desc: 'Ends with the Hive.' },
  { act: 'Act VII: Rift', levels: 'L31-L35', desc: 'Ends with the Rift Warden, a black hole that chases you.' },
  { act: 'Act VIII: Core', levels: 'L36-L40', desc: 'Ends with the Echo exam, which remixes pieces from five of the earlier acts.' },
];

const bosses = [
  { level: 'L5', boss: 'The Borer', format: 'Lava runner' },
  { level: 'L10', boss: 'The Compactor', format: 'Flood climb' },
  { level: 'L15', boss: 'The Warden', format: 'Stealth hunt' },
  { level: 'L20', boss: 'The Tempest', format: 'Lightning arena' },
  { level: 'L25', boss: 'Dawn', format: 'Collapse and heat vents' },
  { level: 'L30', boss: 'The Hive', format: 'Machine level with a chase' },
  { level: 'L35', boss: 'The Rift Warden', format: 'Black hole' },
  { level: 'L40', boss: 'The Echo', format: 'Exam' },
];
---
<BaseLayout scene={project.scene} title="Project Ascent: 40-Level Platformer · Atharva Patil" description="Free, open source 2D platformer with 40 levels and 8 bosses, built in Godot 4. Levels rebuild themselves every time you die. The redesign is in development and v0.18.0 is the official test release. Playable in the browser on itch.io." keywords="Project Ascent, project ascent p4inz, project ascent painz, p4inz game dev, painz platformer, Godot platformer, itch.io platformer" extraJsonLd={[softwareJsonLd, breadcrumbJsonLd]}>
  <CaseHero project={project} />

  <section class="stat-row-wrap">
    <div class="wrap">
      <dl class="stat-row">
        <div class="stat-cell"><dt>Levels</dt><dd>40</dd></div>
        <div class="stat-cell"><dt>Acts</dt><dd>8</dd></div>
        <div class="stat-cell"><dt>Bosses</dt><dd>8</dd></div>
        <div class="stat-cell"><dt>Test scripts</dt><dd>100+</dd></div>
      </dl>
    </div>
  </section>

  <Section eyebrow="What it is" heading="A climber, a rotten tower, and levels that re-roll every time you die.">
    <div class="body-copy">
      <p>You fall out of the sky into the Spire, a tower with no ground below it. The way out is a gate at the top that needs 100 cores, and PIP, the AI in your suit, comes along for the climb and is not nice about it. The whole moveset is yours from the first second. Nothing is locked behind progress, and the levels get harder because they ask more of the same tools.</p>
      <p>From level 6 on, every death rolls a new version of the level, with different obstacles, pits and timing. A bot plays each roll before you see it, so every level you get can be beaten. You just never get the same one twice. There are also roll codes to replay one roll and a daily set of seeds.</p>
      <p>No accounts, no ads and no tracking. The only network traffic is a daily update check that you can turn off, and it never runs in the browser build. The game is free and open source under GPL-3.0.</p>
    </div>
  </Section>

  <Section eyebrow="Status" heading="The redesign is still in development. v0.18.0 is the official test release.">
    <div class="body-copy">
      <p>This version of the game is a rebuild of the first one: 40 levels instead of 25, eight boss formats, slash combat, rolled levels, an Endless mode and a new look. The version before it, v0.14.1, is the last build of the old game.</p>
      <p>v0.18.0 came out on 18 November 2026 and adds updates inside the game. It is free to play in the browser on <a href="https://p4inz-code.itch.io/project-ascent" target="_blank" rel="noopener noreferrer">itch.io</a> and to download from <a href="https://github.com/p4inz-code/project-ascent/releases/latest" target="_blank" rel="noopener noreferrer">GitHub</a>. Work toward v1.0.0 continues, and the repo roadmap lists what is done, what is tested and what is still open.</p>
    </div>
  </Section>

  <Section eyebrow="Screenshots" heading="Captures from the redesign test builds.">
    <div class="shot-grid">
      <Screenshot
        src="/assets/ascent/ascent-01-title.webp"
        alt="Project Ascent title screen: a pixel-art city skyline under a purple moon, an astronaut standing on a brick ledge, and a menu with Play, Tutorial, Endless, Story and Quit."
        caption="Title screen"
        aspect="16 / 9"
        span="third"
        width={1600}
        height={900}
      />
      <Screenshot
        src="/assets/ascent/ascent-02-borer.webp"
        alt="Project Ascent, level 5: a red warning banner reading 'The Borer has surfaced' above an astronaut leaping between thin tiles over a lake of lava."
        caption="Level 5 · The Borer"
        aspect="16 / 9"
        span="third"
        width={1600}
        height={900}
      />
      <Screenshot
        src="/assets/ascent/ascent-03-tempest.webp"
        alt="Project Ascent, level 20 Tempest: an astronaut in a rainy purple landscape with tall lightning rods and a large banded planet in the sky."
        caption="Level 20 · The Tempest"
        aspect="16 / 9"
        span="third"
        width={1600}
        height={900}
      />
      <Screenshot
        src="/assets/ascent/ascent-04-hive.webp"
        alt="Project Ascent, level 30 The Hive: a teal floor with three green pools set into the floor above lava, and a counter reading Hive 0 of 6."
        caption="Level 30 · The Hive"
        aspect="16 / 9"
        span="third"
        width={1600}
        height={900}
      />
      <Screenshot
        src="/assets/ascent/ascent-05-core.webp"
        alt="Project Ascent, level 40 The Core: a red-tinted level with a warning banner reading 'The Echo has found you', a lava pit and two chaser distance markers."
        caption="Level 40 · The Core"
        aspect="16 / 9"
        span="third"
        width={1600}
        height={900}
      />
      <Screenshot
        src="/assets/ascent/ascent-06-level-clear.webp"
        alt="Project Ascent: the Level 7 Cleared card showing time, attempts and cores, with a line from PIP at the top of the screen."
        caption="Level clear card"
        aspect="16 / 9"
        span="third"
        width={1600}
        height={900}
      />
      <Screenshot
        src="/assets/ascent/ascent-07-endless.webp"
        alt="Project Ascent, Endless mode stage 1: a stage that mixes lava, ice, spikes and rain, with a best-score counter under the health cells."
        caption="Endless mode"
        aspect="16 / 9"
        span="third"
        width={1600}
        height={900}
      />
      <Screenshot
        src="/assets/ascent/ascent-08-pip.webp"
        alt="Project Ascent: PIP's suit channel screen, where the player picks STRONG or WEAK mode and sets language and scare levels."
        caption="PIP and the STRONG / WEAK choice"
        aspect="16 / 9"
        span="third"
        width={1600}
        height={900}
      />
      <Screenshot
        src="/assets/ascent/ascent-09-character.webp"
        alt="Project Ascent settings, Character tab: a preview of the astronaut Trevor with gear options and suit, trim and visor colour swatches."
        caption="Settings · Character"
        aspect="16 / 9"
        span="third"
        width={1600}
        height={900}
      />
    </div>
  </Section>

  <Section eyebrow="Moveset" heading="Full kit from level one.">
    <div class="feature-grid">
      {moveset.map((m) => (
        <article class="feature-card">
          <h3 class="feature-name">{m.name}</h3>
          <p class="feature-desc">{m.desc}</p>
        </article>
      ))}
    </div>
  </Section>

  <Section eyebrow="Campaign" heading="Eight acts, forty levels.">
    <div class="act-list">
      {acts.map((a) => (
        <div class="act-row">
          <span class="act-name">{a.act}</span>
          <span class="act-levels">{a.levels}</span>
          <span class="act-desc">{a.desc}</span>
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Boss encounters" heading="Every fifth level is a boss with its own rules.">
    <div class="body-copy">
      <p>Each boss changes what the level asks of you instead of adding a health bar. The Hive on level 30 is still a machine level with a chase, and a format of its own is still to come.</p>
    </div>
    <table class="boss-table">
      <thead>
        <tr><th>Level</th><th>Boss</th><th>Format</th></tr>
      </thead>
      <tbody>
        {bosses.map((b) => (
          <tr><td>{b.level}</td><td>{b.boss}</td><td>{b.format}</td></tr>
        ))}
      </tbody>
    </table>
  </Section>

  <Section eyebrow="Testing" heading="More than 100 automated test scripts, and every rolled level is bot-proven.">
    <div class="body-copy">
      <p>Two of these suites exist because an earlier gate proved the wrong thing. <code>test_level_rhythm.gd</code> checks that no jump demands more rise than the player can actually deliver, using an envelope measured from the real controller rather than assumed from a config value: the reachability suite once passed two levels despite both shipping impossible final jumps, because a bot could reach the ledge by wall-jumping off that ledge's own face. That proves a bot can get there, not that the jump is fair.</p>
      <p><code>test_chaser_ledges.gd</code> asserts a chaser stops at a cliff instead of walking into it. Three previous fixes for "enemies falling" addressed collision layers and a recovery teleport; none of them checked whether there was ground ahead, which was the actual cause.</p>
      <p>The runner also fails a suite on any GDScript parse or compile error, not just a non-zero exit code, since a script that fails to compile otherwise reports zero failures while having asserted nothing at all.</p>
      <p>The level generator for the rolled levels has its own proof. Every obstacle's timing window is measured by sweeping the real player physics, no window is narrower than five frames, and a perfect bot has to clear 100 rolls without a hit. The updater has a fake GitHub server that runs 13 failure cases over real HTTP, such as a wrong checksum, a changed byte, a dropped connection and a redirect to another site.</p>
    </div>
  </Section>

  <Section eyebrow="Platforms" heading="Windows, macOS, Linux, and browser from one codebase.">
    <div class="body-copy">
      <p>Windows ships with a standalone launcher. Since v0.18.0 the game checks GitHub once a day for a newer version, downloads it with a progress bar, compares its SHA-256 against the published checksum, and asks before restarting. If anything fails, the old version keeps working. The check has three modes (Automatic, Notify me and Off) and sends nothing about the player. The web build is playable directly on <a href="https://p4inz-code.itch.io/project-ascent" target="_blank" rel="noopener noreferrer">itch.io</a>.</p>
      <p>The macOS and Linux builds are provided, but so far they have only been checked for their file layout, not run, and they have no launcher. Windows needs Windows 10 or 11 (64-bit), about 250 MB of memory and 130 MB of disk. Controller prompts match Xbox, PlayStation or Switch pads. Phones and consoles are not supported.</p>
    </div>
  </Section>

  <RelatedProjects currentSlug="ascent" slugs={['kanvaz', 'nexus', 'mission-os', 'pursue-os']} />

  <style>
    .stat-row-wrap { padding: 0 0 var(--sp-8); }
    .stat-row {
      display: grid; grid-template-columns: repeat(4, 1fr);
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: var(--radius-xl);
      overflow: hidden;
    }
    @media (max-width: 760px) { .stat-row { grid-template-columns: 1fr 1fr; } }
    .stat-cell {
      background: var(--surface-1);
      padding: var(--sp-6);
      display: flex; flex-direction: column-reverse; gap: var(--sp-2);
    }
    .stat-cell dt {
      font-family: var(--font-mono);
      font-size: var(--text-xxs);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--muted-2);
    }
    .stat-cell dd {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      font-weight: 400;
      color: var(--text);
      letter-spacing: -0.01em;
    }

    .body-copy {
      max-width: var(--wrap-narrow);
      color: var(--muted);
      font-size: var(--text-md);
      line-height: var(--leading-body);
    }
    .body-copy p + p { margin-top: var(--sp-4); }
    .body-copy code {
      font-family: var(--font-mono);
      background: color-mix(in oklab, var(--purple) 12%, transparent);
      color: var(--purple-bright);
      padding: 1px 5px;
      border-radius: 2px;
      font-size: 0.9em;
    }
    .body-copy a { color: var(--purple-bright); border-bottom: 1px solid currentColor; }

    .shot-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-4);
    }
    @media (max-width: 760px) { .shot-grid { grid-template-columns: 1fr; } }

    .feature-grid {
      display: grid; grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-4);
    }
    @media (max-width: 760px) { .feature-grid { grid-template-columns: 1fr; } }
    .feature-card {
      padding: var(--sp-6);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--surface-1);
    }
    .feature-name {
      font-family: var(--font-display);
      font-size: var(--text-md);
      font-weight: 500;
      margin-bottom: var(--sp-3);
    }
    .feature-desc { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); }

    .act-list { display: flex; flex-direction: column; border-top: 1px solid var(--line); }
    .act-row {
      display: grid;
      grid-template-columns: 180px 90px 1fr;
      gap: var(--sp-5);
      padding: var(--sp-5) 0;
      border-bottom: 1px solid var(--line);
      align-items: baseline;
    }
    @media (max-width: 760px) {
      .act-row { grid-template-columns: 1fr; gap: var(--sp-2); }
    }
    .act-name {
      font-family: var(--font-display);
      font-size: var(--text-md);
      color: var(--text);
    }
    .act-levels {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--purple-bright);
      letter-spacing: 0.02em;
    }
    .act-desc { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); }

    .boss-table {
      width: 100%;
      max-width: var(--wrap-narrow);
      margin-top: var(--sp-6);
      border-collapse: collapse;
      font-size: var(--text-sm);
    }
    .boss-table th, .boss-table td {
      text-align: left;
      padding: var(--sp-3) var(--sp-4);
      border-bottom: 1px solid var(--line);
    }
    .boss-table th {
      font-family: var(--font-mono);
      font-size: var(--text-xxs);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--muted-2);
    }
    .boss-table td { color: var(--muted); }
    .boss-table td:first-child { color: var(--text); font-family: var(--font-mono); }
    @media (max-width: 420px) {
      .boss-table th, .boss-table td { padding: var(--sp-2) var(--sp-2); font-size: 12px; }
      .boss-table th { font-size: 9px; letter-spacing: 0.06em; }
    }
  </style>
</BaseLayout>
