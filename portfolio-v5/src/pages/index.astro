---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHero from '../components/features/EditorialHero.astro';
import Section from '../components/layout/Section.astro';
import ProjectCard from '../components/features/ProjectCard.astro';
import Button from '../components/ui/Button.astro';
import { FEATURED_PROJECTS, SUPPORTING_PROJECTS } from '../data/projects';
import { SITE } from '../data/site';
---
<BaseLayout title={`${SITE.title} — ${SITE.tagline}`}>
  <EditorialHero
    eyebrow={`Building ${SITE.studio} · ${SITE.location}`}
    lines={[
      { text: 'during the day.', emphasis: 'I write software' },
      { text: 'on the side.',    emphasis: 'I study VFX' },
      { text: 'on my own.',      emphasis: 'I build Mission OS' },
    ]}
    intro="Solo founder building privacy-first Windows software, an open-source Linux OS, developer tools, and freelance web work. Everything here was designed, built, and shipped by one person."
  >
    <div class="hero-actions">
      <Button href="/work" variant="primary">See selected work →</Button>
      <Button href="/contact" variant="ghost">Get in touch</Button>
    </div>
  </EditorialHero>

  <div class="hero-manifest" aria-hidden="true">
    <span class="phrase">I write software</span>
    <span class="sep">·</span>
    <span class="phrase">I study VFX</span>
    <span class="sep">·</span>
    <span class="phrase">I build Mission OS</span>
  </div>

  <Section heading="Four things I'm shipping right now.">
    <div class="cards-grid">
      <div class="card-slot card-slot-featured">
        <ProjectCard project={FEATURED_PROJECTS[0]} variant="featured" />
      </div>
      {FEATURED_PROJECTS.slice(1).map((p) => (
        <div class="card-slot card-slot-half">
          <ProjectCard project={p} />
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Also on the shelf" heading="Open source, on hold, or maintained." intro="Smaller work, older projects, and things that don't need a case study of their own.">
    <div class="secondary-grid">
      {SUPPORTING_PROJECTS.map((p) => (
        <ProjectCard project={p} variant="compact" />
      ))}
    </div>
  </Section>

  <style>
    .hero-actions {
      margin-top: var(--sp-8);
      display: flex; flex-wrap: wrap; gap: var(--sp-3);
    }
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: var(--sp-5);
    }
    .card-slot-featured { grid-column: span 12; }
    .card-slot-half { grid-column: span 6; }
    @media (max-width: 900px) {
      .card-slot-half { grid-column: span 12; }
    }
    .secondary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-4);
    }
    @media (max-width: 900px) {
      .secondary-grid { grid-template-columns: 1fr; }
    }

    /* v5.1-alpha — signature move #1: hero → work bridge.
       Three italic phrases from the hero reappear as a compact manifest,
       revealed by scroll position so the transition surprises you. */
    .hero-manifest {
      max-width: var(--wrap);
      margin: 0 auto;
      padding: var(--sp-10) var(--sp-6) var(--sp-9);
      display: flex; flex-wrap: wrap;
      align-items: center; justify-content: center;
      gap: var(--sp-4);
      font-family: var(--font-mono);
      font-size: var(--text-xxs);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--purple);
    }
    .hero-manifest .sep { color: var(--muted-2); }
    .hero-manifest .phrase {
      display: inline-block;
      opacity: 1;
      transform: none;
    }
    @supports (animation-timeline: view()) {
      .hero-manifest .phrase {
        opacity: 0;
        transform: translateY(14px);
        animation: manifest-rise 1s var(--ease-out) forwards;
        animation-timeline: view();
      }
      .hero-manifest > :nth-child(1) { animation-range: entry 0% entry 55%; }
      .hero-manifest > :nth-child(3) { animation-range: entry 15% entry 70%; }
      .hero-manifest > :nth-child(5) { animation-range: entry 30% entry 85%; }
    }
    @keyframes manifest-rise {
      to { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hero-manifest .phrase { animation: none; opacity: 1; transform: none; }
    }
    @media (max-width: 640px) {
      .hero-manifest { gap: var(--sp-3); padding-top: var(--sp-9); padding-bottom: var(--sp-8); }
    }
  </style>
</BaseLayout>
