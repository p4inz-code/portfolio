---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHero from '../components/features/EditorialHero.astro';
import Section from '../components/layout/Section.astro';
import ProjectCard from '../components/features/ProjectCard.astro';
import Button from '../components/ui/Button.astro';
import { FEATURED_PROJECTS, SUPPORTING_PROJECTS } from '../data/projects';
import { SITE } from '../data/site';
---
<BaseLayout title={`${SITE.title} — ${SITE.tagline}`}>
  <EditorialHero
    eyebrow={`Building ${SITE.studio} · ${SITE.location}`}
    lines={[
      { text: 'during the day.', emphasis: 'I write software' },
      { text: 'on the side.',    emphasis: 'I study VFX' },
      { text: 'on my own.',      emphasis: 'I build Mission OS' },
    ]}
    intro="Solo founder building privacy-first Windows software, an open-source Linux OS, developer tools, and freelance web work. Everything here was designed, built, and shipped by one person."
  >
    <div class="hero-actions">
      <Button href="/work" variant="primary">See selected work →</Button>
      <Button href="/contact" variant="ghost">Get in touch</Button>
    </div>
  </EditorialHero>

  <Section eyebrow="Selected work" heading="Four things I'm building right now.">
    <div class="cards-grid">
      <div class="card-slot card-slot-featured">
        <ProjectCard project={FEATURED_PROJECTS[0]} variant="featured" />
      </div>
      {FEATURED_PROJECTS.slice(1).map((p) => (
        <div class="card-slot card-slot-half">
          <ProjectCard project={p} />
        </div>
      ))}
    </div>
  </Section>

  <Section eyebrow="Also on the shelf" heading="Open source, on hold, or maintained." intro="Smaller work, older projects, and things that don't need a case study of their own.">
    <div class="secondary-grid">
      {SUPPORTING_PROJECTS.map((p) => (
        <ProjectCard project={p} variant="compact" />
      ))}
    </div>
  </Section>

  <style>
    .hero-actions {
      margin-top: var(--sp-8);
      display: flex; flex-wrap: wrap; gap: var(--sp-3);
    }
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: var(--sp-5);
    }
    .card-slot-featured { grid-column: span 12; }
    .card-slot-half { grid-column: span 6; }
    @media (max-width: 900px) {
      .card-slot-half { grid-column: span 12; }
    }
    .secondary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-4);
    }
    @media (max-width: 900px) {
      .secondary-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
