---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHero from '../components/features/EditorialHero.astro';
import Section from '../components/layout/Section.astro';
import ProjectCard from '../components/features/ProjectCard.astro';
import ObscuraCard from '../components/features/ObscuraCard.astro';
import FeaturedShowcase from '../components/features/FeaturedShowcase.astro';
import Button from '../components/ui/Button.astro';
import { FEATURED_PROJECTS, SUPPORTING_PROJECTS, PROJECTS } from '../data/projects';
import { SITE } from '../data/site';

const projectCount = PROJECTS.length;
---
<BaseLayout title={`${SITE.title} — Software · 3D · VFX · Northbyte`}>
  <EditorialHero
    eyebrow={`Building ${SITE.studio} · ${SITE.location}`}
    lines={[
      { text: 'software studio.', emphasis: 'Northbyte is a one-person' },
      { text: 'the rest of my time.', emphasis: 'A VFX degree takes up' },
    ]}
    intro={`Solo founder — I write the software, ship it, and support it myself, and I'm partway through a 3D animation degree on the side. ${projectCount} products shipped or in progress so far, none of them with a marketing team, none of them phoning home. Every case study here links to a real repository or a real download, and the version numbers stay honest even when that means saying something's still rough.`}
  >
    <div class="hero-actions">
      <Button href="/work" variant="primary">See selected work →</Button>
      <Button href="/contact" variant="ghost">Get in touch</Button>
    </div>
  </EditorialHero>

  <Section heading="Four things I'm shipping right now.">
    <FeaturedShowcase projects={FEATURED_PROJECTS} />
  </Section>

  <Section eyebrow="Also on the shelf" heading="Open source, on hold, or maintained." intro="Smaller work, older projects, and things that don't need a case study of their own.">
    <div class="secondary-grid">
      {SUPPORTING_PROJECTS.map((p) => (
        p.slug === 'obscura' ? <ObscuraCard project={p} /> : <ProjectCard project={p} variant="compact" />
      ))}
    </div>
  </Section>

  <style>
    .hero-actions {
      margin-top: var(--sp-8);
      display: flex; flex-wrap: wrap; gap: var(--sp-3);
    }
    .secondary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-4);
    }
    @media (max-width: 900px) {
      .secondary-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
