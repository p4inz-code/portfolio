---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialHero from '../components/features/EditorialHero.astro';
import Section from '../components/layout/Section.astro';
import ProjectCard from '../components/features/ProjectCard.astro';
import ObscuraCard from '../components/features/ObscuraCard.astro';
import FeaturedShowcase from '../components/features/FeaturedShowcase.astro';
import Button from '../components/ui/Button.astro';
import ProofStrip from '../components/features/ProofStrip.astro';
import ShippingRail from '../components/features/ShippingRail.astro';
import { FEATURED_PROJECTS, SUPPORTING_PROJECTS, PROJECTS } from '../data/projects';
import { SITE } from '../data/site';

const projectCount = PROJECTS.length;
const NUM = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight'];
const featuredWord = NUM[FEATURED_PROJECTS.length] ?? String(FEATURED_PROJECTS.length);
---
<BaseLayout title={`${SITE.title} — Software · 3D · VFX · Northbyte`} keywords="Atharva Patil, p4inz, P4INZ, painz, p4inz web dev, p4inz app dev, p4inz cli dev, p4inz game dev, Northbyte Studios">
  <EditorialHero
    scrub
    eyebrow={`Atharva Patil · ${SITE.location}`}
    lines={[
      { text: 'on my own,', emphasis: 'I build software' },
      { text: 'and study animation on the side.' },
    ]}
    roles={['writes the code', 'designs the screens', 'renders the 3D', 'ships the build', 'answers the email']}
    intro={`I'm Atharva, a solo founder in Navi Mumbai and a second-year 3D animation student. I write the software, ship it and support it myself. ${projectCount} products so far, none of them with a marketing team and none of them phoning home. Every case study links to a real repository or a real download, and the version numbers stay honest even when that means saying something is still rough.`}
  >
    <div class="hero-actions">
      <Button href="/work" variant="primary">See selected work →</Button>
      <Button href="/contact" variant="ghost">Get in touch</Button>
    </div>
  </EditorialHero>

  <ProofStrip projectCount={projectCount} />

  <Section heading={`${featuredWord} things I'm shipping right now.`}>
    <FeaturedShowcase projects={FEATURED_PROJECTS} />
  </Section>

  <ShippingRail projects={FEATURED_PROJECTS} />

  <Section eyebrow="Also on the shelf" heading="Open source, on hold, or maintained." intro="Smaller work, older projects, and things that don't need a case study of their own.">
    <div class="secondary-grid">
      {SUPPORTING_PROJECTS.map((p) => (
        p.slug === 'obscura' ? <ObscuraCard project={p} /> : <ProjectCard project={p} variant="compact" />
      ))}
    </div>
  </Section>

  <style>
    .hero-actions {
      margin-top: var(--sp-8);
      display: flex; flex-wrap: wrap; gap: var(--sp-3);
    }
    .secondary-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-4);
    }
    @media (max-width: 900px) {
      .secondary-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
