---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import WorkDeck from '../components/features/WorkDeck.astro';
import WorkIndex from '../components/features/WorkIndex.astro';
import { FEATURED_PROJECTS, SUPPORTING_PROJECTS } from '../data/projects';
---
<BaseLayout title="Selected Work — Atharva Patil" description="Selected case studies: two Linux OSes, an encrypted vault, developer tools. Every project links to a real repository or download." keywords="p4inz projects, painz projects, p4inz portfolio, software portfolio p4inz, p4inz web dev, p4inz app dev, p4inz game dev, p4inz cli dev">

  <Section
    wide
    headingLevel="h1"
    heading="designed, built, and shipped by one person."
    headingEmphasis="Every project below —"
    intro="Two operating systems on hold after real releases. One encrypted vault in public beta. One reference workspace, still shipping most weeks. One precision platformer, live and playable, polish ongoing. Every case study links to real code, real screenshots, or a live download: no design mockups pretending to be products."
  >
    <WorkDeck projects={FEATURED_PROJECTS} />
  </Section>

  <Section eyebrow="The whole roster" heading="Everything, in one list." intro="The cards above are the big ones. This is all of it, smaller tools and older projects included. Each row opens the real case study or the real repository.">
    <WorkIndex projects={[...FEATURED_PROJECTS, ...SUPPORTING_PROJECTS]} />
  </Section>
</BaseLayout>
