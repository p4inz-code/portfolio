---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import FeaturedShowcase from '../components/features/FeaturedShowcase.astro';
import ProjectCard from '../components/features/ProjectCard.astro';
import { FEATURED_PROJECTS, SUPPORTING_PROJECTS } from '../data/projects';
---
<BaseLayout title="Selected Work — Atharva Patil">

  <Section
    wide
    heading="designed, built, and shipped by one person."
    headingEmphasis="Every project below —"
    intro="Two operating systems in active development. One encrypted vault in public beta. One reference workspace winding down after its final release. One investigation OS coming soon. Every case study links to real code, real screenshots, or a live download — no design mockups pretending to be products."
  >
    <FeaturedShowcase projects={FEATURED_PROJECTS} />
  </Section>

  <Section eyebrow="Also on the shelf" heading="Smaller work, older projects, tools I still maintain." intro="Not every project needs a case study of its own — some are single-purpose CLIs, some are on-hold, some just work quietly. They still ship, they're still mine, and every one has a real repo behind it.">
    <div class="secondary-grid">
      {SUPPORTING_PROJECTS.map((p) => (
        <ProjectCard project={p} variant="compact" />
      ))}
    </div>
  </Section>

  <style>
    .secondary-grid {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4);
    }
    @media (max-width: 760px) {
      .secondary-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
