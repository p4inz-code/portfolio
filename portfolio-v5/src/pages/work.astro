---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import WorkDeck from '../components/features/WorkDeck.astro';
import WorkIndex from '../components/features/WorkIndex.astro';
import WorkByCategory from '../components/features/WorkByCategory.astro';
import ProjectConstellation from '../components/features/ProjectConstellation.astro';
import { FEATURED_PROJECTS, SUPPORTING_PROJECTS } from '../data/projects';

// Client and event sites aren't part of the "how does my own work connect"
// story the constellation is telling -- same population PRODUCT_COUNT uses.
const constellationProjects = [...FEATURED_PROJECTS, ...SUPPORTING_PROJECTS].filter(
  (p) => !p.tags.includes('Client work') && !p.tags.includes('Event site')
);
---
<BaseLayout title="Selected Work — Atharva Patil" description="Selected case studies: two Linux OSes, an encrypted vault, developer tools. Every project links to a real repository or download." keywords="p4inz projects, painz projects, p4inz portfolio, software portfolio p4inz, p4inz web dev, p4inz app dev, p4inz game dev, p4inz cli dev">

  <Section
    wide
    headingLevel="h1"
    heading="designed, built, and shipped by one person."
    headingEmphasis="Every project below —"
    intro="One operating system on hold after a real release, another back in active development, an encrypted vault whose next release is on hold, a reference workspace that ships most weeks, and a platformer you can play now. Every case study links to real code, real screenshots or a live download."
  >
    <WorkDeck projects={FEATURED_PROJECTS} />
  </Section>

  <Section eyebrow="The whole roster" heading="Everything, in one list." intro="The cards above are the big projects. This list has everything, including the smaller tools and older work. Each row opens a case study or the repository.">
    <WorkIndex projects={[...FEATURED_PROJECTS, ...SUPPORTING_PROJECTS]} />
  </Section>

  <Section eyebrow="Same work, sorted differently" heading="By type." intro="Web, app, CLI or OS. A few projects don't fit one of those four and aren't repeated here.">
    <WorkByCategory projects={[...FEATURED_PROJECTS, ...SUPPORTING_PROJECTS]} />
  </Section>

  <Section eyebrow="Same work, one more way" heading="How it connects." intro="Each project is linked to the others it shares something with: a category, a technology, a license. Drag the nodes around.">
    <ProjectConstellation projects={constellationProjects} />
  </Section>
</BaseLayout>
