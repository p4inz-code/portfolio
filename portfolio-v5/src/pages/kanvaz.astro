---
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseHero from '../components/layout/CaseHero.astro';
import Section from '../components/layout/Section.astro';
import Screenshot from '../components/features/Screenshot.astro';
import RelatedProjects from '../components/features/RelatedProjects.astro';
import { PROJECTS } from '../data/projects';

const project = PROJECTS.find((p) => p.slug === 'kanvaz')!;

const softwareJsonLd = {
  '@type': 'SoftwareApplication',
  '@id': 'https://atharvapatil.tech/kanvaz/#software',
  name: 'Kanvaz',
  description: 'Free, open-source visual reference workspace for VFX and 3D artists.',
  applicationCategory: 'DesignApplication',
  license: 'https://opensource.org/licenses/MIT',
  softwareVersion: project.currentVersion,
  url: 'https://atharvapatil.tech/kanvaz/',
  author: { '@id': 'https://atharvapatil.tech/#person' },
};
const breadcrumbJsonLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://atharvapatil.tech/' },
    { '@type': 'ListItem', position: 2, name: 'Work', item: 'https://atharvapatil.tech/work/' },
    { '@type': 'ListItem', position: 3, name: 'Kanvaz', item: 'https://atharvapatil.tech/kanvaz/' },
  ],
};
---
<BaseLayout scene={project.scene} title="Kanvaz — Visual Reference Workspace · Atharva Patil" description="Free, open-source visual reference workspace for VFX and 3D artists: live 3D model preview, typed connections, Map View, Scratch Board, plugins. Windows, macOS, Linux. MIT, v9.6.0." keywords="Kanvaz, Kanvaz p4inz, Kanvaz painz, p4inz app dev, reference board app, VFX reference tool" extraJsonLd={[softwareJsonLd, breadcrumbJsonLd]}>
  <CaseHero project={project} />

  <!-- Screenshots first — visual hook before the wall of text. All pulled
       directly from the real v9.6.0 repo (2026-09-28), replacing a set that
       had drifted as far back as v4.2.1 on one dialog. -->
  <Section eyebrow="What Kanvaz looks like">
    <div class="shot-grid">
      <!-- Card-creation walkthrough GIF — the README's own opening shot -->
      <Screenshot
        src="/assets/kanvaz/kanvaz-card-creation.gif"
        alt="Kanvaz walkthrough: home screen, starting a new board, and dropping in a card, live."
        caption="Home screen to first card · v9.6.0"
        aspect="16 / 10"
        span="full"
      />

      <!-- README showcase pair: the same board in both themes. -->
      <Screenshot
        src="/assets/kanvaz/kanvaz-showcase-dark.webp"
        alt="Kanvaz reference board in the dark theme: image, note, color and URL cards with a Related To connection."
        caption="Dark theme · v9.6.0"
        aspect="16 / 10"
        span="half"
      />
      <Screenshot
        src="/assets/kanvaz/kanvaz-showcase-light.webp"
        alt="The same Kanvaz reference board in the light theme."
        caption="Light theme · press L to switch"
        aspect="16 / 10"
        span="half"
      />

      <!-- Map View + Scratch Board: the two headline v9.x features -->
      <Screenshot
        src="/assets/kanvaz/kanvaz-mapview.webp"
        alt="Kanvaz Map View — node-editor-style graph of cards, color-coded by type, with connection ports."
        caption="Map View · every card as a node"
        aspect="16 / 10"
        span="half"
      />
      <Screenshot
        src="/assets/kanvaz/kanvaz-scratchboard.webp"
        alt="Kanvaz Scratch Board — an Illustrator-style drawing layer over the board, pen tool, custom toolbar."
        caption="Scratch Board · draws over the whole board"
        aspect="16 / 10"
        span="half"
      />

      <!-- Task Tracker + Annotate: side-panel features -->
      <Screenshot
        src="/assets/kanvaz/kanvaz-tasktracker.webp"
        alt="Kanvaz Task Tracker side panel section — tasks with subtasks, progress, and a completion toast."
        caption="Task Tracker · a to-do list next to your board"
        aspect="16 / 10"
        span="half"
      />
      <Screenshot
        src="/assets/kanvaz/kanvaz-annotate.webp"
        alt="Kanvaz side panel Properties section with the Annotate toolbar open on an image card."
        caption="Annotate · per-card brush right from Properties"
        aspect="16 / 10"
        span="half"
      />

      <!-- Home screen + Export dialog -->
      <Screenshot
        src="/assets/kanvaz/kanvaz-home.webp"
        alt="Kanvaz Home Screen — first-launch welcome overlay with Drop any file, Right-click, and shortcuts pointers."
        caption="First-launch home screen"
        aspect="16 / 10"
        span="half"
      />
      <Screenshot
        src="/assets/kanvaz/kanvaz-export.webp"
        alt="Kanvaz Export as… dialog — format (PNG/JPEG/WEBP/BMP), quality, and size."
        caption="Export as… · PNG, JPEG, WEBP, or BMP"
        aspect="16 / 10"
        span="half"
      />
    </div>
  </Section>

  <Section eyebrow="Why it exists">
    <div class="body-copy">
      <p>Before Kanvaz was a public release, it was a gift, built for the VFX and 3D community I'm part of, for the friends and teachers who needed a fast, no-friction place to drop reference images while working. Most reference tools are either too heavyweight or built for a different workflow entirely.</p>
      <p>Kanvaz does one thing: give you a canvas, let you throw images, GIFs, and video references onto it, and stay out of your way.</p>
    </div>
  </Section>

  <Section eyebrow="What's inside" heading="3D preview, connections, plugins, and a lot of releases.">
    <div class="feature-grid">
      <article class="feature-card">
        <h3 class="feature-name">Map View + Scratch Board (v9.1–9.5)</h3>
        <p class="feature-desc">Map View turns every card into a node-editor-style graph, color-coded by type and wired with the same typed connections as the board itself. Scratch Board adds a real Illustrator-style drawing layer over the whole board — pen, highlighter, shapes, eraser — sharing one undo history with everything else.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">Task Tracker + per-card Annotate (v9.1–9.6)</h3>
        <p class="feature-desc">A real to-do list lives in the side panel now, with subtasks and per-task card links. Annotation moved into Properties too: brush width and color adjustable per card, no separate tool to switch into.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">Live 3D model cards (v7.4–v8.4)</h3>
        <p class="feature-desc">Drop a <code>.glb</code>, <code>.obj</code>, <code>.fbx</code>, <code>.stl</code>, <code>.ply</code>, <code>.vox</code> or <code>.usd</code> or <code>.usdz</code> and orbit it on the board with Normal, Wireframe and Matcap shading, animation playback and a remembered camera. <code>.blend</code> files preview too if Blender is installed.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">Shared cards + Layers panel (v6.4, v7.20+)</h3>
        <p class="feature-desc">The same card can sit on several boards with no duplication, so an edit shows up everywhere it is used. A Layers panel lists every card in z-order with hide, lock, highlight and grouping.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">Smart Search + Smart Folders (v6.2–6.3)</h3>
        <p class="feature-desc">On-device fuzzy search that finds &quot;car&quot; when you type &quot;cars&quot;, plus saved searches that re-run themselves as new references land. Pure JS, off by default, no native dependencies.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">14 templates + profiles (v7.8–v8.9)</h3>
        <p class="feature-desc">Board templates for VFX, game dev, filmmaking, architecture and more, most of them shipping with real typed connections already wired. Offline multi-profile support, exportable as a portable file.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">Plugin system (v4.2)</h3>
        <p class="feature-desc"><code>window.KanvazPluginAPI</code>: plugins register new card types, ship full alternate themes, add their own Settings panels. Every install goes through a main-process consent dialog; plugins can't self-approve.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">Theme Creator (v4.2)</h3>
        <p class="feature-desc">First official plugin: in-app theme editor, live preview, presets, one-click reset. Shipped with the design-system audit that unified radii, shadows, and animation tokens.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">Safer .kanvaz format (v4.1)</h3>
        <p class="feature-desc">Moved from a giant base64-inline JSON blob to a real zip container with per-asset SHA-256 integrity hashes. Roughly 33% smaller files; one damaged asset degrades gracefully instead of losing the whole board. Backward compatible.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">URL + File cards (v4.1)</h3>
        <p class="feature-desc">Two new reference card types on top of the original six. File cards block executable/script types on open for safety. No new dependencies, no telemetry.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">MCP Bridge (v4.4–4.5)</h3>
        <p class="feature-desc">A local-only MCP server exposes the active board to an AI agent through 30 tools: board management, undo/redo, view control, card editing, and settings. Off by default; every AI-driven change lands in undo history exactly like a manual edit.</p>
      </article>
      <article class="feature-card">
        <h3 class="feature-name">Template gallery + text cards (v5.0–5.2)</h3>
        <p class="feature-desc">Start a board from a template instead of a blank canvas. Text cards join the reference-card lineup, and .pur (PureRef) import handles a wider range of real PureRef files after a fix to a legacy migration bug that was silently corrupting annotation data with Map View open.</p>
      </article>
    </div>
  </Section>

  <Section heading="Kanvaz is at v9.6.0, and still shipping.">
    <div class="body-copy">
      <p>Kanvaz went through a v5.3.0 bug-bounty pass that I once treated as the end of development. It wasn't. Since then there have been 46 published releases across the v6, v7, v8 and v9 lines: Smart Search, shared cards, real 3D model preview, Map View, Scratch Board, a Task Tracker, and a lot of templates.</p>
      <p>The latest published release is v9.6.0, with Windows, macOS (arm64) and Linux builds. There's no fixed roadmap; updates land most weeks depending on what people report. The main branch is already ahead of the last release.</p>
      <p>No subscription, no feature paywall, no telemetry. The only network calls are buttons you click yourself, like Check for Updates. Your files stay on your machine, and it stays free.</p>
    </div>
  </Section>

  <RelatedProjects currentSlug="kanvaz" slugs={['nexus', 'mission-os', 'pursue-os', 'ascent']} />

  <style>
    /* 12-col grid so <Screenshot span="..."> lands where expected */
    .shot-grid {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: var(--sp-5);
    }
    .body-copy {
      max-width: var(--wrap-narrow);
      color: var(--muted);
      font-size: var(--text-md);
      line-height: var(--leading-body);
    }
    .body-copy p + p { margin-top: var(--sp-4); }
    .body-copy strong { color: var(--text); font-weight: 500; }
    .body-copy em { color: var(--purple-bright); font-style: italic; }
    .body-copy code {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--purple-bright);
      background: color-mix(in oklab, var(--purple) 10%, transparent);
      padding: 1px 5px;
      border-radius: 4px;
    }
    .feature-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-4);
    }
    @media (max-width: 760px) { .feature-grid { grid-template-columns: 1fr; } }
    .feature-card {
      padding: var(--sp-6);
      border: 1px solid var(--line);
      border-radius: var(--radius-lg);
      background: var(--surface-1);
    }
    .feature-name {
      font-family: var(--font-display);
      font-size: var(--text-md);
      font-weight: 500;
      margin-bottom: var(--sp-3);
    }
    .feature-desc {
      color: var(--muted);
      font-size: var(--text-sm);
      line-height: var(--leading-body);
    }
    .feature-desc code {
      font-family: var(--font-mono);
      font-size: 12px;
      color: var(--purple-bright);
      background: color-mix(in oklab, var(--purple) 10%, transparent);
      padding: 1px 5px;
      border-radius: 4px;
    }
  </style>
</BaseLayout>
