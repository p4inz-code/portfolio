---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
---
<BaseLayout title="3D / VFX — Atharva Patil">
  <Section
    wide
    heading="of the same person building the software."
    headingEmphasis="The visual craft"
    intro="I'm a second-year VFX & 3D animation student at D. Y. Patil University — the software half of what I do is public; the visual half is midway through being caught up. This page is being rebuilt around 2026 work: full turntables, lighting breakdowns, and short process videos landing as they finish editing."
  >
    <div class="tdd-meta">
      <div class="tdd-meta-item">
        <span class="tdd-key">Program</span>
        <span class="tdd-val">B.Sc. Animation · D. Y. Patil University · 2025–2028</span>
      </div>
      <div class="tdd-meta-item">
        <span class="tdd-key">Stack</span>
        <span class="tdd-val">Blender · Substance · DaVinci Resolve · Kanvaz for reference</span>
      </div>
      <div class="tdd-meta-item">
        <span class="tdd-key">Focus</span>
        <span class="tdd-val">Lighting studies · product renders · short-form motion</span>
      </div>
      <div class="tdd-meta-item">
        <span class="tdd-key">Availability</span>
        <span class="tdd-val">Freelance 3D / VFX work on shot-by-shot basis</span>
      </div>
    </div>
  </Section>

  <Section eyebrow="What's landing here soon">
    <ul class="tdd-queue" role="list">
      <li>
        <span class="q-index">R1</span>
        <div>
          <p class="q-title">Product renders — Nexus + Mission OS marketing frames</p>
          <p class="q-note">Cycles / lit studio setups. Landing with the v11 Nexus release.</p>
        </div>
      </li>
      <li>
        <span class="q-index">R2</span>
        <div>
          <p class="q-title">Lighting study series — cathedral / cinematic / product</p>
          <p class="q-note">Three-scene series with same asset re-lit under each brief.</p>
        </div>
      </li>
      <li>
        <span class="q-index">R3</span>
        <div>
          <p class="q-title">Short-form motion — 6-second brand-mark reveal</p>
          <p class="q-note">Motion identity work for Northbyte Studios.</p>
        </div>
      </li>
      <li>
        <span class="q-index">R4</span>
        <div>
          <p class="q-title">Turntables — 3-4 asset showcases with breakdown captions</p>
          <p class="q-note">Modelling + shading breakdown per asset, not just glamour frames.</p>
        </div>
      </li>
    </ul>

    <p class="tdd-cta">
      Meanwhile, the code side is on <a href="/work/">Selected Work</a>. If you have a specific 3D shot in mind, <a href="/contact/">get in touch</a> — shot-scoped work is happening even without a published gallery.
    </p>
  </Section>

  <style>
    .tdd-meta {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: 4px;
      overflow: hidden;
      margin-top: var(--sp-6);
    }
    @media (max-width: 760px) { .tdd-meta { grid-template-columns: 1fr; } }
    .tdd-meta-item {
      background: var(--surface-1);
      padding: var(--sp-5);
      display: flex; flex-direction: column; gap: 4px;
    }
    .tdd-key {
      font-family: var(--font-mono);
      font-size: 10px;
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--muted);
    }
    .tdd-val { color: var(--text); font-size: var(--text-sm); }

    .tdd-queue {
      list-style: none;
      padding: 0;
      display: flex; flex-direction: column;
      border-top: 1px solid var(--line);
    }
    .tdd-queue li {
      display: grid;
      grid-template-columns: 60px 1fr;
      gap: var(--sp-5);
      padding: var(--sp-5) 0;
      border-bottom: 1px solid var(--line);
      align-items: baseline;
    }
    .q-index {
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: var(--tracking-eyebrow);
      color: var(--purple-bright);
      padding: 3px 8px;
      border: 1px solid var(--line-strong);
      border-radius: 2px;
      justify-self: start;
    }
    .q-title { color: var(--text); font-size: var(--text-md); font-family: var(--font-display); font-weight: 500; margin-bottom: 4px; }
    .q-note { color: var(--muted); font-size: var(--text-sm); line-height: var(--leading-body); }

    .tdd-cta {
      color: var(--muted);
      font-size: var(--text-md);
      line-height: var(--leading-body);
      margin-top: var(--sp-6);
      max-width: var(--wrap-narrow);
    }
    .tdd-cta a { color: var(--purple-bright); border-bottom: 1px solid currentColor; }
  </style>
</BaseLayout>
