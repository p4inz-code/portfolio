---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/layout/Section.astro';
import { SITE, CONTACT } from '../data/site';
import { PROJECTS } from '../data/projects';

/**
 * About page — v5.6.5 rewrite. Structured as identity → journey →
 * principles → stack → studio history → availability → contact.
 * Every claim on this page is either verifiable in projects.ts /
 * repo READMEs, or drawn from Atharva's own words in prior sessions.
 * No invented facts. Anywhere the truth needs a real anecdote to
 * land, the copy names that gap honestly so it can be filled in.
 */

const stackReasons = [
  {
    slug: 'wpf',
    label: 'C# / .NET 8 / WPF',
    verdict: 'For Windows-native products',
    reason: 'WPF is the least-glamorous choice a modern .NET dev can make — and the right one for Nexus. Native windowing, real ClearType, no Electron bloat, integrates with Windows Hello and the Credential Manager the way users expect. Chose WPF over Avalonia specifically because Nexus ships Windows-only for now and I wanted to lean into the platform, not abstract it.',
  },
  {
    slug: 'avalonia',
    label: 'C# / .NET 8 / Avalonia',
    verdict: 'For cross-platform desktop tooling',
    reason: 'When cross-platform matters (Glint, future Nexus port), Avalonia gets the exact same code running on Windows / macOS / Linux without hitting Electron. WPF muscle memory transfers over cleanly.',
  },
  {
    slug: 'electron',
    label: 'Electron + vanilla JS',
    verdict: 'For Kanvaz',
    reason: 'Kanvaz needed to run everywhere a VFX artist works, and its whole surface is a canvas full of references — HTML5 canvas + drag-and-drop APIs mapped to that better than any native alternative. Vanilla JS on purpose: no framework churn, easy for anyone to fork and extend.',
  },
  {
    slug: 'linux-native',
    label: 'Debian Stable + KDE Plasma + Qt/QML',
    verdict: 'For Mission OS',
    reason: 'Building an OS you want to trust means starting from something already trusted (Debian Stable) and building deliberately on top of the most polished free desktop environment (KDE Plasma). Installer + system apps in QML/Qt because they compile to native, look right at any DPI, and let the four-pillar ethos show up in the UI itself.',
  },
  {
    slug: 'astro',
    label: 'Astro 5 (this site)',
    verdict: 'For static content sites',
    reason: 'This portfolio was a single 15.9MB HTML file through v4.7. It worked, but every edit meant scrolling through one enormous document. Astro gives me component-scoped CSS, real routes, and zero JS by default, and it deploys to Cloudflare Pages without any extra config.',
  },
  {
    slug: 'ts',
    label: 'TypeScript · Node · SQLite',
    verdict: 'For engineering-side tooling',
    reason: 'Veris (3,100+ tests) and repo-map both live here. TS strict-mode, ESM-first, SQLite for anything that needs to be inspectable without a running server. Deterministic engines, not black boxes.',
  },
];

const principles = [
  {
    title: 'No telemetry, ever',
    body: 'Nothing I ship phones home. Not "off by default," not compiled in at all. If a product wants to know something about you, it asks on-screen, and you can say no.',
  },
  {
    title: 'Explain what you\'re turning on',
    body: 'Secure Boot, TPM-sealed unlock, disk encryption, telemetry: every advanced option gets its benefit and its downside written right next to the toggle, not buried in docs. You should know what you\'re agreeing to before you agree to it.',
  },
  {
    title: 'Say what\'s actually true',
    body: 'Before I ship an update to this site, I check the claim against the real README or release notes. If something\'s only a concept preview, it says so. I\'ve delayed a ship before because a status label on /status was already out of date.',
  },
  {
    title: 'I build all of it myself',
    body: 'The products, the case studies, this site\'s design system, the Mission OS demo, the résumé. One person, start to finish. Not a boast, just how the timeline works out.',
  },
  {
    title: 'Free when I can make it free',
    body: 'Kanvaz, Obscura, Glint, repo-map, 3D Ref Skills, Mission OS, and Pursue OS are all free, most of them open-source. Nexus and Veris are paid because running a one-person studio costs money, but they don\'t get a telemetry exception either.',
  },
];

const timeline = [
  { year: '2025', event: 'First studio (Obsidian Labs). Early Windows tooling. B.Sc. Animation program begins at D. Y. Patil University.' },
  { year: 'Early 2026', event: 'Kanvaz released open source (MIT) as a reference workspace for the VFX community I\'m part of.' },
  { year: 'Mar 2026', event: 'Started building Nexus. It went public around a month later, once there was enough to actually show.' },
  { year: 'Jun 2026', event: 'Kanvaz and Veris both in active development alongside Nexus — one open-source workspace, one investigation platform.' },
  { year: 'Mid 2026', event: 'Northbyte Studios founded as the second (and current) studio name. Mission OS work begins.' },
  { year: 'Aug 2026', event: 'Second year of the animation program. Portfolio migrated to Astro (v5.0). Pursue OS repository foundation goes public. Mission OS ISO enters internal testing.' },
];

// Real, verifiable numbers only — for anyone deciding whether to work with
// a one-person studio.
const traction = [
  { k: 'Products shipped or in flight', v: `${PROJECTS.length}` },
  { k: 'Open source (MIT / GPLv3 / Apache 2.0)', v: `${PROJECTS.filter((p) => p.license && p.license !== 'Proprietary').length}` },
  { k: 'Automated tests across products', v: '4,100+ (Veris 3,100 + repo-map 870 + others)' },
  { k: 'People between design and shipping', v: 'Just me' },
  { k: 'Third-party analytics on any product', v: '0' },
  { k: 'External dependencies (this site)', v: '0 — no tracking, no fetch calls at runtime' },
];

const shippedCount = PROJECTS.length;
const activeCount = PROJECTS.filter(
  (p) => !['onHold'].includes(p.status.kind)
).length;
---
<BaseLayout title="About — Atharva Patil">

  <!-- HERO — v5.16.0: portrait photo added, split with lede text.
       v5.17.3: rewritten off the "Developer by discipline / 3D artist by
       training / Builder by default" triplet — flagged as sounding
       generated. Plainer version below. -->
  <Section wide headingLevel="h1" heading="Software engineer, and about two years into a 3D animation degree." headingEmphasis="Atharva Patil.">
    <div class="about-hero">
      <div class="about-portrait">
        <img
          src="/assets/about/atharva-portrait.png"
          alt="Atharva Patil — head-and-shoulders portrait, navy shirt, warm indoor setting with a wooden shelf and plant in the background."
          width="1000" height="1000"
          loading="eager" decoding="async"
        />
      </div>
      <div class="about-hero-text">
        <p class="about-lede">
          I run <em>{SITE.studio}</em> on my own, based in {SITE.location}. I used to go by
          <em>PainZ</em> and <em>Grim</em> — both retired, everything ships under <strong>p4inz</strong>
          or my real name now. {shippedCount} products shipped or in progress, {activeCount} of them
          actively worked on, and no marketing team behind any of it — just me.
        </p>
        <p class="about-lede-secondary">
          For a while I thought I'd eventually have to pick one: software or 3D. I've stopped
          expecting that to happen. A UI that feels right and a render that feels right come from the
          same place — paying attention to the small stuff most people don't notice until it's wrong.
        </p>
      </div>
    </div>
  </Section>

  <!-- SHORT STORY -->
  <Section eyebrow="The short version" heading="Why software and 3D, and why probably not stopping.">
    <div class="story-block">
      <p>
        Software came first, and it started the usual way — taking apart things I owned until I
        understood them, then trying to fix or replace what annoyed me. Windows tools first, then
        small utilities, then products with actual users. That grew into a studio in 2025
        ({SITE.studio.replace('Northbyte Studios', 'Obsidian Labs')}, at the time), and I renamed it
        <em>{SITE.studio}</em> in 2026 once it felt like something worth naming properly.
      </p>
      <p>
        3D came in because software alone wasn't covering everything I wanted to make. I started a
        B.Sc. Animation program at D. Y. Patil University this year, which mostly just gave a name to
        something I was already doing on the side. <em>Kanvaz</em> exists because of that overlap —
        it's a reference tool I built for VFX artists because I'm one of them, not something I built
        to look interesting from the outside.
      </p>
      <p>
        Almost everything I build ends up privacy-first and offline-first, usually without me
        planning it that way going in. Nexus doesn't sync to a cloud. Mission OS doesn't phone home.
        Pursue OS is for investigators who can't afford to leak metadata about who they're
        researching. Even this site runs on Cloudflare with nothing beyond Cloudflare's own
        privacy-preserving traffic beacon — no analytics script, no tracking pixel.
      </p>
      <p>
        The part that's less fun to admit: I do all of this alone, so there's no one to catch what I
        miss and no one to help me move faster either. Some things take longer because of that.
        Other things stay more consistent than they would with five people making five different
        calls on the same product — most days I think that trade is worth it.
      </p>
    </div>
  </Section>

  <!-- TIMELINE -->
  <Section eyebrow="Timeline" heading="The last two years, compressed.">
    <ol class="tl-list" role="list">
      {timeline.map((t) => (
        <li class="tl-row">
          <span class="tl-year">{t.year}</span>
          <span class="tl-event">{t.event}</span>
        </li>
      ))}
    </ol>
  </Section>

  <!-- PRINCIPLES -->
  <Section eyebrow="What I actually believe" heading="Things you can go check, not a values statement." intro="Every line here holds up if you actually read the installer copy, the ship notes, or the source for any product on this site.">
    <div class="pr-grid">
      {principles.map((p) => (
        <article class="pr-card">
          <h3 class="pr-title">{p.title}</h3>
          <p class="pr-body">{p.body}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- INVESTOR / COLLABORATOR READ -->
  <Section eyebrow="For investors + collaborators" heading="What this studio actually looks like from the outside." intro="Every number below is checkable — against the repos, or against the changelog on /status.">
    <dl class="tr-grid">
      {traction.map((t) => (
        <div class="tr-cell">
          <dt>{t.k}</dt>
          <dd>{t.v}</dd>
        </div>
      ))}
    </dl>
    <div class="tr-thesis">
      <p>My bet is that a small number of privacy-first products, each finished properly, beats a bigger catalogue of half-finished ones — most "growth" advice assumes ads and telemetry are free to add, and I'd rather not build on that assumption.</p>
      <p>Nexus is the main commercial product, an encrypted vault for Windows. Mission OS is the bigger, slower bet: a privacy-first Linux distro built at OS scale. Kanvaz and Obscura are free and open-source on purpose, proof the studio actually ships rather than just talking about shipping. Everything else supports one of those three.</p>
      <p>I'm not looking for growth marketing, an agency handoff, or a full team right now. What's actually useful: introductions to other founders, investors, or open-source maintainers who care more about the product being right than the product growing fast.</p>
    </div>
  </Section>

  <!-- STACK -->
  <Section eyebrow="Current stack" heading="What I reach for, and why." intro="I don't have one favourite language. I have projects that each demanded the right one and I picked deliberately.">
    <div class="stack-list">
      {stackReasons.map((s) => (
        <article class="stack-row">
          <header class="stack-head">
            <h3 class="stack-label">{s.label}</h3>
            <p class="stack-verdict">{s.verdict}</p>
          </header>
          <p class="stack-reason">{s.reason}</p>
        </article>
      ))}
    </div>
  </Section>

  <!-- IDENTITY / HANDLES -->
  <Section eyebrow="Identity" heading="One person, several names, one canonical source.">
    <div class="id-grid">
      <div class="id-row"><span class="id-key">Real name</span><span class="id-val">Atharva Patil</span></div>
      <div class="id-row"><span class="id-key">Current handle</span><span class="id-val">p4inz — everywhere (GitHub, Discord, this site's byline)</span></div>
      <div class="id-row"><span class="id-key">Retired handles</span><span class="id-val">PainZ, Grim — do not use, they don't map to me anymore</span></div>
      <div class="id-row"><span class="id-key">Current studio</span><span class="id-val">{SITE.studio} · founded {SITE.studioFounded}</span></div>
      <div class="id-row"><span class="id-key">Previous studio</span><span class="id-val">Obsidian Labs — 2025, retired when the current studio was named</span></div>
      <div class="id-row"><span class="id-key">Location</span><span class="id-val">{SITE.location}</span></div>
      <div class="id-row"><span class="id-key">Canonical source</span><span class="id-val">This site — <a href="https://atharvapatil.tech">atharvapatil.tech</a></span></div>
    </div>
  </Section>

  <!-- AVAILABILITY -->
  <Section eyebrow="Working with me" heading="Freelance capacity: selective, taking new work.">
    <div class="avail-block">
      <p class="avail-lede">
        I take on independent client work in web development, UI/UX, branding, and 3D/VFX
        visualization. Scope tends to be one of three shapes:
      </p>
      <ul class="avail-list" role="list">
        <li><strong>Short-loop.</strong> A landing page, a marketing site, a brand touch-up. 1–2 weeks. Fixed price. Direct.</li>
        <li><strong>Product build.</strong> A dashboard, a real product surface, a tool that needs UI + backend + design. 4–8 weeks. Discovery week first.</li>
        <li><strong>Studio work.</strong> A 3D render, a lighting study, a promo animation. Scope by shot.</li>
      </ul>
      <p class="avail-foot">
        Everything I ship uses the same discipline you see across my own products: privacy-first,
        no telemetry, honest about what a first-shipping-version can and can't do. If that fits
        what you're trying to build, <a href="/contact/">start a conversation</a>.
      </p>
    </div>
  </Section>

  <!-- CONTACT -->
  <Section eyebrow="Contact" heading="Reach me directly.">
    <div class="contact-links">
      <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <a href={CONTACT.github} target="_blank" rel="noopener noreferrer">{CONTACT.githubHandle}</a>
      <span>Discord · {CONTACT.discord}</span>
      <a href="/contact/">Full contact page →</a>
    </div>
  </Section>

  <style>
    /* ============ Hero with portrait ============ */
    .about-hero {
      display: grid;
      grid-template-columns: 320px 1fr;
      gap: var(--sp-8);
      align-items: start;
      margin-top: var(--sp-5);
    }
    @media (max-width: 900px) {
      .about-hero { grid-template-columns: 1fr; gap: var(--sp-6); }
      .about-portrait { max-width: 260px; }
    }
    .about-portrait {
      border-radius: var(--radius-lg);
      overflow: hidden;
      border: 1px solid var(--line);
      background: var(--surface-1);
      aspect-ratio: 1 / 1;
    }
    .about-portrait img {
      width: 100%; height: 100%;
      object-fit: cover;
      display: block;
    }

    /* ============ Hero lede ============ */
    .about-lede {
      max-width: 780px;
      color: var(--text);
      font-size: var(--text-lg);
      line-height: var(--leading-body);
      margin-top: var(--sp-4);
    }
    .about-lede em {
      color: var(--purple-bright);
      font-style: italic;
      font-weight: 500;
    }
    .about-lede strong { color: var(--text); font-weight: 600; }
    .about-lede-secondary {
      max-width: 780px;
      color: var(--muted);
      font-size: var(--text-md);
      line-height: var(--leading-body);
      margin-top: var(--sp-5);
    }
    .about-lede-secondary em {
      color: var(--purple-bright);
      font-style: italic;
      font-weight: 500;
    }

    /* ============ Story ============ */
    .story-block {
      max-width: var(--wrap-narrow);
      color: var(--muted);
      font-size: var(--text-md);
      line-height: var(--leading-body);
    }
    .story-block p + p { margin-top: var(--sp-5); }
    .story-block em { color: var(--purple-bright); font-style: italic; }
    .story-block strong { color: var(--text); font-weight: 500; }

    /* ============ Timeline ============ */
    .tl-list {
      list-style: none;
      padding: 0;
      max-width: var(--wrap-narrow);
      border-top: 1px solid var(--line);
    }
    .tl-row {
      display: grid;
      grid-template-columns: 140px 1fr;
      gap: var(--sp-6);
      padding: var(--sp-5) 0;
      align-items: baseline;
      border-bottom: 1px solid var(--line);
    }
    .tl-year {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--purple-bright);
    }
    .tl-event {
      color: var(--text);
      font-size: var(--text-md);
      line-height: 1.55;
    }
    @media (max-width: 640px) {
      .tl-row { grid-template-columns: 1fr; gap: 6px; }
    }

    /* ============ Principles ============ */
    .pr-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--sp-4);
    }
    @media (max-width: 760px) { .pr-grid { grid-template-columns: 1fr; } }
    .pr-card {
      padding: var(--sp-6);
      border-top: 1px solid var(--purple-bright);
      background: transparent;
      position: relative;
    }
    .pr-title {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      font-weight: 500;
      color: var(--text);
      margin-bottom: var(--sp-3);
      letter-spacing: -0.01em;
    }
    .pr-body {
      color: var(--muted);
      font-size: var(--text-sm);
      line-height: var(--leading-body);
    }

    /* ============ Traction (investor-ready) ============ */
    .tr-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;
      background: var(--line);
      border: 1px solid var(--line);
      border-radius: 4px;
      overflow: hidden;
    }
    @media (max-width: 640px) { .tr-grid { grid-template-columns: 1fr; } }
    .tr-cell {
      background: var(--surface-1);
      padding: var(--sp-5);
      display: flex; flex-direction: column-reverse; gap: 6px;
    }
    .tr-cell dt {
      font-family: var(--font-mono);
      font-size: 10.5px;
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--muted);
    }
    .tr-cell dd {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      color: var(--text);
      font-weight: 500;
      letter-spacing: -0.01em;
    }
    .tr-thesis {
      margin-top: var(--sp-6);
      max-width: var(--wrap-narrow);
      color: var(--muted);
      font-size: var(--text-md);
      line-height: var(--leading-body);
    }
    .tr-thesis p + p { margin-top: var(--sp-4); }
    .tr-thesis strong {
      color: var(--purple-bright);
      font-weight: 500;
    }

    /* ============ Stack ============ */
    .stack-list {
      display: flex; flex-direction: column;
      border-top: 1px solid var(--line);
    }
    .stack-row {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: var(--sp-6);
      padding: var(--sp-6) 0;
      border-bottom: 1px solid var(--line);
      align-items: start;
    }
    @media (max-width: 760px) { .stack-row { grid-template-columns: 1fr; gap: var(--sp-3); } }
    .stack-head { display: flex; flex-direction: column; gap: 4px; }
    .stack-label {
      font-family: var(--font-display);
      font-size: var(--text-md);
      font-weight: 500;
      color: var(--text);
    }
    .stack-verdict {
      font-family: var(--font-mono);
      font-size: 10.5px;
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--purple-bright);
    }
    .stack-reason {
      color: var(--muted);
      font-size: var(--text-sm);
      line-height: var(--leading-body);
    }

    /* ============ Identity ============ */
    .id-grid {
      display: flex; flex-direction: column;
      border-top: 1px solid var(--line);
      max-width: var(--wrap-narrow);
    }
    .id-row {
      display: grid;
      grid-template-columns: 200px 1fr;
      gap: var(--sp-5);
      padding: var(--sp-4) 0;
      border-bottom: 1px solid var(--line);
      align-items: baseline;
    }
    @media (max-width: 640px) { .id-row { grid-template-columns: 1fr; gap: 4px; } }
    .id-key {
      font-family: var(--font-mono);
      font-size: var(--text-xxs);
      letter-spacing: var(--tracking-eyebrow);
      text-transform: uppercase;
      color: var(--muted);
    }
    .id-val { color: var(--text); font-size: var(--text-sm); }
    .id-val a { color: var(--purple-bright); border-bottom: 1px solid currentColor; }

    /* ============ Availability ============ */
    .avail-block {
      max-width: var(--wrap-narrow);
      color: var(--muted);
      font-size: var(--text-md);
      line-height: var(--leading-body);
    }
    .avail-lede { color: var(--text); }
    .avail-list {
      margin: var(--sp-5) 0;
      padding: 0;
      list-style: none;
      display: flex; flex-direction: column;
      gap: var(--sp-3);
    }
    .avail-list li {
      padding: var(--sp-4);
      background: color-mix(in oklab, var(--surface-1) 60%, transparent);
      border-left: 3px solid var(--purple-bright);
      color: var(--text);
      font-size: var(--text-sm);
      line-height: var(--leading-body);
    }
    .avail-list strong { color: var(--purple-bright); }
    .avail-foot {
      margin-top: var(--sp-5);
      color: var(--muted);
    }
    .avail-foot a { color: var(--purple-bright); border-bottom: 1px solid currentColor; }

    /* ============ Contact anchor ============ */
    .contact-links {
      display: flex; flex-wrap: wrap; gap: var(--sp-4) var(--sp-7);
      font-size: var(--text-md);
      color: var(--text);
    }
    .contact-links a {
      color: var(--text);
      border-bottom: 1px solid var(--line);
      transition: border-color var(--dur) var(--ease-out), color var(--dur) var(--ease-out);
    }
    .contact-links a:hover { color: var(--purple-bright); border-bottom-color: var(--purple-bright); }
  </style>
</BaseLayout>
