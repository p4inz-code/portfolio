# Cloudflare Pages reads this file at the root of the published site
# (portfolio-v5/dist/_headers after Astro build) and applies these headers
# to every response. No dashboard configuration needed.
#
# ── CSP notes for the v5 Astro build ────────────────────────────────
#   - script-src needs 'unsafe-inline' because BaseLayout ships a short
#     inline <script is:inline> block that reads localStorage['nb-theme']
#     and sets [data-theme] before first paint to avoid a theme flash.
#     Astro also inlines a small hydration script per-page. No eval(),
#     no new Function(), no document.write() anywhere in runtime code.
#     static.cloudflareinsights.com is allowed because Cloudflare Pages
#     auto-injects the Web Analytics beacon; without it in script-src
#     the beacon triggers a CSP console error.
#   - style-src needs 'unsafe-inline' — Astro scoped styles are compiled
#     to per-component <style> blocks in the HTML head. Also allows
#     Fontshare (api.fontshare.com) and Google Fonts (fonts.googleapis.com)
#     stylesheets used for PP Editorial New + JetBrains Mono.
#   - font-src allows fonts.gstatic.com (Google Fonts binary files) and
#     cdn.fontshare.com (Fontshare binary files).
#   - img-src allows data: for the inline SVG favicon and any inline
#     data-uri images.
#   - connect-src is 'self' + cloudflareinsights.com for the beacon, plus
#     challenges.cloudflare.com for the Turnstile widget's own network
#     calls (separate from our own fetch('/api/contact'), which is 'self').
#   - script-src / frame-src / connect-src all allow challenges.cloudflare.com
#     — Cloudflare's own documented requirement for embedding Turnstile:
#     the api.js script, its challenge iframe, and its internal requests
#     each need their own allowlist entry or the widget silently never
#     renders and no token is ever produced (v5.42.0 shipped without this,
#     which is why the contact backend never actually fired until v5.43.0).
#   - form-action stays 'none' — the form is submitted via fetch() from JS
#     (preventDefault(), never a native <form action> submission), so this
#     doesn't block the real POST to /api/contact; it only blocks the kind
#     of submission this site was never going to do anyway.
#   - frame-ancestors 'self' — clickjacking protection; the site itself
#     can still frame its own routes.
#   - object-src 'none' + base-uri 'none' — modern hardening defaults.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://api.fontshare.com; font-src 'self' https://cdn.fontshare.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'self'; base-uri 'none'; form-action 'none'; object-src 'none'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-site

# XML sitemap should serve as XML, not the default text/html fallback.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8

# .well-known files serve as plaintext for RFC 9116 tooling.
/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8
